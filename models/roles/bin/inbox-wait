#!/bin/sh
# inbox-wait [-t SECS] [-a ALIVE] [-s STATE] FILE...
# inbox-wait -f [-1] -s STATE [-i PATTERN]... [-t SECS] [-a ALIVE] FILE...
# -- written by `asb --init roles`
# (docs/roles.md, section 5). Exit 0 at the first change of any FILE -- its modification
# time, inode or size: a rename over it, as the Write tool does, counts -- printing that
# FILE's path, and 1 after SECS seconds without a change (0 or none: wait for ever).
# ALIVE, a path, is touched at every poll, so its age says whether a watcher is
# waiting: it goes stale while the role works a turn (#464). A one-second poll by path:
# there is no inotifywait here.
#
# STATE carries the baseline from one run to the next (#339). Without it, the baseline
# is each FILE as this run finds it, so a change made between one run's exit and the
# next run's start is never reported. With it, a FILE that STATE has an entry for is
# compared with the state saved there, so such a change is reported at once by the first
# poll; a FILE with no entry (a missing or empty STATE: every FILE) starts from now.
# STATE is written anew, by a rename from a temporary file beside it, first at start,
# from the baseline, before the first poll: a run that cannot write it refuses (exit 2)
# and reports nothing, since nothing it reported could be saved -- so a STATE that
# cannot be written ends each run at its start, never in a loop of runs that each report
# the same change. At exit 0 it is written again: the reported FILE's entry advances to
# the state that poll saw, every other FILE keeps its baseline (two FILEs changed in one
# poll are reported by two runs, the second at once), and entries for paths not among
# the FILEs are kept. A save at exit 0 that fails is said on stderr, and the next run
# refuses at its start while it still fails. At exit 1, or killed, it holds the baseline
# the run started from: the next run may then report a change the role has already read,
# one extra wake at worst, never a missed change. One line per FILE: its state, a tab,
# its path as given (a path may hold spaces and tabs). Refused at start (exit 2): a FILE
# path with a newline, STATE among the FILEs (by any spelling), STATE a directory or
# unreadable, and STATE's directory missing or not writable.
#
# THE STREAM (-f), for a tool that takes a command's lines as events (the Supervisor's
# watch). It does not exit at a change: it polls once a second and prints one line per
# changed FILE per poll, for -t SECS by the clock (0 or none: for ever), then exits 0, a
# planned end. -s is required. A FILE that grew in place (the same inode, a larger size)
# is read from its baseline's size on, and the blank lines and the appended lines that
# match PATTERN (-i, an ERE; several -i are alternatives) are dropped: when every
# appended line is, the change is no event, and its baseline advances silently. An event
# is the path, a colon and the last line kept, cut to about 160 bytes (" ..." marks a
# cut) with its control characters shown as cat -v does (^[ for ESC), so an appended
# line cannot make a second event or move the reader's terminal. Any other change --
# renamed over, shrunk, appeared, gone -- is the path and " changed". STATE is written
# once per poll that saw a change, after its lines are printed: a run killed between the
# two prints those changes again at the next run, a duplicate at worst, never a loss.
# One stream per STATE, held by an flock on STATE.lock: a second -f run on the same
# STATE while one runs prints that a watcher already runs, with its pid, and exits 0 --
# arming again is safe. The lock goes with the process (its children do not hold it), so
# a stream that died never answers so. Refused at start, with the one-shot form's
# refusals: -f without -s, a PATTERN that is not an ERE, and no flock on PATH.
#
# ONE EVENT (-f -1), for a command whose end is the wake (the Supervisor's watch, a
# background command, which has no time limit). The stream, ending after the first poll
# that printed a line: every line of that poll is printed, STATE is saved as above, and
# it exits 0. A poll whose changes were all dropped (-i, blank lines) prints nothing and
# does not end it: its baseline advances, as the stream's does. So a change made while
# no run waited -- between one run's exit and the next one's start -- is printed by the
# next run's first poll, through STATE, and a run killed before its save prints its
# lines again at the next. A save that fails ends the run, after its lines, and the next
# run refuses at its start (above) while it still fails. -t ends it as it ends the
# stream, exit 0 with no event line. The lock is the stream's: a second run on a STATE
# whose run is still waiting prints that a watcher already runs and exits 0 at once --
# an end that is no event, so whoever re-arms at each end does not re-arm on that line.
# -1 without -f is refused.
usage() {
  echo "usage: inbox-wait [-t SECS] [-a ALIVE] [-s STATE] FILE..." >&2
  [ -z "$follow$pat$once" ] || echo "       inbox-wait -f [-1] -s STATE [-i PATTERN]... [-t SECS] [-a ALIVE] FILE..." >&2
  exit 2
}
refuse() {
  printf 'inbox-wait: %s\n' "$1" >&2
  exit 2
}
lim=0
alive=""
sf=""
follow=""
pat=""
once=""
while getopts t:a:s:fi:1 o; do
  case "$o" in
    f) follow=1 ;;
    1) once=1 ;;
    i)
      [ -n "$OPTARG" ] || usage
      printf '' | grep -Eq -- "$OPTARG" 2>/dev/null
      [ $? -le 1 ] || refuse "-i $OPTARG: not an extended regular expression"
      pat="${pat:+$pat|}($OPTARG)"
      ;;
    t) lim="$OPTARG" ;;
    a) alive="$OPTARG" ;;
    s)
      sf="$OPTARG"
      [ -n "$sf" ] || usage
      ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || usage
# -i and -1 are the stream's, and the stream needs STATE.
[ -n "$follow" ] || [ -z "$pat$once" ] || usage
[ -z "$follow" ] || [ -n "$sf" ] || usage
case "$lim" in '' | *[!0-9]*) usage ;; esac
# A FILE of digits alone is the old form's SECS (`FILE SECS [ALIVE]`), which would wait
# for ever on a file named 0: refused.
for f; do case "$f" in '' | *[!0-9]*) ;; *) usage ;; esac done
nl='
'
tab="$(printf '\t')"
st() { stat -c '%y %i %s' "$1" 2>/dev/null; }
# saved PATH -- STATE's entry for PATH: its state in $sv, status 1 when there is none.
saved() {
  [ -f "$sf" ] || return 1
  while IFS= read -r l || [ -n "$l" ]; do
    case "$l" in *"$tab"*) ;; *) continue ;; esac
    [ "${l#*"$tab"}" = "$1" ] || continue
    sv="${l%%"$tab"*}"
    return 0
  done <"$sf"
  return 1
}
# save FILE... -- STATE anew from the baseline $m, the reported FILE ($rep) at $cur, then
# the entries of paths not among the FILEs; renamed over STATE from a temporary file in
# its directory, so a reader never sees half of it.
save() {
  t="$(mktemp "$sf.XXXXXX")" || return 1
  seen="$nl" rest="$m"
  {
    for p; do
      s="${rest%%"$nl"*}"
      rest="${rest#*"$nl"}"
      [ "$p" != "$rep" ] || s="$cur"
      case "$seen" in *"$nl$p$nl"*) continue ;; esac
      seen="$seen$p$nl"
      printf '%s\t%s\n' "$s" "$p"
    done
    if [ -f "$sf" ]; then
      while IFS= read -r l || [ -n "$l" ]; do
        case "$l" in *"$tab"*) ;; *) continue ;; esac
        case "$seen" in *"$nl${l#*"$tab"}$nl"*) continue ;; esac
        seen="$seen${l#*"$tab"}$nl"
        printf '%s\n' "$l"
      done <"$sf"
    fi
  } >"$t" && mv -f "$t" "$sf" && return 0
  rm -f "$t"
  return 1
}
if [ -n "$sf" ]; then
  # Refused at start, rather than missing a change after the next exit 0.
  d="$(dirname "$sf")"
  [ -d "$d" ] && [ -w "$d" ] || refuse "-s $sf: its directory is missing or not writable"
  [ ! -d "$sf" ] || refuse "-s $sf: a directory"
  [ ! -e "$sf" ] || [ -r "$sf" ] || refuse "-s $sf: not readable"
  # STATE among the FILEs by any spelling: by the path, and, once STATE exists, by its
  # device and inode, as the poll's own stat sees them (a first run makes it; the next
  # is refused).
  si="$(stat -c '%d %i' "$sf" 2>/dev/null)"
  for f; do
    case "$f" in *"$nl"*) refuse "-s: a FILE path holds a newline, which STATE cannot record" ;; esac
    if [ "$f" = "$sf" ] || { [ -n "$si" ] && [ "$(stat -c '%d %i' "$f" 2>/dev/null)" = "$si" ]; }; then
      refuse "-s $sf: STATE is also a FILE, so writing it would wake the next run"
    fi
  done
fi
if [ -n "$follow" ]; then
  command -v flock >/dev/null 2>&1 || refuse "-f needs flock (util-linux), which is not on PATH"
  # One stream per STATE. The lock is on STATE.lock's open file, so it is released when
  # this process ends; children run with it closed, so none keeps it after. Opened for
  # appending, so a second run does not empty the pid the first wrote there; a second
  # waits 2 s, as long as a stream that has just been killed can take to go.
  exec 9>>"$sf.lock" || refuse "-s $sf: cannot open $sf.lock"
  if ! flock -w 2 9; then
    read -r holder <"$sf.lock" 2>/dev/null
    printf 'inbox-wait: a watcher already runs on %s (pid %s)\n' "$sf" "${holder:-unknown}"
    exit 0
  fi
  printf '%s\n' "$$" >"$sf.lock"
fi
m="" # each FILE's baseline, a line each, in order
for f; do
  if [ -n "$sf" ] && saved "$f"; then s="$sv"; else s="$(st "$f")"; fi
  m="$m$s$nl"
done
# The baseline is written before the first poll, in every form: a change made after
# this run ends is reported by the next even when this one saw none, and a run whose
# STATE cannot be written reports nothing it could not save.
rep=""
[ -z "$sf" ] || save "$@" || refuse "-s $sf: could not write it, so nothing it reports could be saved"
# shown PATH -- the event line for PATH: the last of the lines appended since the
# baseline ($bs bytes) up to the current size ($cs) that is not blank and does not match
# PATTERN, cut and escaped; nothing when every one is. NUL bytes are dropped, and the
# filter reads bytes (LC_ALL=C), so no byte makes grep call the text binary; a line is
# cut at 160 bytes, back to the start of a UTF-8 character.
shown() {
  tail -c +"$((bs + 1))" "$1" 2>/dev/null | head -c "$((cs - bs))" | tr -d '\000' \
    | LC_ALL=C grep -Ev -- "^[[:space:]]*\$${pat:+|$pat}" | tail -n 1 \
    | LC_ALL=C awk -v p="$1" '
      BEGIN { for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i }
      {
        s = $0; cut = 0
        if (length(s) > 160) {
          s = substr(s, 1, 160); cut = 1
          # back off a UTF-8 character the cut split: drop continuation bytes, then
          # the lead byte they belong to
          k = length(s)
          while (k > 0 && ord[substr(s, k, 1)] >= 128 && ord[substr(s, k, 1)] < 192) k--
          if (k > 0 && ord[substr(s, k, 1)] >= 192) {
            c = ord[substr(s, k, 1)]
            need = c >= 240 ? 4 : c >= 224 ? 3 : 2
            if (length(s) - k + 1 < need) s = substr(s, 1, k - 1)
          }
        }
        o = ""
        for (j = 1; j <= length(s); j++) {
          ch = substr(s, j, 1); c = ord[ch]
          if (c < 32) o = o "^" sprintf("%c", c + 64)
          else if (c == 127) o = o "^?"
          else o = o ch
        }
        printf "%s: %s%s\n", p, o, cut ? " ..." : ""
      }'
}
if [ -n "$follow" ]; then
  # -t is seconds by the clock: a poll takes longer than its sleep (a stat per FILE),
  # so a count of polls would outlast the deadline of the tool it is set inside.
  end=$(($(date +%s) + lim))
  while :; do
    [ -n "$alive" ] && touch "$alive" 2>/dev/null
    rest="$m" nm="" moved="" printed=""
    for f; do
      b="${rest%%"$nl"*}"
      rest="${rest#*"$nl"}"
      cur="$(st "$f")"
      nm="$nm$cur$nl"
      [ "$cur" != "$b" ] || continue
      moved=1
      # a stat line is "DATE TIME ZONE INODE SIZE"
      bi="${b#* * * }" ci="${cur#* * * }"
      bs="${bi#* }" cs="${ci#* }" bi="${bi% *}" ci="${ci% *}"
      if [ -n "$b" ] && [ -n "$cur" ] && [ "$bi" = "$ci" ] && [ "$cs" -gt "$bs" ]; then
        ev="$(shown "$f")"
      else
        ev="$f changed"
      fi
      # nothing when every appended line was dropped: no event
      [ -z "$ev" ] || { printf '%s\n' "$ev" && printed=1; }
    done
    m="$nm"
    if [ -n "$moved" ]; then
      rep=""
      save "$@" || printf 'inbox-wait: could not write %s; the next run reports these changes again\n' "$sf" >&2
    fi
    # -1: the poll that printed a line is the last, after its save
    [ -z "$once" ] || [ -z "$printed" ] || exit 0
    sleep 1 9>&-
    if [ "$lim" -gt 0 ] && [ "$(date +%s)" -ge "$end" ]; then exit 0; fi
  done
fi
n=0
while :; do
  [ -n "$alive" ] && touch "$alive" 2>/dev/null
  rest="$m"
  for f; do
    cur="$(st "$f")"
    [ "$cur" = "${rest%%"$nl"*}" ] || {
      printf '%s\n' "$f"
      rep="$f"
      [ -z "$sf" ] || save "$@" \
        || printf 'inbox-wait: could not write %s; the next run reports this change again\n' "$sf" >&2
      exit 0
    }
    rest="${rest#*"$nl"}"
  done
  sleep 1
  n=$((n + 1))
  if [ "$lim" -gt 0 ] && [ "$n" -ge "$lim" ]; then exit 1; fi
done
