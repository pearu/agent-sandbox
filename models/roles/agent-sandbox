# .agent-sandbox for the roles model (docs/roles.md), written by `asb --init roles`.
# Planners, Implementers and Reviewers are numbered instances; the Supervisor is one.
# Review it, add what this project needs -- hosts to allow, a Planner's material --
# and approve it with `asb --trust`; `asb --check --role NAME` shows what a role has.

# ---- what every role gets: --init writes it per role, [connect:planner-*] and so on --
#@ scope = roles
[sandbox]
preset = inherit
[conda]
prefix = {envpath}                # the development environment, {env}: main's build, the user's to activate on the host
[connect]
project = read-only               # the working tree, read-only; the Supervisor opens it
.asb/coord/ = read-only           # the message files and the index: every role reads all of them
.asb/scratch/ = own               # every role's private scratch, at the same path, kept across launches
./.git/ = own                     # history is its owner's: main's is the Supervisor's...
.asb/git/ = own                   # ...and a clone's its Implementer's
gh = read-only                    # your gh login, for reading issues and pull requests
#@shared {editable}/ = read-only    # with --shared-env: the env imports from it (an editable install)
[net]                             # every role reads the web and GitHub, and publishes nothing...
mode = strict                     # ...through the proxy only: under `proxy` a tool can ignore it
retrieve-only = on
git = refuse

# ---- planners: an expert each; a Planner's own material is a read-only line here --
[connect:planner-{n}]
.asb/plan/planner-{n}/ = read-write   # its Statements, Tasks and Measurements
.asb/coord/planner-{n}.md = read-write
[briefing:planner-*]              # reads .asb/roles/<role>.md, this instance's

# ---- implementers: a clone each --------------------------------------------------
[connect:implementer-{n}]
#@ clone = .asb/impl/{n}/ .asb/git/{n}/ impl-{n}
.asb/handoff/implementer-{n}/ = read-write
.asb/coord/implementer-{n}.md = read-write
.asb/impl/{n}/ = read-write       # its clone's tree, with its .env
.asb/git/{n}/ = read-write        # its clone's history
./.git/ = read-only               # the clone reads main's objects through it
#@shared {envpath}/ = copy-on-write  # another project's env: what it installs lands in its layer
#@own [conda:implementer-{n}]           # activation only; the clone is writable as its tree is
#@own prefix = .asb/impl/{n}/.env
[briefing:implementer-*]          # reads .asb/roles/<role>.md

# ---- reviewers: the common block already hides every history -----------------------
[connect:reviewer-{n}]
.asb/review/reviewer-{n}/ = read-write
.asb/coord/reviewer-{n}.md = read-write
[briefing:reviewer-*]             # reads .asb/roles/<role>.md

# ---- supervisor: the only role that reaches outside ------------------------------
[connect:supervisor]
project = read-write              # merges the branches in the main tree, pushes
./.git/ = read-write
.asb/impl/ = read-only            # the clones are the Implementers'; it fetches their branches
.asb/git/ = read-only
.asb/coord/supervisor.md = read-write
.asb/coord/COORDINATION.md = read-write   # the index
#@shared {envpath}/ = copy-on-write  # another project's env: what it installs lands in its layer
#@own [conda:supervisor]                # main's build lands in {env}, which lives in the conda tree
#@own write = 1
[net:supervisor]                  # ...except the Supervisor, which publishes
retrieve-only = off
git = allow
[briefing:supervisor]             # reads .asb/roles/supervisor.md

#@own # ---- setup: builds the environment, once per project, again after main moves ----
#@own #   asb --role setup claude
#@own [connect:setup]
#@own #@ setup = setup
#@own project = read-write              # the build lands in the tree, as when you build it yourself
#@own ./.git/ = read-only               # a build reads its version from the history; it commits nothing
#@own {envpath}/ = read-write           # the environment it creates and installs into
#@own gh = own                          # no login: it publishes nothing
#@own [net:setup]
#@own mode = strict                     # as the rest of this model: through the proxy only
#@own retrieve-only = on                # GET and HEAD only; git's fetch is a POST, so submodules come from your checkout
#@own git = refuse
#@own [briefing:setup]
#@own file = .asb/roles/setup.md
