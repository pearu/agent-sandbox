#@own retrieve-only = on                # GET and HEAD only; asb --apply '[net:setup]' 'git = fetch' lets it fetch submodules or a git dependency over HTTPS, a read; a push stays refused
#@own git = refuse
#@own [briefing:setup]
#@own file = .asb/roles/setup.md
