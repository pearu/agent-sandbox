# .agent-sandbox — per-project policy for the agent-sandbox sandbox.
#
# Copy this to `.agent-sandbox` in your project root and uncomment what you need.
# The next `asb claude` there shows it and asks you to approve it; or approve it
# without launching, from that directory:
#
#     asb --trust
#
# It is honored ONLY after approval, and a launch refuses a file you have not
# approved -- one shipped by a cloned repo included -- until you review it. Once
# approved, any edit or removal is shown to you again, as a diff, at the next
# launch. Inside the sandbox the file is read-only, so the agent cannot edit it.
# Keep it out of git; `--trust` offers to add it to .git/info/exclude, since its
# contents are machine-local.
#
# Format: INI-like. `[section]` headers, one item per line, `#` starts a
# comment (a whole line or the end of one). One item per line, so paths and
# hosts may contain spaces.


# --- Egress hosts --------------------------------------------------------
# Extra hosts this project may reach through the proxy, on top of the global
# allowlist and any `--allow`. A leading dot matches a domain and subdomains.
# (Same grant as `--allow`; ignored in the `open` and `none` network modes.)
#[allow]
#api.example.com
#.internal.example.org

# Hosts taken out of what this project's sessions may reach -- out of the global
# allowlist and the session's own grant -- never one the agent's profile needs.
#[deny]
#pypi.org


# --- Memory scoping ------------------------------------------------------
# Which other projects' Claude memory this session may read, read-only. By
# default it sees only its own project. List project paths (not the ~/.claude
# slug), use a `~/dir/*` wildcard to share the projects directly under a
# directory, or a single `all` to keep every project visible (`projects =
# read-write`). Sugar for [connect]; a [connect] line overrides it.
#[share-memory]
#~/git/acme/app
#~/work/*


# --- Environment: forwarded from your shell -------------------------------
# NAMES of environment variables to carry from your shell into the sandbox
# (the values come from your shell, not this file), on top of the built-in set
# (locale, proxy, TLS, CUDA). Do not put secrets for unrelated services here.
# Setting (NAME = VALUE) and refusing (-NAME) a variable are a profile's, not a
# project's: here they are warned of at the review and ignored.
#[env]
#CUDA_VISIBLE_DEVICES
#MY_TOOL_CONFIG


# --- Conda ---------------------------------------------------------------
# name  : run in this conda env (resolved under the active or discoverable
#         conda base) instead of whatever env is active in your shell. Its
#         bin/ takes the active env's place on PATH inside the sandbox, so the
#         env's own tools are the ones found there.
# prefix: the same for an env given by its path (relative to the project, ~,
#         or absolute), e.g. a clone in a role's tree; name and prefix are one
#         setting, the later wins.
# write : 1 makes the active env writable (mamba/pip install into it); the base
#         install, other envs and the host package cache stay read-only.
# pkgs  : sandbox-owned package cache, persistent, where conda downloads go.
#[conda]
#name = myproject-env
#prefix = .env
#write = 1
#pkgs = ~/.cache/agent-sandbox/conda-pkgs


# --- Network ---------------------------------------------------------------
# mode       : proxy (default: host network + the allowlist proxy), strict (own
#              network namespace, only the proxy reachable), open (host
#              network, NO allowlist), none (no network). An AGENT_SANDBOX_NET
#              set in your shell wins over this line.
# The port keys apply in strict mode, where pasta's port forwarding is off in
# both directions. Each may repeat; TCP; ports 1024-65535; `none` closes that
# direction for the session even if the command line or a knob lists ports.
# Loopback on both sides, never the LAN.
# host-port  : a host 127.0.0.1 port the sandbox may reach (a database, a
#              local model server). A raw path to that service, unfiltered by
#              the proxy.
# agent-port : a port the agent listens on, published at the host's
#              127.0.0.1:PORT (a dev server you open in a browser).
# git        : fetch lets git fetch and refuses a push and --ssh; refuse stops git
#              over HTTPS to every host (pages still load) and
#              refuses --ssh. Default allow.
# retrieve-only : on refuses every request but GET and HEAD (a GraphQL query to
#              api.github.com passes, a mutation does not), but to the agent's
#              own hosts: the session reads and publishes nothing. Off by default.
#[net]
#mode = strict
#retrieve-only = off
#git = allow
#host-port = 5432
#agent-port = 8000


# ---- seccomp: the syscall filter ------------------------------------------
# mode : on|off. `on` loads the default-deny filter compiled per machine by
#        install.sh; every syscall not allowlisted fails with EPERM, and the
#        agent cannot make its own user namespace to regain capabilities.
#        The value is the state, not a profile name. An AGENT_SANDBOX_SECCOMP
#        set in your shell wins over this line. Default: on, so `mode = on`
#        asks for what you already have and `mode = off` is a real widening.
#[seccomp]
#mode = on


# ---- briefing: what the session is told about its own sandbox --------------
# mode : on|off. Default on. The sandbox writes a briefing per launch (bound
#        read-only at /run/agent-sandbox/briefing.md) and has the agent inject
#        a compact summary at session start, resume and after compaction: what
#        egress is filtered, which paths are writable, which other projects are
#        readable, and how to ask you for something that is blocked. Names and
#        paths only, never the contents of anything shared. Off stops the
#        sandbox describing itself; it changes no limit.
#[briefing]
#mode = on
#
# file : a role's purpose file, injected after the engine's lines at every
#        session start; {role} is the role's name. In [briefing:<glob>] for the
#        roles the glob matches, where it defaults to .asb/roles/{role}.md. The
#        file is read-only inside and part of the approval: an edit re-opens
#        the review.
#[briefing:reviewer-*]
#file = .asb/roles/{role}.md


# ---- claude: options for the claude profile -------------------------------
# A section named after the ACTIVE profile, read by that profile and not by the
# engine. In a claude run, [codex] would be an unknown section and do nothing.
# hide : space-separated paths under ~/.claude to blank inside the sandbox, on
#        top of the cross-session state it already replaces per launch. Paths
#        are relative to ~/.claude; absolute or `..` is refused. `daemon` is
#        hidden already; `gh` and `ide` are not, because both exist to let
#        Claude Code work from inside a sandbox. Hiding something the agent
#        needs breaks that feature.
# [sandbox] -- this sandbox's own position and key.
#        preset = isolated | inherit | shared  (default: inherit)
#          isolated     nothing of your native install reaches it; what it
#                       creates is its own and persists
#          inherit      it reads your instructions, settings, skills, agents,
#                       workflows and plugins LIVE, and keeps its own writes to
#                       itself. The fidelity principle: it behaves like a
#                       native install whose configuration is yours, except that
#                       what it writes does not come back to you
#          shared       one directory, both ways -- what the engine did before
#                       0.3, and what to set if you want that back
#        Two more, `native` (parity with no sandbox, so that a difference is a
#        bug) and `none` (no sandbox at all), are NOT accepted here or from the
#        environment: only the --preset flag, because they turn isolation off
#        and a project file could set that for every launch unnoticed.
#        A preset moves only the channels the engine manages as connections.
#        Memory, transcripts and the rest keep their own controls
#        ([share-memory] and so on) until they are folded in. The config file
#        is the `config` channel: seed-only under inherit, own under isolated.
#        [connect] below overrides the preset per channel.
#
#        role names the project's default role; --role and AGENT_SANDBOX_ROLE
#        pick another. A role is a named, persistent instance of this project with
#        its own state. A [sandbox], [connect], [allow], [deny], [env], [conda] or
#        [net] section may take a role suffix,
#        [sandbox:<glob>], for the roles the glob matches: it applies after the
#        unsuffixed section, and later lines override earlier ones per key. Once
#        any suffixed section exists, a role name matching none of them is refused
#        (a typo, most likely); [connect:*] accepts every name.
#[sandbox]
#preset = inherit
#role = default

#[sandbox:reviewer]
#preset = isolated

# [connect] -- per channel, how much of your NATIVE Claude Code install this
#        project's sandbox sees: `channel = mode [source]` on the scale
#        own < seed-only < copy < copy-on-write < read-only < read-write, lower being more
#        isolated. The order is how much of YOUR files reach the sandbox, not
#        what it may do: it can write under copy-on-write but not under
#        read-only, and read-only is still higher, because it hands over the
#        real file where copy-on-write gives only a shadow of one.
#
#        own         nothing of yours; what the sandbox writes there is its own
#                    and persists across its launches
#        copy        seeded from your files and refreshed at each launch for
#                    anything the sandbox has not touched; never written back
#        copy-on-write
#                    reads fall through to your files until the sandbox writes,
#                    and the write goes to a private layer from then on
#        read-only   your files, live, and the sandbox cannot write them
#        read-write  one directory, both ways, no delay
#
#        The only source today is `native` (your own ~/.claude), which is
#        the default.
#        Channels the claude profile carries: instructions, settings, skills,
#        agents, workflows, plugins. Narrowing a channel needs nothing beyond
#        this file's own approval; widening one toward `read-write` is what the
#        --trust review is for. See docs/connections.md.
#[connect]
#instructions = read-only native
#skills = own native
#
#        A key with a `/` is a PATH, not a channel: how a path outside the
#        project is exposed. The key is the path inside the sandbox, the source
#        the same path outside, and every mode above applies. Secret stores (~/.ssh, ~/.aws, ~/.gnupg, ...), the
#        sandbox's own configuration, any directory containing one of them, `/`,
#        $HOME, any parent of $HOME and the project itself are always refused.
#/opt/shared-data = read-only
#/scratch/thisproject/ = read-write
#./scratch/ = own

#        The same for one role, and an empty [connect:*] so that every other role
#        name (including default) is still accepted once suffixed sections exist.
#[connect:reviewer]
#skills = read-only native
#[connect:*]

# [overlay] -- what `copy-on-write` is implemented WITH, not whether shared.
#        mode = auto (default) uses a real copy-on-write overlay where your
#        bubblewrap supports one (0.11 or newer) and falls back to `copy` where
#        it does not, saying so. mode = off takes the fallback everywhere.
#
#        Worth turning off if overlayfs is unhappy on your filesystem. It can
#        only ever move `copy-on-write` to `copy`, further from your native
#        install, so it is never a widening. The two behave identically across
#        launches; they differ only WITHIN a running session, where an overlay
#        picks up an edit you make to your own copy and a snapshot does not.
#        A channel path that names a FILE always uses the fallback: overlayfs
#        mounts directories and cannot stack on a single file.
#[overlay]
#mode = auto

#        To keep your user-level MCP servers out of this project's sandbox,
#        give it a config file of its own: `config = own` under [connect].
#        Every session, --bg included, is sandboxed; to run one without a
#        sandbox, type --preset none.
#[claude]
#hide = gh todos


# Not settable here, on purpose:
#   proxy-ca  — the CA the sandbox trusts; a trust anchor, not a per-project
#               setting.
#   profile-dir, session-base — engine internals.
# See `asb --engine-help` for these.
