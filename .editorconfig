# shfmt reads the shell settings below; run `shfmt -d .` to check, `shfmt -w .` to fix.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.sh,*.sh.in,*.bash,*.bats,agent-sandbox}]
indent_style = space
indent_size = 2
binary_next_line = true
switch_case_indent = true

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2
