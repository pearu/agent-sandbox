# profiles/claude/agent-sandbox -- the claude profile's own dot-file (#173, #181).
#
# The same grammar as a project's .agent-sandbox, read by the engine right after
# profile.sh, for every launch of this profile. It ships with the engine, so it is
# not reviewed the way a project's file is. It stands below a project's file:
# lists add up (a project's [claude] hide adds to [agent] hide, its [env] names and
# [allow] to these), and a project's value overrides a single-valued one.
#
# [agent] is this profile's own section; in a project's file the same section is
# named after the profile, [claude]. Of its keys a project may set only those
# profile.sh lists in profile_dotfile_keys (hide); the rest are the profile's.

[agent]
# Claude Code keeps its state in ~/.claude: sessions, OAuth/API tokens, settings -- or
# where CLAUDE_CONFIG_DIR says (vendor docs: "To keep the home-directory files somewhere
# else, set CLAUDE_CONFIG_DIR"). Set in the launching shell, it wins, so the sandbox is
# built on the state Claude Code really uses. That is {base} below; it is bound
# read-write before anything else, and every channel layers on it.
base = ~/.claude
# Inside, the engine sets it to the base it built (every preset but `native`): at its own
# default value nothing else moves, but Claude Code then keeps its config file at
# ~/.claude/.claude.json (measured: with the variable set, ~/.claude.json is never
# opened), which is where the config channel puts it. HOME is the same path inside and
# out, so the value is right on both sides.
base-env = CLAUDE_CONFIG_DIR

# The verbs that observe or manage the background service (#123). Its daemon runs
# inside the role's launch, so these join that launch -- and never start one: the
# observing ones answer "not running" when there is none, the others refuse.
verbs = daemon agents attach logs stop rm
verbs-observe = agents logs
# The daemon's argv marks it for the keeper, which it holds while it runs (it does
# not exit when idle, measured on 2.1.283, so a role with one ends by --shutdown).
daemon = daemon run
# What --status joins to list the daemon's sessions.
status = agents

# Paths under ~/.claude blanked for every launch: empty inside, gone at exit.
#
# Not the agent's own state, despite living in its directory: daemon/ holds the
# background supervisor's control key and a roster of other sessions' ids, pids
# and sockets. A sandboxed session has no use for it -- those sockets live under
# /tmp, which is a fresh tmpfs inside, so the key has nothing to talk to -- and it
# is a cross-session control channel, which is the one thing isolation exists to
# prevent.
#
# gh/ and ide/ are deliberately NOT here. Both exist to make Claude Code work from
# inside a sandbox: gh/ is a GH_CONFIG_DIR that lives in a bound directory because
# ~/.config/gh is not one, and ide/ carries the lockfiles an editor connects
# through. Hiding either would break the feature it was created for. A project's
# [claude] hide can add them.
hide = daemon
# Nothing below needs to outlive the session: a probe established that a session
# starts, and a resume completes, with the whole set blanked.
hide = session-env sessions jobs shell-snapshots debug paste-cache
# backups/ holds Claude Code's snapshots of the config file, and a project entry
# `claude project purge` removed from the live file was still readable there, from
# another project's sandbox (#75; leak study row 17, 2.1.272). A role's config is
# its own copy since #119, so nothing inside has a use for the native snapshots.
hide = backups
# feedback-bundles/ holds "feedback and bug-report archives you haven't yet sent"
# (Claude Code's docs), readable from another project's sandbox (#80; row 18). Per
# launch, so a bundle a sandboxed session did not send is gone when it exits.
hide = feedback-bundles
# image-cache/ held attached images up to Claude Code 2.1.274; later versions keep them in
# a per-session directory under the temp directory, which inside is the fresh /tmp. The
# docs: "Legacy directories not written by current versions". Blanked, so no other
# project's old images are in view (#77).
hide = image-cache

# Paths deliberately left NATIVE, so `asb --check` does not report them as unclassified
# (#82): anything under the base that no channel, hide or visible line names is listed
# there, since the default for an unknown path is exposed. .credentials.json is your
# login, the identity a sandbox runs as; gh/ and ide/ exist to make Claude Code work
# from inside a sandbox (above).
visible = .credentials.json gh ide

# The environment: NAME forwards it when set in the launching shell, NAME = VALUE sets
# it, -NAME refuses it whatever a project's file says.
[env]
ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL
ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
# Never let the sandboxed claude try to self-update. Downloads are blocked by the proxy
# allowlist and the versions directory is not bound, so the attempt could only fail;
# `claude update` typed at your own shell -- Claude Code itself, since nothing shadows
# `claude` (#151) -- is the supported path. The legacy `autoUpdates: false` in
# ~/.claude.json is ignored for native installs.
DISABLE_AUTOUPDATER = 1
# With CLAUDE_CONFIG_DIR set, Claude Code honours CLAUDE_CODE_PROJECT_DIR_NAME, which
# stores every session's transcripts and memory under one name -- out from under the
# per-project scoping, silently. Never forwarded.
-CLAUDE_CODE_PROJECT_DIR_NAME

# Hosts Claude Code must reach: this launch's session allowlist, on top of the
# global one. One host per line; a leading dot matches the domain and its
# subdomains.
[allow]
api.anthropic.com
.anthropic.com
# OAuth sign-in. `/login` makes requests to this host from inside the sandbox;
# without it sign-in fails with "OAuth error: proxy refused the connection" and the
# only way through is AGENT_SANDBOX_NET=open, which turns egress filtering off
# entirely -- a wide door for a narrow need.
platform.claude.com
statsigapi.net
.statsig.com

# ----- the channel table -------------------------------------------------------------
# A CHANNEL is named by what it carries; a section says where THIS agent keeps it, a path
# per line. The engine owns the modes and the mechanism, the profile owns the paths. A
# trailing `/` is a directory, else a file (#189). A value says what the table says
# about that path: `outside:SRC` -- the path it follows outside; `filter:FN` -- the
# profile function that writes the seeding modes' view of it; `vendor:PREFIX` -- paths
# under it the agent itself rewrites on both sides, which a conflict warning does not
# name; `start:FILE` -- what its store starts as when there is nothing to seed from
# (`own`, or `seed-only` with no source), a template beside this file ({profile}).
#
# `reach = HOW` says how what another session left at a channel ARRIVES in a session, on
# the leak study's scale: `context` (loaded into every session, never searched for),
# `searched` (found when the agent looks, or is told it is stored somewhere), `pointed`
# (only when you point the agent there), `never`; text after ` -- ` is a note for the
# reader. `asb --check` prints it beside every channel that crosses the boundary. A
# channel without one prints UNMEASURED: a reach is a measurement, not a guess.
# Measured: rows 5, 25, 26 of docs/claude-2.1-leak-results-0.2.0.md (2.1.273), and on
# 2.1.286 with canaries in an isolated role's own stores (2026-10-02): a plain question
# found what is in context; told the code words are stored somewhere, it found the rest.
# `projects` is row 25's shared channel (another project's memory); its conversations
# were not measured apart. Not yet measured: workflows, plugins, config, transcripts,
# logs, policy, changelog.
#
# Paths nest: the engine binds them by depth, outer first (#196), so the deeper line
# governs its subtree -- `projects/` is every project's state, `projects/{slug}/` this
# project's conversations inside it, and `projects/{slug}/memory/` its memory inside that.
#
# Only identity, project and tools are not here: each has machinery of its own (the
# credential bind, the working tree, the config file); folding them onto connections is
# a separate step, per channel.

[channel:instructions]
reach = context
{base}/CLAUDE.md
{base}/rules/

[channel:settings]
reach = context -- a SessionStart hook runs, and what it prints is in context
{base}/settings.json
{base}/output-styles/

# The server skills and plugins Claude Code syncs itself, inside a sandbox and natively
# alike: their bookkeeping changes on both sides at every sync, which is not an edit of
# yours for a conflict warning to report.
[channel:skills]
reach = context -- their descriptions are in every session, a body when invoked
{base}/skills/ = vendor:synced/
{base}/commands/

[channel:agents]
reach = context -- their descriptions are in every session, a body when invoked
{base}/agents/

[channel:workflows]
{base}/workflows/

[channel:plugins]
{base}/plugins/ = vendor:synced/

# THE CONFIG FILE IS A CHANNEL (#119), one file following its mode like any other. It
# moves INSIDE the state directory: ~/.claude.json must be writable the way Claude Code
# writes it -- a lock directory and a temp file beside it, then a rename over it
# (measured, 2.1.274) -- and beside $HOME/.claude.json is the read-only $HOME tmpfs,
# where every write was silently lost. Inside the base, with CLAUDE_CONFIG_DIR pointing
# Claude Code there, the rename onto the bind fails (EBUSY) and Claude Code rewrites the
# file in place, which reaches the bound file. Its source is the native ~/.claude.json;
# with CLAUDE_CONFIG_DIR set, native Claude Code keeps it in the base already, and the
# profile drops this relocation (code: it depends on the launching environment). The
# seeding modes read a FILTERED view -- every top-level key and only this project's
# entry, the fix for leak study row 10 -- and after that the file is Claude Code's.
# `own` starts it from {} (config.json beside this file): measured on 2.1.285, a 0-byte
# .claude.json is "corrupted" and the session fails, while {} runs -- Claude Code
# rebuilds the account block itself.
[channel:config]
{base}/.claude.json = outside:~/.claude.json filter:_claude_config_filter start:{profile}/config.json

# EVERY PROJECT'S STATE IS A CHANNEL (#196): Claude Code keeps each project's
# conversations and memory under projects/<slug>/, and another project's are none of this
# one's business -- the role's own store holds whatever lands there beside this
# project's. `[share-memory]` is the sugar a project uses to open it: `all` is
# `projects = read-write`, a path is a read-only declaration of that project's memory.
[channel:projects]
reach = searched -- another project's memory, found when the agent looks
{base}/projects/

# TRANSCRIPTS AND LOGS ARE CHANNELS (#120): a role's conversations, file history, plans
# and prompt history are its own, and so are the logs your hooks write. The
# conversations' directory depends on the project ({slug}, #176). `transcripts =
# seed-only` seeds them once, and seeds the prompt history FILTERED to this project's
# records.
[channel:transcripts]
# usage-data/ is /insights' reports and "cached per-session analysis data" (the docs):
# derived from the conversations, so it goes where they do (#79).
{base}/usage-data/
{base}/file-history/
{base}/plans/
{base}/history.jsonl = filter:_claude_history_view
{base}/projects/{slug}/

# MEMORY IS A CHANNEL (#196): what Claude Code writes down for the next session of this
# project, loaded into its context automatically. What you write -- instructions,
# settings, skills -- a sandbox inherits copy-on-write; what the agent writes --
# transcripts, logs, memory -- is the role's own, so two roles of one project share
# nothing but the directory unless connected (#55). `memory = copy-on-write` reads yours
# live and keeps its writes; `seed-only` carries yours over once.
[channel:memory]
reach = context
{base}/projects/{slug}/memory/

# AGENT MEMORY IS A CHANNEL (#74): "persistent memory for subagents" (the docs), kept per
# subagent, not per project -- so outside `projects/`, and until now every project's.
# Memory's rungs: the role's own under isolated and inherit, yours under shared.
[channel:agent-memory]
{base}/agent-memory/

[channel:logs]
{base}/responses.log
{base}/alerts.log

# ARTEFACTS ARE A CHANNEL: what sessions leave for each other to pick up -- downloaded
# documents, uploaded files, task lists (#52, #76, #78; leak study row 18).
[channel:artefacts]
reach = searched
{base}/downloads/
{base}/uploads/
{base}/tasks/

# POLICY AND CHANGELOG ARE CHANNELS (#109): Claude Code's caches of server-managed
# settings and policy flags, and of the vendor changelog -- each was a cross-project
# write channel into what the user and the agent take as Anthropic's. The stamp moves
# with its policy file: a private cache beside a shared stamp would split the pair. Each
# starts as {} under `own` (measured: with no policy files at all a session runs
# normally and fetches fresh ones; a 0-byte JSON file is not that).
[channel:policy]
{base}/remote-settings.json = start:{profile}/policy.json
{base}/policy-limits.json = start:{profile}/policy.json
{base}/policy-limits.json.stamp.json = start:{profile}/policy.json

[channel:changelog]
{base}/cache/changelog.md

# ----- the presets' rungs --------------------------------------------------------------
# Where a channel sits under a preset when that is not the ladder's rung (isolated: own,
# inherit: copy-on-write, shared: read-write). A project's [connect] overrides any of them.
#
# `config` and `policy` are seed-only under `inherit`: Claude Code rewrites them at every
# launch (it refetches policy through the allowlist), so `copy` would warn at every
# launch. `config` is seed-only under `shared` too, not read-write: `shared` is "the
# engine before 0.3", and 0.2.1 already gave each project its own copy -- read-write
# would reopen #90. A role's transcripts and logs are its own under both; artefacts are
# its own under `inherit` (#52, #76, #78). `changelog` keeps the ladder's copy-on-write,
# which on a single file is copy: only your side fetches it, so it refreshes cleanly.
# Other projects' state is hidden under both (`projects`), as it was before 0.3; memory
# is the role's own under `inherit` and your native memory under `shared` (#196).
[preset:inherit]
config = seed-only
projects = own
transcripts = own
memory = own
agent-memory = own
logs = own
artefacts = own
policy = seed-only

[preset:shared]
config = seed-only
projects = own
transcripts = own
logs = own
