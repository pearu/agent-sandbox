#!/usr/bin/env bash
# agent-sandbox — run an AI coding agent inside a bubblewrap sandbox.
#
# The engine in this file is provider-agnostic. Everything specific to one
# agent -- which state paths it needs read-write, which environment it wants,
# which subcommands must run on the host -- is a PROFILE: profiles/<name>.sh
# next to this file, sourced at launch. The flagship profile is `claude`
# (Claude Code). profiles/claude.sh documents the contract a profile implements.
#
# It is invoked explicitly (#151), as `agent-sandbox` or its alias `asb`:
#
#   asb [ENGINE OPTIONS] CMD [AGENT OPTIONS]
#
# The engine's options come first and CMD ends them: everything after it is the
# agent's, untouched. CMD is a name looked up on PATH (`claude`) or a path
# (`/path/to/2.1.284`), and its basename names the profile unless --profile does.
# `claude` itself stays Claude Code: nothing shadows it, so typing it runs the
# agent natively, exactly as without agent-sandbox installed.
#
# ============================================================================
# QUICK START
# ============================================================================
#
# Prerequisites:
#   - bubblewrap installed:   sudo apt install bubblewrap
#   - the agent itself, on PATH or anywhere a path can name it. For `claude`:
#     Claude Code from its native installer or a package; the engine runs
#     whatever `claude` resolves to.
#
# Install (pick one):
#   1. ./install.sh -- per-host setup: egress proxy + allowlist, AppArmor
#      profile where needed, and `agent-sandbox` and `asb` in ~/.local/bin.
#   2. By hand, just the command onto your PATH:
#        ln -s "$PWD/agent-sandbox" "$HOME/.local/bin/asb"
#   3. No symlink at all: /path/to/agent-sandbox claude [args]
#
# Use:
#   cd /path/to/some/project
#   conda activate myenv          # optional; the active env is forwarded
#   asb claude                    # sandboxed claude with CWD writable
#   asb --ssh github.com claude   # + git push / ssh to github.com through a
#                                 # per-session ssh-agent; the private key
#                                 # never enters the sandbox (docs/ssh.md)
#   asb --allow pypi.org claude   # + HTTPS to pypi.org through the egress
#                                 # proxy, for this session only
#   asb --role reviewer claude -r # another role of this project, resuming
#   claude                        # Claude Code itself, not sandboxed
#
# ============================================================================
# SANDBOX LAYOUT (what the agent sees)
# ============================================================================
#
#   /usr, /etc, /opt, /lib*, /bin, /sbin    read-only (system)
#   /usr/local                              read-only; if it's a symlink off
#                                           /usr (e.g. to /mnt/.../local) the
#                                           real target is auto-exposed too
#   /tmp, /var/tmp, /run, /proc, /dev       fresh, ephemeral
#   $HOME                                   read-only tmpfs — only these are
#                                           visible inside it:
#     $HOME/.claude                         read-write (claude's state dir).
#                                           Per-project memory under
#                                           .claude/projects can be scoped so
#                                           a session sees only its own and
#                                           approved projects -- see the
#                                           per-project config in docs/config.md.
#     $HOME/.claude/.claude.json            read-write: THIS PROJECT'S copy of
#                                           ~/.claude.json (claude's config
#                                           file), kept on the host under
#                                           ~/.local/state/agent-sandbox/claude/
#                                           <slug>/ and bound INSIDE the state
#                                           dir. The profile sets
#                                           CLAUDE_CONFIG_DIR=$HOME/.claude, so
#                                           claude looks for it there -- where
#                                           the lock and temp file it writes
#                                           beside it can be created. Beside a
#                                           read-only $HOME they cannot, and
#                                           every write was silently lost.
#     $CONDA_PREFIX  (if set)               read-only by default; the base
#                                           conda install (conda/mamba, other
#                                           envs, package cache) is bound
#                                           read-only too so those commands
#                                           work. AGENT_SANDBOX_CONDA_WRITE=1
#                                           makes the active env read-write
#                                           for `mamba install`/`pip install`;
#                                           the base stays read-only and
#                                           downloads go to a sandbox-owned
#                                           package cache (knob below).
#     $HOME/.cache                          writable, empty, session-private
#                                           tmpfs for tool caches; gone at exit
#     $HOME/.conda  (if conda is active)    likewise: conda's registry and
#                                           fallback dirs, ephemeral
#     ~/.condarc, ~/.mambarc  (if present)  read-only
#   /etc/ssl/certs/ca-certificates.crt     (proxy mode) the host's CA bundle
#                                           plus the egress proxy's CA, so TLS
#                                           interception is trusted inside the
#                                           sandbox only; the host never trusts
#                                           that CA
#     $CWD                                  read-write (unless CWD == $HOME,
#                                           in which case nothing extra is
#                                           bound — refuse to expose all of
#                                           $HOME)
#   network                                 By default: --share-net plus
#                                           HTTPS_PROXY pointing at a host-
#                                           side mitmproxy with an allowlist
#                                           (see docs/network.md).
#                                           Override per-invocation via
#                                           AGENT_SANDBOX_NET=open|strict|none.
#
# Environment is cleared by default. The default allowlist forwards locale
# (LANG/LC_*/TZ), color hints, Anthropic config (ANTHROPIC_API_KEY etc.),
# standard proxy vars, TLS CA overrides, and CUDA vars (CUDA_HOME,
# CUDAToolkit_ROOT, LD_LIBRARY_PATH). Anything else (AWS_*, GH_TOKEN,
# KUBECONFIG, SSH_AUTH_SOCK, ...) stays outside.
#
# ============================================================================
# OPTIONAL KNOBS (set in the calling shell)
# ============================================================================
#
#   AGENT_SANDBOX_RO=/path/a:/path/b   extra read-only paths (colon-sep)
#   AGENT_SANDBOX_RW=/path/c           extra read-write paths (colon-sep)
#   (RO/RW, FORWARD, the conda knobs, the network mode and the strict-mode
#    ports can also be set per-project in a trusted .agent-sandbox file; an
#    explicit knob in your shell wins over the file -- see docs/config.md.)
#   AGENT_SANDBOX_FORWARD="A B C"      extra env vars to forward (space-
#                                       or colon-separated names)
#   AGENT_SANDBOX_SECCOMP=on|off       default-deny seccomp syscall filter
#                                       (Docker's default profile, as for a container
#                                       with no capabilities; compiled by install.sh).
#                                       Default: on.
#   AGENT_SANDBOX_CONDA_WRITE=1        bind the active conda env read-write so
#                                       the agent can `mamba install`, `pip
#                                       install`, etc. into it. The base conda
#                                       install stays read-only; packages are
#                                       downloaded into the sandbox's own cache
#                                       (below), never the host's. Default 0.
#   AGENT_SANDBOX_CONDA_PKGS=/dir      that cache's location on the host
#                                       (default ~/.cache/agent-sandbox/conda-pkgs;
#                                       persistent, so large packages are not
#                                       re-downloaded every session)
#   AGENT_SANDBOX_PROXY_CA=/file       the egress proxy's CA certificate
#                                       (default ~/.mitmproxy/mitmproxy-ca-cert.pem)
#   AGENT_SANDBOX_NET=proxy|strict|open|none  network mode (default: proxy)
#       proxy  : --share-net plus HTTPS_PROXY pointing at a host-side
#                mitmproxy that enforces ~/.config/agent-sandbox/allowlist.txt.
#                Any tool that honors HTTPS_PROXY (the agent, curl, git, pip,
#                npm, conda, ...) is filtered. Tools that bypass HTTPS_PROXY
#                with raw sockets, or talk to localhost/LAN directly, are
#                NOT filtered. This is the working default on Ubuntu 24.04.
#       strict : pasta owns an isolated netns and forwards it to the host in
#                userspace; an nftables rule inside drops everything except the
#                proxy on the default gateway. Closes the raw-socket loophole (a
#                tool ignoring HTTPS_PROXY has no route out) and blocks
#                localhost/LAN: pasta's port forwarding is off both ways, so no
#                host loopback service is mirrored into the sandbox and no
#                sandbox listener is published on the host. --ssh HOST works
#                (the firewall is opened to that host's resolved IPv4 and its
#                name is put in /etc/hosts; --ssh-unrestricted is refused).
#                Needs the 'passt' package and its AppArmor profile (install.sh
#                adds it) plus nftables. See docs/network.md and issue #1.
#       open   : --share-net, no proxy. Debug only.
#       none   : no network at all (offline work).
#   AGENT_SANDBOX_HOST_PORTS="5432 11434"   (strict) host 127.0.0.1 ports the
#   AGENT_SANDBOX_AGENT_PORTS="8000"        sandbox may reach / agent ports
#                                       published on the host's 127.0.0.1; the
#                                       same as --host-port / --agent-port
#                                       below (a list, or `none`)
#   AGENT_SANDBOX_PROFILE_DIR=/dir      where profiles live (default: the
#                                       profiles/ directory next to this file)
#   AGENT_SANDBOX_SESSION_BASE=/dir     where per-session state lives (default:
#                                       $XDG_RUNTIME_DIR/agent-sandbox.<uid>,
#                                       falling back to /tmp/agent-sandbox.<uid>)
#   AGENT_SANDBOX_JOIN=/path            the join helper (default:
#                                       components/join.py next to this file)
#   AGENT_SANDBOX_KEEPER_GRACE=SECONDS  how long a role's keeper waits once
#                                       nothing is joined before it ends
#                                       (default: 2; the test suites use 0)
#
# ============================================================================
# ENGINE FLAGS
# ============================================================================
#
# The engine's own flags come BEFORE the command, and the agent sees only what
# follows the command:
#
#   --profile NAME        select the provider profile, when the command's
#                         basename does not name it (see top of file)
#   --allow HOST          allow HOST through the egress proxy for THIS session
#                         only, on top of the global allowlist. Repeatable.
#                         ".example.com" matches the domain and its
#                         subdomains. The engine writes the hosts to a
#                         per-session file (see AGENT_SANDBOX_SESSION_BASE)
#                         that the proxy addon reads; the addon honours it
#                         only while this session's process is alive, so a
#                         killed session cannot leave a host open. --allow is
#                         scoped to THIS session: the engine mints a per-session
#                         token, carries it in the sandbox's proxy URL, and the
#                         addon grants the global allowlist plus only the
#                         matching session's --allow -- so another concurrent
#                         session cannot reach this one's --allow hosts.
#   --host-port PORT      (strict mode) let the sandbox reach the host's
#                         127.0.0.1:PORT -- a database, a local model server.
#                         Repeatable; 1024-65535; `none` opens nothing this
#                         session even if a knob or the dot-file lists ports.
#                         A raw path to that one service, unfiltered by the
#                         proxy.
#   --agent-port PORT     (strict mode) publish a port the agent listens on at
#                         the host's 127.0.0.1:PORT -- a dev server you open
#                         in a browser. Same rules. Both are TCP only; the
#                         flags, the knobs above and a trusted .agent-sandbox
#                         [net] section form a union; noted and ignored in the
#                         other modes (proxy/open already share the host's
#                         network, none has none). See docs/network.md.
#   --ssh HOST, --ssh-unrestricted, --ssh-key PATH, --ssh-timeout LIFE
#                         see docs/ssh.md
#   --trust               review and approve this project's .agent-sandbox
#                         file (per-project policy: allow hosts, memory
#                         scoping, paths, environment, conda, network), then
#                         exit: the review a launch at a terminal runs itself
#                         (#143), for when there is none. Without a terminal
#                         a launch refuses a new, changed or missing file
#                         until it is reviewed. See docs/config.md.
#   --engine-help         engine usage even when a profile is selected (with a
#                         profile, -h/--help goes to the agent, and its help
#                         ends with a footer pointing here)
#   --engine-version      print the agent-sandbox version and exit
#   -h, --help            engine usage when it comes before any command;
#                         after the command (`asb claude --help`) it is the
#                         agent's
#
# Secret stores (~/.ssh, ~/.gnupg, ~/.aws, ~/.azure, ~/.kube, ~/.docker,
# ~/.password-store, ~/.config/{gcloud,sops,gh}, ~/.local/share/keyrings,
# ~/.netrc, ~/.git-credentials, ~/.npmrc, ~/.pypirc) and the sandbox's own
# control plane (~/.config/agent-sandbox, ~/.mitmproxy,
# ~/.local/share/agent-sandbox, ~/.local/state/agent-sandbox, ~/.local/bin,
# ~/.config/systemd) are refused as
# CWD and as AGENT_SANDBOX_RO or _RW targets, and so is any directory that
# contains one of them (~/.config, ~/.local): bind a specific subdirectory
# instead. Paths that resolve to "/", "$HOME" or a parent of $HOME are refused
# outright, as CWD too. The list is a blocklist and cannot be complete;
# see _as_secret_paths below.
#
# ============================================================================
# DOCUMENTATION
# ============================================================================
#
# The reference lives in docs/ next to this file:
#   docs/design.md           architecture, threat model, every guarantee with
#                            its mechanism and check, RESIDUAL RISKS, open
#                            design questions
#   docs/network.md          network modes, the allowlist, --allow, the proxy
#                            CA and how it is trusted inside the sandbox only
#   docs/ssh.md              the SSH broker: --ssh, --ssh-unrestricted,
#                            --ssh-key, --ssh-timeout
#   docs/config.md           the per-project .agent-sandbox file, its trust
#                            gate, and per-project memory scoping
#   docs/profiles.md         the profile contract; adding an agent
#   docs/updating.md         host-routed agent updates (claude update)
#   docs/troubleshooting.md  error messages and their fixes
# README.md has install and quick start; AGENTS.md has the rules for
# maintainers. Read docs/design.md before changing anything below: the engine
# is security-sensitive and the residual-risk list there must stay true.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
# Defined at top level (not inside agent_sandbox) so tests can `source` this
# file and exercise them directly. They are only ever called from inside
# agent_sandbox(), whose locals (args, _session_dir, ...) they reach through
# bash's dynamic scoping.

_as_msg() { echo "agent-sandbox: $*" >&2; }

# Routine status: what the resolved policy IS on a normal launch (the dot-file
# values applied, the session allowlist, the seccomp filter in use). Silenced by
# --quiet / AGENT_SANDBOX_QUIET, which exists so a script or harness invoking the
# engine repeatedly is not drowned in banner lines.
#
# Refusals, warnings, and anything announcing that something is NOT sandboxed
# stay on _as_msg deliberately: --quiet must never be able to hide why a launch
# was refused, why a path did not bind, or that a command is running outside the
# sandbox. Quiet is about noise, never about consequences.
_as_quiet=0
_as_info() { ((_as_quiet)) || _as_msg "$@"; }

# The agent-sandbox version: the VERSION file next to the engine, plus a build
# marker when known (the .build install.sh writes, else `git describe` in a
# checkout). `engine` and `profile_dir` are set by the caller (agent_sandbox).
_as_version() {
  local dir vf bf v="unknown" b=""
  dir="$(dirname -- "$engine")"
  vf="$dir/VERSION"
  bf="$dir/.build"
  [[ -r "$vf" ]] && v="$(<"$vf")"
  if [[ -r "$bf" ]]; then
    b="$(<"$bf")"
  elif command -v git >/dev/null && git -C "$dir" rev-parse --short HEAD >/dev/null 2>&1; then
    b="$(git -C "$dir" describe --always --dirty --tags 2>/dev/null || git -C "$dir" rev-parse --short HEAD 2>/dev/null || true)"
  fi
  printf 'agent-sandbox %s%s\n' "$v" "${b:+ ($b)}"
}

_as_usage() {
  cat <<'USAGE'
usage: asb [ENGINE FLAGS] CMD [AGENT ARGS...]        (asb = agent-sandbox)
       asb [ENGINE FLAGS] --profile NAME VERB          (--status, --shutdown, ...)
       asb [ENGINE FLAGS] --profile NAME --exec CMD [ARGS...]

Runs an AI coding agent inside a bubblewrap sandbox: `asb claude`. CMD is the
agent, a name looked up on PATH or a path; everything after it is the agent's.
The profile (profiles/<NAME>.sh next to this script, or
$AGENT_SANDBOX_PROFILE_DIR) is CMD's basename unless --profile names it:
`asb --profile claude /path/to/2.1.284`. `claude` alone is Claude Code itself,
not sandboxed.

Engine flags (before CMD):
  --profile NAME        provider profile, when CMD's basename is not its name
  --allow HOST          also allow HOST through the egress proxy, for this
                        session only; repeatable; ".example.com" matches the
                        domain and its subdomains
  --host-port PORT      (strict) let the sandbox reach the host's
                        127.0.0.1:PORT; repeatable; 1024-65535, or none
  --agent-port PORT     (strict) publish the agent's PORT at the host's
                        127.0.0.1:PORT; repeatable; 1024-65535, or none
  --ssh HOST            allow SSH to HOST via a per-session, destination-
                        constrained agent (the key stays on the host);
                        repeatable
  --ssh-unrestricted    SSH anywhere the key is accepted (mutually exclusive
                        with --ssh HOST)
  --ssh-key PATH        private key to load (default: what `ssh -G` picks)
  --ssh-timeout LIFE    expire the loaded key after LIFE (e.g. 30m, 2h)
  --trust               review and approve this project's .agent-sandbox
                        file, then exit (see docs/config.md)
  --quiet               suppress the routine status lines (dot-file values
                        applied, session allowlist, seccomp filter in use).
                        Refusals, warnings and "not sandboxed" notices are
                        never suppressed
  --exec CMD [ARGS...]  run CMD instead of the agent, in the sandbox this
                        profile would have built for it (so --profile names
                        the profile). Everything after --exec is the command,
                        so engine flags come first.
                        The agent binary stays bound read-only, so an agent
                        started from inside runs natively there
  --role NAME           which role of this project to run: a named, persistent
                        instance with its own state, and the policy the
                        dot-file's [sandbox:<glob>]/[connect:<glob>] sections
                        give roles matching NAME. Default: [sandbox] role, else
                        `default`.
  --preset NAME         where every channel sits before any override:
                        `isolated` (nothing of your install), `inherit`
                        (read your files live, keep the sandbox's writes to
                        itself) or `shared` (one directory, both ways -- what
                        the engine did before 0.3). Default: default.
                        `native` and `none` are also accepted HERE ONLY, never
                        from the environment or a project file: `none` runs the
                        agent with no sandbox at all, and `native` turns state
                        isolation off so that any difference from `none` is a
                        bug in agent-sandbox
  --shutdown            end this role's running sandbox -- everything joined
                        into it, and a background daemon -- then exit
  --overlay auto|off    what `copy-on-write` uses: an overlay where
                        bubblewrap supports one (auto), or the copy fallback
                        everywhere (off). Only moves `copy-on-write` to `copy`
  --reset CHANNEL|PATH  discard what this role holds at CHANNEL (or a declared
                        PATH) and take the source's again, then exit. What the
                        conflict warning points at
  --status              show this role's sandbox: the keeper, what runs in it,
                        the background daemon's sessions
  --delete              remove every store of this role; refused while anything
                        runs in it (see --shutdown)
  --connect SPEC        open one channel at one mode: 'channel=mode [source]
                        [scope]',
                        repeatable. Lower on the scale own < seed-only <
                        copy < copy-on-write < read-only < read-write is more
                        isolated; the preset sets where every channel is by
                        default, which is what the engine has always done. See
                        docs/connections.md
  --engine-help         this text, even when a profile is selected
  --engine-version      print the agent-sandbox version and exit
  -h, --help            this text, before any command; after one
                        (`asb claude --help`) it is the agent's

Environment knobs:
  AGENT_SANDBOX_RO=/a:/b        extra read-only paths
  AGENT_SANDBOX_RW=/c           extra read-write paths
  AGENT_SANDBOX_FORWARD="A B"   extra environment variables to forward
  AGENT_SANDBOX_SECCOMP=on|off  default-deny seccomp syscall filter (default: on)
  AGENT_SANDBOX_CONDA_WRITE=1   bind the active conda env read-write
  AGENT_SANDBOX_CONDA_PKGS=/dir sandbox-owned conda package cache (write mode)
  AGENT_SANDBOX_PROXY_CA=/file  the egress proxy's CA (default ~/.mitmproxy/mitmproxy-ca-cert.pem)
  AGENT_SANDBOX_CONNECT="instructions=read-only native;skills=own native"
                                per-channel connections, ';'-separated; same
                                syntax as --connect and [connect] (modes:
                                own|seed-only|copy|copy-on-write|read-only|read-write)
  AGENT_SANDBOX_ROLE=NAME       the role, as --role (which wins)
  AGENT_SANDBOX_PRESET=isolated|inherit|shared   where every channel sits
                                (default: inherit)
  AGENT_SANDBOX_OVERLAY=auto|off  what `copy-on-write` uses (default: auto)
  AGENT_SANDBOX_NET=proxy|strict|open|none   network mode (default: proxy)
  AGENT_SANDBOX_HOST_PORTS="5432 11434"  (strict) same as --host-port, or none
  AGENT_SANDBOX_AGENT_PORTS="8000"       (strict) same as --agent-port, or none
  AGENT_SANDBOX_PROFILE_DIR     where profiles live
  AGENT_SANDBOX_SESSION_BASE    where per-session state lives
  AGENT_SANDBOX_JOIN            the join helper (default: components/join.py)
  AGENT_SANDBOX_KEEPER_GRACE=SECONDS  how long an idle role's keeper waits
                                before it ends (default: 2)
USAGE
}

_as_list_profiles() {
  local d="$1" f
  local -a names=()
  for f in "$d"/*.sh; do
    [[ -r "$f" ]] && names+=("$(basename -- "${f%.sh}")")
  done
  if ((${#names[@]} > 0)); then printf '%s' "${names[*]}"; else printf '(none)'; fi
  return 0
}

# Split $3 on the separator characters in $2 into the array named by $1.
# IFS is local to this helper on purpose: `local IFS` in agent_sandbox itself
# would stay in effect for the rest of that function and silently change
# every later unquoted expansion there.
_as_split() {
  local -n _as_out="$1"
  local IFS="$2"
  read -ra _as_out <<<"$3" || true
  return 0
}

# Paths never exposed to the sandbox: not as CWD, not as an RO or RW bind, and
# not through a directory that contains them (binding ~/.config or ~/.local
# would expose them all; bind a specific subdirectory instead). Two kinds:
#   secret stores      keys, tokens and credentials of services the sandbox is
#                      meant to keep the agent away from. Reading one is as bad
#                      as writing it, so RO gets the same refusal as RW.
#   the control plane  the sandbox's own machinery on the host. Writable from
#                      inside, it would let the agent forge dot-file approvals
#                      and edit the allowlist (~/.config/agent-sandbox), take
#                      the proxy CA key (~/.mitmproxy), replace the proxy
#                      runtime or addon (~/.local/share/agent-sandbox), its
#                      per-project state (~/.local/state/agent-sandbox),
#                      re-point the launcher (~/.local/bin) or install a user
#                      unit that runs at login (~/.config/systemd). Refused
#                      read-only too, for one rule instead of two.
# A blocklist cannot be complete: anything you bind that is not listed here is
# yours to judge. Paths are compared resolved (readlink -f), as-is.
_as_secret_paths() {
  printf '%s\n' "$HOME"/.ssh "$HOME"/.gnupg "$HOME"/.aws "$HOME"/.azure "$HOME"/.kube \
    "$HOME"/.docker "$HOME"/.password-store "$HOME"/.config/gcloud "$HOME"/.config/sops \
    "$HOME"/.config/gh "$HOME"/.local/share/keyrings "$HOME"/.netrc "$HOME"/.git-credentials \
    "$HOME"/.npmrc "$HOME"/.pypirc
}
_as_control_paths() {
  printf '%s\n' "$HOME"/.config/agent-sandbox "$HOME"/.mitmproxy "$HOME"/.local/share/agent-sandbox \
    "$HOME"/.local/bin "$HOME"/.config/systemd "$(_as_state_dir)"
}

# The engine's per-user STATE directory: persistent, host-only, never bound
# into a sandbox (it is a control path above). Distinct from the session base
# (runtime, per launch) and from ~/.config/agent-sandbox (the trust store and
# global config). The claude profile keeps each project's copy of the agent's
# config file here, under claude/<slug>/.
_as_state_dir() { printf '%s' "${XDG_STATE_HOME:-$HOME/.local/state}/agent-sandbox"; }

# Is the resolved path $1 protected? On yes, sets the caller's _prot_what ("the
# secret store" / "the sandbox's own control plane"), _prot_path (the listed
# path) and _prot_how ("is" / "is inside" / "contains") for its message.
_as_path_protected() {
  local real="$1" kind p
  _prot_what="" _prot_path="" _prot_how=""
  for kind in secret control; do
    while IFS= read -r p; do
      if [[ "$real" == "$p" ]]; then
        _prot_how=is
      elif [[ "$real" == "$p"/* ]]; then
        _prot_how="is inside"
      elif [[ "$p" == "$real"/* ]]; then
        _prot_how=contains
      else
        continue
      fi
      _prot_path="$p"
      if [[ "$kind" == secret ]]; then _prot_what="the secret store"; else _prot_what="the sandbox's own control plane"; fi
      return 0
    done < <("_as_${kind}_paths")
  done
  return 1
}

# Refuse user-supplied RO/RW paths that pull the rug out from under the sandbox
# (/, $HOME, or any parent of $HOME) or expose a protected path (above).
_as_check_paths() { # $1 = knob suffix (RO|RW), $2 = colon-separated list
  local knob=$1 raw="${2:-}" p real
  local -a parts=()
  local _prot_what _prot_path _prot_how
  [[ -z "$raw" ]] && return 0
  _as_split parts ':' "$raw"
  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    real="$(readlink -f -- "$p" 2>/dev/null || echo "$p")"
    if [[ "$real" == / || "$real" == "$HOME" || "$HOME" == "$real"/* ]]; then
      _as_msg "refusing AGENT_SANDBOX_$knob='$p' (would expose all of '$real': \$HOME or a parent of it)."
      return 1
    fi
    if _as_path_protected "$real"; then
      _as_msg "refusing AGENT_SANDBOX_$knob='$p' ('$real' $_prot_how $_prot_what '$_prot_path')."
      [[ "$_prot_how" == contains ]] && _as_msg "bind a specific subdirectory instead."
      return 1
    fi
  done
  return 0
}

# User-supplied extra paths: append "$1 path path" to args for each existing
# entry of the colon-separated list $2.
_as_add_paths() {
  local mode="$1" raw="${2:-}" p real
  local _prot_what _prot_path _prot_how
  local -a parts=()
  [[ -z "$raw" ]] && return 0
  _as_split parts ':' "$raw"
  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    if [[ ! -e "$p" ]]; then
      _as_msg "warning — skipping missing path '$p'"
      continue
    fi
    # Bind the RESOLVED target, not the symlink. _as_check_paths validated the
    # resolved path, but binding "$p" lets bwrap re-resolve it at mount time, so a
    # symlink repointed after the check could mount a different, refused target.
    # Resolve here, re-check fail-closed, and bind the real path at the original
    # name: the mounted target is exactly the one just validated.
    real="$(readlink -f -- "$p" 2>/dev/null || echo "$p")"
    if [[ "$real" == / || "$real" == "$HOME" || "$HOME" == "$real"/* ]] || _as_path_protected "$real"; then
      _as_msg "refusing to bind '$p': it resolves to a protected path ('$real')"
      return 1
    fi
    args+=("$mode" "$real" "$p")
  done
  return 0
}

# ----- per-session state: ssh agent socket, --allow include -----
# Per-user base dir, pinned (not $TMPDIR) so the janitor and the proxy addon
# find it deterministically: $AGENT_SANDBOX_SESSION_BASE if set, else
# $XDG_RUNTIME_DIR/agent-sandbox.<uid>, else /tmp/agent-sandbox.<uid>. The
# mitmproxy addon derives the same path (it runs as the same user).
_as_session_base() {
  if [[ -n "${AGENT_SANDBOX_SESSION_BASE:-}" ]]; then
    printf '%s' "$AGENT_SANDBOX_SESSION_BASE"
    return 0
  fi
  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  [[ -d "$rt" && -w "$rt" ]] || rt=/tmp
  printf '%s/agent-sandbox.%s' "$rt" "$(id -u)"
  return 0
}

_as_session_sweep() {
  # Janitor for orphans left by an uncatchable kill (SIGKILL of the engine
  # runs no trap). A session dir is orphaned iff its owner process is gone:
  # we compare the recorded PID *and* its start-time, so a recycled PID (same
  # number, newer start-time) is never mistaken for the live owner. Live
  # sessions are always skipped, so this is safe to run with any number of
  # concurrent sessions on the host.
  local base="$1" d opid ostart now agent
  local _ng=0
  shopt -q nullglob && _ng=1
  shopt -s nullglob
  for d in "$base"/session.*; do
    [[ -d "$d" ]] || continue
    [[ -r "$d/owner.id" ]] || continue # unstamped => mid-setup; leave it
    read -r opid ostart <"$d/owner.id" 2>/dev/null || continue
    if [[ -n "$opid" && -r "/proc/$opid/stat" ]]; then
      now="$(awk '{print $22}' "/proc/$opid/stat" 2>/dev/null || true)"
      [[ -n "$now" && "$now" == "$ostart" ]] && continue # owner alive -> skip
    fi
    # Orphan: drop keys via the socket first (addresses the agent by socket,
    # immune to PID reuse), then guard-kill the recorded agent, then remove.
    [[ -S "$d/agent.sock" ]] && SSH_AUTH_SOCK="$d/agent.sock" ssh-add -D >/dev/null 2>&1 || true
    if [[ -r "$d/agent.pid" ]] && read -r agent <"$d/agent.pid" 2>/dev/null \
      && [[ -n "$agent" && "$(cat "/proc/$agent/comm" 2>/dev/null)" == ssh-agent ]]; then
      kill "$agent" 2>/dev/null || true
    fi
    rm -rf -- "$d" 2>/dev/null || true
  done
  ((_ng)) || shopt -u nullglob
  return 0
}

# Create this session's directory (once), stamped for the janitor and the
# proxy addon, and arm the cleanup trap. Sets _session_dir.
_as_session_begin() {
  [[ -n "${_session_dir:-}" ]] && return 0
  local base
  base="$(_as_session_base)"
  { mkdir -p "$base" 2>/dev/null && chmod 700 "$base"; } \
    || {
      _as_msg "cannot create session base $base"
      return 1
    }
  _as_session_sweep "$base" || true
  _session_dir="$(mktemp -d "$base/session.XXXXXX")" || return 1
  chmod 700 "$_session_dir"
  # Liveness stamp: this subshell's PID (it runs bwrap and holds the trap) plus
  # its start-time (field 22 of /proc/<pid>/stat), written BEFORE anything else
  # lands in the dir so a concurrent sweep never sees a dir of ours unstamped.
  # Capture BASHPID in a plain variable first: inside the $(...) below, $BASHPID
  # would be the command-substitution subshell, whose start-time belongs to the
  # wrong process -- and then every liveness check (the janitor, the proxy's
  # --allow owner test) would compare against a start-time that never matches.
  local _owner_pid=$BASHPID _owner_start
  _owner_start="$(awk '{print $22}' "/proc/$_owner_pid/stat" 2>/dev/null || echo 0)"
  printf '%s %s\n' "$_owner_pid" "$_owner_start" >"$_session_dir/owner.id"
  trap '_as_session_cleanup' EXIT INT TERM HUP
  return 0
}

_as_session_cleanup() {
  # Kill only if the recorded PID is still an ssh-agent -- guards against a
  # PID that was already reaped and recycled to an unrelated process.
  if [[ -n "${_ssh_agent_pid:-}" &&
    "$(cat "/proc/${_ssh_agent_pid}/comm" 2>/dev/null)" == ssh-agent ]]; then
    kill "$_ssh_agent_pid" 2>/dev/null
  fi
  if [[ -n "${_session_dir:-}" ]]; then
    rm -rf -- "$_session_dir"
  fi
  # Empty mount-point files the state binds created on the host (see the
  # state-bind loop). Still empty means nothing wrote through the placeholder
  # itself; EBUSY means another session has it mounted and will remove it.
  local _pf
  for _pf in ${_as_placeholder_files[@]+"${_as_placeholder_files[@]}"}; do
    { [[ -f "$_pf" && ! -s "$_pf" ]] && rm -f -- "$_pf"; } 2>/dev/null || true
  done
  _as_placeholder_files=()
  _ssh_agent_pid="" _session_dir=""
  return 0
}

_as_ssh_pick_key() {
  # $1 = `ssh -G` output. Print the first readable IdentityFile ssh itself
  # would try (config-aware). FIDO *_sk keys need a provider; skip them.
  local cand
  while read -r cand; do
    cand="${cand/#\~/$HOME}"
    [[ "$cand" == *_sk ]] && continue
    [[ -r "$cand" ]] && {
      printf '%s\n' "$cand"
      return 0
    }
  done < <(awk '$1=="identityfile"{print $2}' <<<"$1")
  return 1
}

_as_ssh_setup() {
  # See docs/ssh.md. Runs on the HOST, before the sandbox
  # exists: resolves each --ssh spec through ~/.ssh/config, checks the host
  # key is already trusted, starts a fresh agent, loads the key(s) with
  # destination constraints, and binds only the agent socket (plus the
  # public known_hosts/config files) into the sandbox.
  local kh="$HOME/.ssh/known_hosts" cfg="$HOME/.ssh/config"
  { command -v ssh-agent && command -v ssh-add && command -v ssh-keygen; } >/dev/null \
    || {
      _as_msg "ssh-agent/ssh-add/ssh-keygen not found (install openssh-client)"
      return 1
    }
  [[ -r "$kh" ]] || {
    _as_msg "$kh not readable; --ssh needs pre-trusted host keys there"
    return 1
  }

  declare -A _by_key=() # key file -> space-separated constraints
  local spec g host user port khname key localuser
  localuser="$(id -un)"
  for spec in "${_ssh_hosts[@]}"; do
    [[ "$spec" != -* ]] || {
      _as_msg "bad --ssh host '$spec'"
      return 1
    }
    g="$(ssh -G "$spec" 2>/dev/null)" || {
      _as_msg "cannot resolve '$spec' (ssh -G failed)"
      return 1
    }
    host="$(awk '$1=="hostname"{print $2; exit}' <<<"$g")"
    user="$(awk '$1=="user"    {print $2; exit}' <<<"$g")"
    port="$(awk '$1=="port"    {print $2; exit}' <<<"$g")"
    # Pin the user only when asked for: user@ in the spec, or set by config.
    [[ "$spec" != *@* && "$user" == "$localuser" ]] && user=""
    khname="$host"
    [[ "$port" != 22 ]] && khname="[$host]:$port"
    if ! ssh-keygen -F "$khname" -f "$kh" >/dev/null 2>&1; then
      _as_msg "no trusted host key for '$khname' (--ssh $spec) in $kh."
      echo "               Connect once from a HOST shell to record it:   ssh $spec" >&2
      return 1
    fi
    key="$_ssh_key"
    [[ -n "$key" ]] || key="$(_as_ssh_pick_key "$g")" \
      || {
        _as_msg "no readable private key for '$spec'; pass --ssh-key PATH"
        return 1
      }
    _by_key[$key]+=" ${user:+$user@}$khname"
    _ssh_endpoints+=("$host $port") # for strict mode: firewall pinholes + /etc/hosts
  done
  if ((_ssh_unrestricted)); then
    key="$_ssh_key"
    [[ -n "$key" ]] || key="$(_as_ssh_pick_key "$(ssh -G agent-sandbox.invalid 2>/dev/null)")" \
      || {
        _as_msg "no readable private key found under ~/.ssh; pass --ssh-key PATH"
        return 1
      }
    _by_key[$key]=""
  fi

  _as_session_begin || return 1

  # A fresh agent for this session only. Its socket is the one secret-
  # bearing thing bound in; the key files themselves never are.
  local sock="$_session_dir/agent.sock"
  # 9>&-: the agent outlives this process, and fd 9 is the keeper lock.
  eval "$(ssh-agent -s -a "$sock" 9>&-)" >/dev/null \
    || {
      _as_msg "ssh-agent failed to start"
      return 1
    }
  _ssh_agent_pid="$SSH_AGENT_PID"
  printf '%s\n' "$_ssh_agent_pid" >"$_session_dir/agent.pid"

  local c
  local -a add
  for key in "${!_by_key[@]}"; do
    add=()
    [[ -n "$_ssh_timeout" ]] && add+=(-t "$_ssh_timeout")
    if [[ -n "${_by_key[$key]}" ]]; then
      for c in ${_by_key[$key]}; do add+=(-h "$c"); done # no spaces in constraints
      add+=(-H "$kh")
      _as_info "session agent: $key constrained to:${_by_key[$key]}${_ssh_timeout:+  (lifetime $_ssh_timeout)}"
    else
      _as_msg "session agent: $key UNRESTRICTED${_ssh_timeout:+  (lifetime $_ssh_timeout)}"
    fi
    SSH_AUTH_SOCK="$sock" ssh-add "${add[@]}" "$key" \
      || {
        _as_msg "ssh-add failed for $key"
        return 1
      }
  done

  args+=(
    --bind "$sock" "$sock"
    --setenv SSH_AUTH_SOCK "$sock"
    --ro-bind "$kh" "$kh"
  )
  [[ -r "$cfg" ]] && args+=(--ro-bind "$cfg" "$cfg")
  # Strict mode once ran the agent as uid 0 (pasta maps the one uid to root), and ssh
  # then resolved ~ through getpwuid(0) to root's home rather than $HOME, missing the
  # binds above. Since #63 the sandbox runs as your uid in every network mode (measured
  # by tests/live/ssh.bats), so this copy at uid 0's home is a fallback only: harmless,
  # and kept for a strict launch that ever maps root again.
  local _root_home
  _root_home="$(getent passwd 0 2>/dev/null | cut -d: -f6)"
  if [[ -n "$_root_home" && "$_root_home" != "$HOME" ]]; then
    args+=(--ro-bind "$kh" "$_root_home/.ssh/known_hosts")
    [[ -r "$cfg" ]] && args+=(--ro-bind "$cfg" "$_root_home/.ssh/config")
  fi
  return 0
}

# --allow HOST: write this session's extra hosts where the proxy addon reads
# them, and mint a per-session token so the addon can tell THIS session's --allow
# from another's. The token goes in the session dir (private, never bound into a
# sandbox) and, as userinfo, into the sandbox's proxy URL (_proxy_auth, used by
# the network arms); the sandbox sends it in Proxy-Authorization, and the addon
# grants the global allowlist plus only the matching session's --allow. So one
# session's --allow is not reachable from another. Nothing but the token value
# (which grants only this session's own --allow) is exposed inside the sandbox.
_as_allow_setup() {
  _as_session_begin || return 1
  local _token
  _token="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  if [[ -n "$_token" ]]; then
    (
      umask 077
      printf '%s\n' "$_token" >"$_session_dir/proxy.token"
    )
    # Userinfo is TOKEN:x, not TOKEN, on purpose: with an empty proxy password
    # (TOKEN@host) Node's HTTP stack hangs instead of connecting, so the agent
    # itself could not reach the API whenever --allow was in effect. The addon
    # reads the token from the username half and ignores the password (and strips
    # Proxy-Authorization before going upstream), so the value 'x' never matters.
    _proxy_auth="$_token:x"
  else
    _as_msg "warning — could not mint a session proxy token; --allow will not be isolated from other sessions"
  fi
  {
    printf '# agent-sandbox --allow for %s. Honoured by the proxy addon only while\n' "$(basename -- "$_session_dir")"
    printf '# the process recorded in owner.id is alive. One host per line; a leading\n'
    printf '# dot matches the domain and its subdomains.\n'
    printf '%s\n' "${_allow_hosts[@]}"
  } >"$_session_dir/allow.txt"
  _as_info "session allowlist: ${_allow_hosts[*]} (this session only, on top of the global allowlist)"
  return 0
}

# ----- state isolation: cross-session leaks in the agent's own state dir -----
# Scoping ~/.claude/projects (profile_memory_scope) hides other projects'
# transcripts, but an agent's state directory holds far more that is keyed by
# session rather than by project: verbatim file snapshots, prompt history,
# pasted text, plans, per-session environments. None of it is asked for by the
# user and all of it was readable, so isolation here is unconditional -- there
# is no per-item knob, only the one control the whole feature has.
#
# The profile declares WHAT (it knows its agent's layout); the engine provides
# the mechanism. Each declaration is one line in profile_isolate_spec:
#
#   tmpfs<TAB>DIR              empty inside, discarded at exit
#
# There used to be two more, `copyout` and `append`, which staged a path empty
# and merged the session's new entries back into the host's copy at exit. Every
# path that used them is a channel now, each the role's own (#120), and nothing
# is merged back into the native state after the fact: a `copyout` or `append`
# line is refused as unknown.
_as_iso_slug() {
  local s="${1//\//_}"
  s="${s#_}"
  # ONE FILE NAME, SO AT MOST 255 BYTES. Measured: a project whose own slug is
  # already 200 characters puts its conversations directory at a path whose
  # flattened name is longer than that, and the store could not be created. Past
  # 200 characters, the same scheme as _as_path_slug: truncated, plus a hash of the
  # whole path. Every shorter name -- every store there is -- is unchanged.
  if ((${#s} > 200)); then
    s="${s:0:200}-$(_as_sha256_str "$1" | cut -c1-16)"
  fi
  printf '%s' "$s"
}

# Add the declared paths' binds to args. Reads profile_isolate_spec; needs $args
# from the caller.
_as_iso_prepare() {
  ((${#profile_isolate_spec[@]})) || return 0
  local line mode path
  for line in "${profile_isolate_spec[@]}"; do
    IFS=$'\t' read -r mode path _ <<<"$line"
    [[ -n "${path:-}" ]] || continue
    case "$mode" in
      tmpfs)
        args+=(--tmpfs "$path")
        ;;
      *) _as_msg "isolate: unknown mode '$mode' for $path; ignoring" ;;
    esac
  done
  return 0
}

# ----- connections: what of a source reaches this sandbox, per channel -------
# A sandbox is an installation of the agent; a CONNECTION opens one CHANNEL
# between it and a SOURCE, under a MODE from the scale
#
#   own < seed-only < copy < copy-on-write < read-only < read-write
#
# and lower is more isolated. The scale says what the sandbox HAS at a path in
# relation to yours, which is why the bottom rung names what it has instead of
# a relation. THE ORDER IS HOW MUCH OF YOUR FILES REACH THE SANDBOX, not what
# the sandbox may do: it can write under `copy-on-write` but not under
# `read-only`, and `read-only` is still the higher rung, because it hands over
# the real file where `copy-on-write` gives only a shadow of one.
#
# See docs/connections.md. The profile says WHERE each channel lives
# (profile_channels, its contract item 3); the engine owns the modes, so nothing
# here is agent-specific.
#
#   own        nothing of the source reaches the sandbox and nothing of the
#              sandbox reaches the source; what it creates there is its own and
#              PERSISTS, which is why the slot is a directory under the engine's
#              state and not a tmpfs -- a sandbox that forgot everything at exit
#              would be a different thing, and a less useful one
#   copy       seeded from the source and refreshed at each launch for anything
#              the sandbox has not touched; never written back
#   copy-on-write
#              reads fall through to the source until the sandbox writes, and
#              the write goes to a private layer that shadows it from then on
#   read-only  the source's files, live, and no writing
#   read-write one read-write bind, both ways, no delay
#
# THE NAMES CHANGED IN 0.3 (none, cow, ro, live) AND THE OLD ONES ARE REFUSED,
# not aliased -- see _as_mode_renamed for why `none` in particular cannot be
# carried forward.

# _as_path_slug PATH -- a directory name for PATH, for the engine's own state.
#
# NOT the same thing as the claude profile's project slug, which exists to
# reproduce Claude Code's own `projects/<slug>` naming and is pinned against
# recorded output from the agent. This one names a directory only the engine
# reads, so it is free to hash long paths its own way. They agree for paths up
# to the truncation point and may differ past it; whoever later moves the
# per-project config copy under a sandbox directory reconciles the two, and a
# rename at that point is fine because nothing outside the engine reads either.
_as_path_slug() {
  local conv="${1//[^A-Za-z0-9-]/-}"
  if ((${#conv} <= 200)); then
    printf '%s' "$conv"
    return 0
  fi
  printf '%s-%s' "${conv:0:200}" "$(_as_sha256_str "$1" | cut -c1-16)"
}

# _as_project_dir -- the PROJECT this launch belongs to: the directory it runs in.
# Anything keyed by project asks this rather than reading $cwd itself, so there is
# one place that says what the key is. (It was once not always $cwd: a wrapped
# background worker ran from the daemon's directory. Background sessions now run
# inside their role's launch, #123.)
# shellcheck disable=SC2154
_as_project_dir() {
  printf '%s' "${cwd:-$PWD}"
}

# _as_sandbox_dir -- this sandbox's own directory under the engine's state dir:
#
#   <state>/<profile>/<project slug>/<role>/
#
# A sandbox is keyed by PROJECT and ROLE. A project slug is an absolute path
# with every character outside [A-Za-z0-9-] replaced by a dash, so it always
# begins with a dash; a named sandbox shared by several projects, if that
# arrives, takes the same position, which is why a name may not begin with one.
# Nothing else about the key changes. The project comes from _as_project_dir,
# never from $cwd directly -- see there for what a background worker does to a
# key that reads $cwd. Uses the engine's $profile and $_role by dynamic scope.
# shellcheck disable=SC2154
_as_sandbox_dir() {
  printf '%s/%s/%s/%s' "$(_as_state_dir)" "$profile" \
    "$(_as_path_slug "$(_as_project_dir)")" "${_role:-default}"
}

# _as_role_resolve -- set $_role: --role > AGENT_SANDBOX_ROLE > [sandbox] role > default.
#
# A role is a named, persistent instance of the project: the sandbox key's second half,
# so its name is a path segment and part of `sandbox:<project>/<role>`. Hence the rules:
# a letter or digit first, then letters, digits, `.`, `_`, `-`; nothing that is a path
# separator, the source grammar's `@`, or a glob character; at most 200 characters.
#
# A NAME MATCHING NO ROLE SECTION IS REFUSED, BUT ONLY WHERE THERE ARE ROLE SECTIONS. A
# dot-file that suffixes sections defines its roles, and a name none of them matches is
# most likely a typo of one -- which would otherwise run quietly with the unsuffixed
# policy alone. A dot-file with no suffixed section has one policy, and any name is that
# policy as a separate instance, which is also what a throwaway role needs.
# Uses the engine's _role_flag, _role_flag_set, _df_role, _df_role_globs by dynamic scope.
# shellcheck disable=SC2154
_as_role_resolve() {
  local name="default" src="default" g
  if ((_role_flag_set)); then
    name="$_role_flag" src="--role"
  elif [[ -n "${AGENT_SANDBOX_ROLE:-}" ]]; then
    name="$AGENT_SANDBOX_ROLE" src="AGENT_SANDBOX_ROLE"
  elif [[ -n "${_df_role:-}" ]]; then
    name="$_df_role" src=".agent-sandbox [sandbox] role"
  fi
  if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || ((${#name} > 200)); then
    _as_msg "role ($src): '$name' is not a role name -- a letter or digit, then letters, digits, '.', '_' or '-', at most 200 characters"
    return 1
  fi
  if ((${#_df_role_globs[@]})); then
    local hit=0
    for g in "${_df_role_globs[@]}"; do
      # shellcheck disable=SC2053 # the glob is the pattern
      [[ "$name" == $g ]] && hit=1
    done
    ((hit)) || {
      _as_msg "role ($src): role '$name' matches no role section of .agent-sandbox (it has: $(printf '%s\n' "${_df_role_globs[@]}" | sort -u | paste -sd' ')). Refusing rather than running it with the unsuffixed policy alone; add [connect:*] if every name should be accepted."
      return 1
    }
  fi
  _role="$name"
  [[ "$_role" == default ]] || _as_info "role: $_role ($src)"
  return 0
}

# ----- presets: one position for every channel at once -----------------------
# `isolated` is the two mandatory connections and nothing else; `inherit` is
# the fidelity principle stated as connections -- a sandbox that behaves like
# a native install whose configuration is the user's, read live, with its own
# writes kept to itself; `shared` is the engine before 0.2.
#
# A PRESET ONLY MOVES THE CHANNELS THE ENGINE MANAGES AS CONNECTIONS, which is
# the plain-path ones the profile declares. identity, project, tools and memory
# appear in the design's table too, but each still has machinery of its own (the
# credential bind, the working tree, memory scoping) and keeps its own controls
# until it is folded in. A preset that silently claimed to set them would be the more dangerous kind
# of wrong: the user would believe a channel was positioned and it would not be.
_as_preset_mode() {
  case "$1" in
    isolated) printf own ;;
    inherit) printf copy-on-write ;;
    shared | native) printf read-write ;;
    *) printf read-write ;;
  esac
}

# _as_mode_renamed OLD -- the 0.3 spelling of a mode name that used to be valid.
#
# The old names are REFUSED rather than accepted as aliases, and `none` is the
# reason there is no alias table at all: it was the most-closed mode and is
# becoming the preset that means no sandbox whatsoever, so honouring it here
# would make one word mean opposite ends of one model -- someone writing it for
# maximum isolation would get none of it. Once `none` cannot be carried forward,
# carrying the other three would leave a single special case nobody remembers,
# so all five move together and every one of them says what to write instead.
_as_mode_renamed() {
  case "$1" in
    none) printf own ;;
    cow) printf copy-on-write ;;
    ro) printf read-only ;;
    live) printf read-write ;;
    *) printf '%s' "$1" ;;
  esac
}

# _as_preset_renamed OLD -- likewise for the two presets that were renamed.
_as_preset_renamed() {
  case "$1" in
    independent) printf isolated ;;
    default) printf inherit ;;
    *) printf '%s' "$1" ;;
  esac
}

# ----- `native`: parity with no sandbox at all, for testing ------------------
# `shared` is the widest position that is USEFUL. Native Claude Code shares a
# good deal more that nobody chose to share -- the config file whole, the daemon
# control directory, session environments, shell snapshots, the paste cache,
# prompt history, plans, file history -- and the leak study measured what each of
# those carries. `native` is the preset that reaches parity anyway, and its
# contract is what makes it worth having:
#
#   --preset native must behave IDENTICALLY to --sandbox none, while going
#   through every sandbox mechanism. A difference between the two is a bug here.
#
# So it is a differential oracle: it catches the sandbox DISTORTING the agent
# rather than failing outright, which nothing else here can. It also bisects --
# something that breaks under `native` but works under `--sandbox none` is broken
# by a mechanism (binds, seccomp, the proxy) and not by state isolation, because
# `native` holds state at "hide nothing". And it makes the scale a workflow:
# start here and close channels, or start at `isolated` and open them.
#
# It means parity of STATE. The egress proxy, the syscall filter and the
# working-tree bind still apply, exactly as `[net] mode = open` means no
# allowlist rather than no sandbox.
#
# FLAG ONLY. Every other knob takes three forms, and this one takes one: it
# reopens every channel the study measured, so a shell profile or a repository's
# dot-file must not be able to do it. You type it, per launch, or it does not
# happen. That is a stronger gate than the trust review and a simpler one to
# reason about.
_as_preset_is_native() { [[ "${_preset:-}" == native ]]; }

# _as_connect_parse SPEC WHERE -- record one `channel = mode [source] [scope]`.
#
# Refuses rather than warns, on every kind of bad input. A typo in a channel
# name that left it quietly at `read-write` would be the worst outcome this can
# produce: the user reads their dot-file, believes a channel is closed, and it
# is wide open. Unknown mode, unknown source and unimplemented mode are refused
# for the same reason.
_as_connect_parse() {
  local spec="$1" where="$2" ch rest mode src
  spec="${spec#"${spec%%[![:space:]]*}"}"
  spec="${spec%"${spec##*[![:space:]]}"}"
  [[ -z "$spec" ]] && return 0
  [[ "$spec" == *=* ]] || {
    _as_msg "connect ($where): expected 'channel = mode [source] [scope]', got '$spec'"
    return 1
  }
  ch="${spec%%=*}"
  # A key containing `/` is a PATH declaration, and a path may contain spaces, so
  # only its ends are trimmed. A channel name has none to lose.
  if [[ "$ch" == */* ]]; then
    ch="${ch#"${ch%%[![:space:]]*}"}"
    ch="${ch%"${ch##*[![:space:]]}"}"
  else
    ch="${ch//[[:space:]]/}"
  fi
  rest="${spec#*=}"
  # After the mode come up to two optional tokens, in either order: a SOURCE and a
  # SCOPE. They are told apart lexically -- every scope name ends in `-scoped`, no
  # source does -- so neither needs a fixed position and neither needs a prefix.
  local t2 t3 extra scope=""
  read -r mode t2 t3 extra <<<"$rest"
  [[ -z "$extra" ]] || {
    _as_msg "connect ($where): trailing '$extra' in '$spec'; a spec is 'channel = mode [source] [scope]' and nothing more"
    return 1
  }
  local tok
  src=""
  for tok in "$t2" "$t3"; do
    [[ -z "$tok" ]] && continue
    case "$tok" in
      *-scoped)
        [[ -z "$scope" ]] || {
          _as_msg "connect ($where): two scopes in '$spec' ('$scope' and '$tok'); a spec carries one"
          return 1
        }
        scope="$tok"
        ;;
      *)
        [[ -z "$src" ]] || {
          _as_msg "connect ($where): two sources in '$spec' ('$src' and '$tok'); a spec carries one"
          return 1
        }
        src="$tok"
        ;;
    esac
  done
  local src_given="$src"
  src="${src:-native}"
  # No scope written means the role's own storage, which needs no name (#125).

  local known=0 line
  [[ "$ch" == */* ]] && known=1 # a path; checked by _as_connect_parse_path below
  for line in ${profile_channels[@]+"${profile_channels[@]}"}; do
    [[ "${line%%$'\t'*}" == "$ch" ]] && {
      known=1
      break
    }
  done
  ((known)) || {
    _as_msg "connect ($where): profile '$profile' has no channel '$ch'. It carries: $(_as_connect_channels)"
    return 1
  }
  case "$mode" in
    own | seed-only | copy | copy-on-write | read-only | read-write) ;;
    none | cow | ro | live)
      _as_msg "connect ($where): mode '$mode' was renamed in 0.3 -- write '$(_as_mode_renamed "$mode")' (own|seed-only|copy|copy-on-write|read-only|read-write). Refusing rather than accepting the old name: see _as_mode_renamed for why 'none' cannot be an alias."
      return 1
      ;;
    _never_)
      # THE WORDING BELOW IS A CONTRACT, not just a message. The connections
      # study probes each mode by asking for it and reading the refusal, so that
      # a mode the engine does not implement records `not-implemented` while a
      # mode it implements WRONGLY still runs its cells and fails. Rewording
      # this makes an unimplemented mode look broken instead -- the safe
      # direction, but not one to take by accident. See
      # probes/connections/lib.sh, conn_mode_supported.
      _as_msg "connect: mode '$mode' is not implemented in this engine ($where asked for '$ch'). Refusing rather than serving a different mode under that name."
      return 1
      ;;
    *)
      _as_msg "connect ($where): unknown mode '$mode' for '$ch' (own|seed-only|copy|copy-on-write|read-only|read-write)"
      return 1
      ;;
  esac
  if [[ "$ch" == */* ]]; then
    # The source of a path is the same path outside, and nothing else yet: the
    # explicit form, outside:<path>, is a follow-up. `native` names the agent's
    # own install, which a path is not part of.
    [[ -z "$src_given" ]] || {
      _as_msg "connect ($where): '$ch' is a path, and a path declaration takes no source yet -- its source is the same path outside. Drop '$src_given'."
      return 1
    }
  else
    [[ "$src" == native ]] || {
      _as_msg "connect ($where): source '$src' is not supported yet; only 'native' is"
      return 1
    }
  fi
  # ---- the scope: which storage this channel's sandbox side uses ----
  #
  # THE READ-WRITE RULE IS PERMANENT, not a statement about what is built yet. At
  # `read-write` the sandbox writes the source itself, so there is no sandbox-side
  # storage left for a scope to apply to; asking for one means the spec does not mean
  # what its author thinks. Checked before implementation status, because it is a fact
  # about meaning rather than about this release.
  if [[ "$mode" == read-write && -n "$scope" ]]; then
    _as_msg "connect ($where): '$ch = read-write $scope' does not mean anything -- at read-write the sandbox writes the source itself, so there is no sandbox-side storage for a scope to apply to. Drop the scope, or pick a mode that keeps the sandbox's writes its own."
    return 1
  fi
  # A store belongs to the role, so a scope can only name a SHORTER lifetime: one
  # run of the role's launch, or one process in it (#125). The three names the
  # first draft of this axis had are refused with what to write instead, because
  # each now means something that is not a scope.
  case "$scope" in
    "") ;;         # the role: across runs, until reset or deleted
    run-scoped) ;; # one run of the role's launch (#105): see _as_run_scoped_clear
    join-scoped)
      # One join (#147): a store per joined command, in a mount namespace of the join's
      # own. `own` is what it is for; `read-only` writes nothing, so it is the plain
      # bind. A seeded store per join is not built yet.
      case "$mode" in
        own | read-only) ;;
        *)
          _as_msg "connect ($where): '$mode join-scoped' is not implemented in this engine (asked for '$ch'); a join-scoped store is built for 'own' and 'read-only', not yet for a mode that seeds it. Refusing rather than serving a store that outlives the join."
          return 1
          ;;
      esac
      ;;
    process-scoped)
      _as_msg "connect ($where): scope 'process-scoped' was renamed: write 'join-scoped' -- a store for one join, which a joined command and everything it starts share (#147)."
      return 1
      ;;
    sandbox-scoped)
      _as_msg "connect ($where): scope 'sandbox-scoped' was withdrawn: storage belongs to the role by default, so write no scope for it."
      return 1
      ;;
    project-scoped)
      _as_msg "connect ($where): scope 'project-scoped' was withdrawn: storage shared across roles is a source, sandbox:<project>/<role> at read-write, not a scope."
      return 1
      ;;
    session-scoped)
      _as_msg "connect ($where): scope 'session-scoped' was withdrawn: storage of its own per conversation is a role of its own -- launch it with --role NAME."
      return 1
      ;;
    *)
      _as_msg "connect ($where): unknown scope '$scope' for '$ch' (run-scoped|join-scoped; nothing written means the role)."
      return 1
      ;;
  esac
  if [[ "$ch" == */* ]]; then
    _as_connect_parse_path "$ch" "$mode" "$where" || return 1
    ch="$_path_key"
  fi
  _connect_mode["$ch"]="$mode"
  _connect_where["$ch"]="$where"
  _connect_scope["$ch"]="$scope"
  return 0
}

# _as_connect_parse_path KEY MODE WHERE -- validate a path declaration and record
# it. Sets $_path_key to the path it resolves to, which is what the connection
# maps are keyed by: a channel name never contains `/` and a resolved path always
# does, so the two cannot collide.
#
# THE KEY IS ALWAYS A PATH INSIDE THE SANDBOX. A relative one is relative to the
# project, whichever of the three forms it came from; `~` is $HOME. With no source,
# the source is the same path outside -- so `/data = read-only` is what `[ro] /data`
# already does, and `~/notes/ = own` is sandbox-only storage at ~/notes.
#
# EVERY MODE IS CHECKED ALIKE, `own` included, although `own` exposes nothing: one
# rule is easier to state and to trust than one per mode, and loosening it later
# breaks nobody while tightening it would. The rule is `[ro]`/`[rw]`'s --
# not /, $HOME or a parent of it, nothing that is, is inside or contains a secret
# store or the control plane -- plus one of its own: not the project or a parent
# of it. Declarations are bound after the project, so one of those would cover it:
# `~/git/ = own` hides the project, `~/git = read-only` makes it read-only.
#
# Both the key and what it resolves to are checked, since the key is where the
# bind lands and the resolved path is what it shows.
_as_connect_parse_path() {
  local key="$1" mode="$2" where="$3" p dir=0 real proj other
  local _prot_what _prot_path _prot_how
  [[ "$key" == */ ]] && dir=1
  p="$key"
  case "$p" in
    \~ | \~/*) p="$HOME${p#\~}" ;;
    \~*)
      _as_msg "connect ($where): '$key': only '~' and '~/' are expanded, not another user's home"
      return 1
      ;;
    /*) ;;
    *) p="$(_as_project_dir)/$p" ;;
  esac
  # Lexically, without resolving symlinks: the key is a place in the sandbox's
  # tree, and ./a/../b means b whatever a is.
  p="$(realpath -m -s -- "$p")"
  real="$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")"
  proj="$(_as_project_dir)"
  local c
  for c in "$p" "$real"; do
    if [[ "$c" == / || "$c" == "$HOME" || "$HOME" == "$c"/* ]]; then
      _as_msg "connect ($where): refusing '$key' (it would cover all of '$c': / , \$HOME or a parent of it)."
      return 1
    fi
    if [[ "$c" == "$proj" || "$proj" == "$c"/* ]]; then
      _as_msg "connect ($where): refusing '$key' ('$c' is the project or a parent of it, and a declaration over it would cover the project). Declare a directory inside it instead."
      return 1
    fi
    if _as_path_protected "$c"; then
      _as_msg "connect ($where): refusing '$key' ('$c' $_prot_how $_prot_what '$_prot_path'), in every mode."
      return 1
    fi
  done
  # Two declarations nested inside each other would depend on bind order to mean
  # anything, and which one wins is not something a reader of the dot-file should
  # have to work out. The same path again is an override, as for a channel.
  for other in ${_connect_paths[@]+"${_connect_paths[@]}"}; do
    [[ "$other" == "$p" ]] && continue
    if [[ "$p" == "$other"/* || "$other" == "$p"/* ]]; then
      _as_msg "connect ($where): '$key' and '${_connect_key[$other]}' are declared one inside the other; declare one of them."
      return 1
    fi
  done
  [[ -n "${_connect_key[$p]:-}" ]] || _connect_paths+=("$p")
  _connect_key["$p"]="$key"
  _connect_isdir["$p"]="$dir"
  _path_key="$p"
  return 0
}

# The channels this profile carries, for a message.
_as_connect_channels() {
  local line out=""
  for line in ${profile_channels[@]+"${profile_channels[@]}"}; do
    out="${out:+$out, }${line%%$'\t'*}"
  done
  printf '%s' "${out:-none}"
}

# ----- what a profile may say about one channel path ----------------------------
# Four small hooks, each an array of TAB-separated lines, all optional. The first
# channel that needed them is Claude Code's config file (#119): its source is
# ~/.claude.json, its path inside is ~/.claude/.claude.json, its seed must carry this
# project's entry only, its `own` must still parse as JSON, and under `inherit` it is
# seed-only rather than copy-on-write. None of that is about the config file as such,
# so none of it is written for it: the engine knows paths, the profile knows the agent.
#
#   profile_channel_sources  "DEST<TAB>SOURCE"      the path outside, when it is not DEST
#   profile_channel_filters  "CHANNEL<TAB>FUNCTION" FUNCTION SOURCE VIEW writes what the
#                            or "DEST<TAB>FUNCTION" seeding modes read instead of SOURCE;
#                                                   a DEST entry is for that path alone
#   profile_channel_empty    "CHANNEL<TAB>TEXT"     what a new `own` file store holds
#   profile_channel_presets  "CHANNEL<TAB>PRESET=MODE ..."  this channel's rung under a
#                                                   preset, where it is not the preset's
#
# A path with a SOURCE of its own is a RELOCATION, and under `native` -- parity with no
# sandbox -- nothing is relocated, so such a path is not bound at all there.
_as_channel_source() { # DEST -> the path outside it follows
  local line
  # shellcheck disable=SC2154 # declared by the profile, when at all
  for line in ${profile_channel_sources[@]+"${profile_channel_sources[@]}"}; do
    [[ "${line%%$'\t'*}" == "$1" ]] && {
      printf '%s' "${line#*$'\t'}"
      return 0
    }
  done
  printf '%s' "$1"
}
_as_channel_hook() { # ARRAY-NAME CHANNEL -> the channel's value in that hook, if any
  local -n _hook="$1"
  local line
  for line in ${_hook[@]+"${_hook[@]}"}; do
    [[ "${line%%$'\t'*}" == "$2" ]] && {
      printf '%s' "${line#*$'\t'}"
      return 0
    }
  done
  return 1
}
# _as_channel_preset_mode CHANNEL PRESET -- the channel's rung under PRESET.
_as_channel_preset_mode() {
  local spec tok
  if spec="$(_as_channel_hook profile_channel_presets "$1")"; then
    for tok in $spec; do
      [[ "${tok%%=*}" == "$2" ]] && {
        printf '%s' "${tok#*=}"
        return 0
      }
    done
  fi
  _as_preset_mode "$2"
}
# _as_connect_view CHANNEL SOURCE DEST -- set $_connect_from to the path the seeding modes
# read for SOURCE: SOURCE itself, or the profile's filtered view of it, written into
# this launch's directory.
#
# SETS A VARIABLE, NEVER PRINTS. Measured the hard way: called as $(...), the launch
# directory it makes on a first use is the subshell's, the subshell's exit trap
# removes it with the view inside, and the store was seeded from nothing.
_as_connect_view() {
  local ch="$1" src="$2" dest="${3:-}" fn
  _connect_from="$src"
  fn="$(_as_channel_hook profile_channel_filters "$dest")" \
    || fn="$(_as_channel_hook profile_channel_filters "$ch")" || return 0
  _as_session_begin || return 1
  _connect_from="$_session_dir/connect/$ch/view-$(_as_iso_slug "$src")"
  mkdir -p -- "$(dirname -- "$_connect_from")" || return 1
  rm -rf -- "$_connect_from" 2>/dev/null
  "$fn" "$src" "$_connect_from"
}

# _as_connect_seed SOURCE STORE KIND -- make a `seed-only` store once: a copy of
# SOURCE as it is now, or an empty one where SOURCE has nothing. Never touched
# again once it exists -- that is the whole of `seed-only`: no refresh, so no
# conflict and no warning, and the role's own writes are simply its own (#120).
# Copied beside the store and renamed into place, so an interrupted first launch
# leaves no half-seeded store that a later one would then keep for ever.
_as_connect_seed() {
  local src="$1" store="$2" kind="$3" tmp
  [[ -e "$store" ]] && return 0
  mkdir -p -- "$(dirname -- "$store")" || return 1
  tmp="$store.seeding.$$"
  rm -rf -- "$tmp" 2>/dev/null
  if [[ -e "$src" ]]; then
    cp -a -- "$src" "$tmp" || {
      rm -rf -- "$tmp" 2>/dev/null
      _as_msg "connect: could not seed '$store' from '$src'"
      return 1
    }
  elif [[ "$kind" == dir ]]; then
    mkdir -p -- "$tmp" || return 1
  else
    : >"$tmp" || return 1
  fi
  mv -T -- "$tmp" "$store"
}

# _as_connect_apply -- add this sandbox's connection binds to $args.
#
# Called AFTER the profile's own visibility binds, so a connection layers on top
# of memory scoping rather than under it, and BEFORE the isolate spec, because
# the per-session scratch must win over everything: a `read-write` channel must
# still not hand over another session's paste cache.
_as_connect_apply() {
  ((${#profile_channels[@]})) || return 0
  ((${#_connect_mode[@]})) || return 0
  local line ch mode entry kind path slot base empty manifest upper work seen src _connect_from
  local -a _cow_fellback=()
  local -a fields=()
  local rolebase
  rolebase="$(_as_sandbox_dir)"
  for line in "${profile_channels[@]}"; do
    IFS=$'\t' read -r -a fields <<<"$line"
    ch="${fields[0]}"
    mode="${_connect_mode[$ch]:-live}"
    # A run-scoped channel's stores live apart, under @run, which lasts one run of the
    # role's launch (_as_run_scoped_clear); every mode then does what it always does
    # there -- `own` starts empty, `copy` seeds, `copy-on-write` gets a fresh upper.
    base="$rolebase"
    [[ "${_connect_scope[$ch]:-}" == run-scoped ]] && base="$rolebase/@run"
    for entry in "${fields[@]:1}"; do
      kind="${entry%%:*}"
      path="${entry#*:}"
      [[ -n "$path" ]] || continue
      src="$(_as_channel_source "$path")"
      # A relocated path is not bound under `native`: see _as_channel_source.
      [[ "$src" != "$path" ]] && _as_preset_is_native && continue
      if [[ "$mode" == read-write ]]; then
        # The source itself, both ways: already there when it IS the path, which the
        # state bind covers; a relocated one is bound across.
        if [[ "$src" != "$path" && -e "$src" ]]; then
          [[ "$kind" == file ]] && _as_connect_placeholder "$path"
          args+=(--bind "$src" "$path")
        fi
        continue
      fi
      if [[ "$mode" == own && "${_connect_scope[$ch]:-}" == join-scoped ]]; then
        _as_join_scoped_bind "$kind" "$path" || return 1
        continue
      fi
      case "$mode" in
        own)
          # A private slot that OUTLIVES the session, per sandbox and channel.
          slot="$base/$ch/own/$(_as_iso_slug "$path")"
          if [[ "$kind" == dir ]]; then
            mkdir -p -- "$slot" || return 1
          else
            mkdir -p -- "$(dirname -- "$slot")" || return 1
            [[ -e "$slot" ]] || _as_channel_hook profile_channel_empty "$ch" >"$slot" || : >"$slot" || return 1
            _as_connect_placeholder "$path"
          fi
          args+=(--bind "$slot" "$path")
          ;;
        copy-on-write)
          # Copy-on-write: the source reads THROUGH until the sandbox writes, and
          # the write lands in a private upper layer that shadows it from then on.
          # No refresh step at all, which is what makes it the better default --
          # nothing to run and nothing to go stale.
          #
          # THREE REASONS IT BECOMES `copy` INSTEAD, and only the first two are
          # about this host:
          #   - the knob says off
          #   - bubblewrap is older than 0.11 and cannot mount an overlay
          #   - THE PATH NAMES A FILE. overlayfs mounts a directory and cannot
          #     stack on a single file, so this one is permanent and no newer
          #     bubblewrap fixes it.
          # Across launches `copy` and `copy-on-write` are indistinguishable; they
          # differ only WITHIN a session, where an overlay reads through live.
          if [[ "$kind" == file ]] || [[ "$_overlay_mode" == off ]] || ! _as_overlay_ok; then
            [[ "$kind" == file ]] || _cow_fellback+=("$ch")
            slot="$base/$ch/copy/$(_as_iso_slug "$path")"
            manifest="$base/$ch/base/$(_as_iso_slug "$path").json"
            mkdir -p -- "$(dirname -- "$slot")" "$(dirname -- "$manifest")" || return 1
            _as_connect_view "$ch" "$src" "$path" || return 1
            _as_connect_sync sync "$ch" "$kind" "$_connect_from" "$slot" "$manifest" || return 1
            if [[ ! -e "$slot" ]]; then
              if [[ "$kind" == dir ]]; then mkdir -p -- "$slot"; else : >"$slot"; fi || return 1
            fi
            [[ "$kind" == file ]] && _as_connect_placeholder "$path"
            args+=(--bind "$slot" "$path")
            continue
          fi
          upper="$base/$ch/upper/$(_as_iso_slug "$path")"
          work="$base/$ch/work/$(_as_iso_slug "$path")"
          seen="$base/$ch/seen/$(_as_iso_slug "$path").json"
          mkdir -p -- "$upper" "$work" "$(dirname -- "$seen")" || return 1
          # THE LOWER IS ALWAYS THE SOURCE ITSELF, created if it is missing. The
          # lower is fixed when the overlay is mounted and the keeper outlives any
          # one app, so an empty stand-in would keep a directory the user creates
          # afterwards invisible for as long as the role runs -- the study caught
          # that once, with the holder, whose lifetime this is. An overlay can only
          # track the source if the source IS the lower. What that costs is one
          # empty directory in a tree the engine already binds read-write and lets
          # bwrap create mount points in; it is not something the SANDBOX wrote,
          # which is the promise `copy-on-write` makes.
          mkdir -p -- "$path" || return 1
          # What the sandbox is shadowing, and whether the source has moved under
          # it. The one thing `copy-on-write` hides, reported before the mount so the user
          # reads it whatever the session then does.
          _as_connect_shadows "$ch" "$path" "$upper" "$seen" || return 1
          # Mounted by the keeper at the real path. One launch per role is what makes
          # that safe: two overlays over one upper directory, which overlayfs calls
          # undefined, need two launches, and a second invocation joins this one.
          args+=(--overlay-src "$path" --overlay "$upper" "$work" "$path")
          ;;
        seed-only)
          slot="$base/$ch/seed-only/$(_as_iso_slug "$path")"
          if [[ ! -e "$slot" ]]; then
            _as_connect_view "$ch" "$src" "$path" || return 1
            _as_connect_seed "$_connect_from" "$slot" "$kind" || return 1
          fi
          [[ "$kind" == file ]] && _as_connect_placeholder "$path"
          args+=(--bind "$slot" "$path")
          ;;
        copy)
          # Seeded once and refreshed per file, never written back. The sync is
          # a component with its own tests (components/connect-sync.py): the
          # rules are a nine-case matrix and inline shell would hide it.
          slot="$base/$ch/copy/$(_as_iso_slug "$path")"
          manifest="$base/$ch/base/$(_as_iso_slug "$path").json"
          mkdir -p -- "$(dirname -- "$slot")" "$(dirname -- "$manifest")" || return 1
          _as_connect_view "$ch" "$src" "$path" || return 1
          _as_connect_sync sync "$ch" "$kind" "$_connect_from" "$slot" "$manifest" || return 1
          # A channel whose source has nothing yet still needs a mount point.
          if [[ ! -e "$slot" ]]; then
            if [[ "$kind" == dir ]]; then mkdir -p -- "$slot"; else : >"$slot"; fi || return 1
          fi
          [[ "$kind" == file ]] && _as_connect_placeholder "$path"
          args+=(--bind "$slot" "$path")
          ;;
        read-only)
          if [[ -e "$src" ]]; then
            [[ "$src" != "$path" && "$kind" == file ]] && _as_connect_placeholder "$path"
            args+=(--ro-bind "$src" "$path")
          else
            # Nothing to show, but the parent is bound read-write, so without a
            # mount point here the sandbox could CREATE the file and author at a
            # channel it was told it may only read. An empty, read-only one is
            # the difference between "there is nothing" and "you may add one".
            _as_session_begin || return 1
            empty="$_session_dir/connect/$ch/$(_as_iso_slug "$path")"
            if [[ "$kind" == dir ]]; then
              mkdir -p -- "$empty" || return 1
            else
              mkdir -p -- "$(dirname -- "$empty")" || return 1
              : >"$empty" || return 1
              _as_connect_placeholder "$path"
            fi
            args+=(--ro-bind "$empty" "$path")
          fi
          ;;
      esac
    done
  done
  # ONE line, not one per channel: on a host without overlay support every `copy-on-write`
  # channel falls back, and six identical lines a launch is how a notice becomes
  # something people filter out. Said with _as_msg, never suppressed, because the
  # session loses within-session liveness and that is a behaviour change.
  #
  # The file-shaped fallback is deliberately NOT announced: it is inherent to
  # overlayfs rather than a property of this host, nothing the user can act on,
  # and it is written down in docs/connections.md.
  if ((${#_cow_fellback[@]})); then
    local why="this bubblewrap cannot mount an overlay (needs 0.11 or newer)"
    [[ "$_overlay_mode" == off ]] && why="the overlay is turned off"
    _as_msg "connect: ${_cow_fellback[*]}: copy-on-write is using copy here -- $why. Across launches the two behave the same; a source edit reaches a file this sandbox has not written at the NEXT launch rather than during a running one."
  fi
  return 0
}

# _as_connect_path_warn PATH KEY MODE -- what a path declaration should say about
# where it lands, for every declaration that binds (including an `own` directory
# the launch creates, which is the case the $HOME warning is chiefly for).
_as_connect_path_warn() {
  local p="$1" key="$2" mode="$3" line entry cpath ch overlap
  local -a fields=()
  # Inside a channel, or over one: allowed, and said, because the channel's mode
  # no longer describes that part of it.
  overlap=0
  for line in ${profile_channels[@]+"${profile_channels[@]}"}; do
    IFS=$'\t' read -r -a fields <<<"$line"
    ch="${fields[0]}"
    for entry in "${fields[@]:1}"; do
      cpath="${entry#*:}"
      [[ -n "$cpath" ]] || continue
      if [[ "$p" == "$cpath" || "$p" == "$cpath"/* || "$cpath" == "$p"/* ]]; then
        _as_msg "connect: '$key' overlaps the channel '$ch' ('$cpath'); the path declaration wins there, whatever the channel's mode."
        overlap=1
        break 2
      fi
    done
  done
  # $HOME is where a user is most likely to believe they are naming their real
  # home directory. Inside, $HOME is empty.
  if ((! overlap)) && [[ "$p" == "$HOME"/* ]] && [[ "$p" != "$(_as_project_dir)"/* ]]; then
    if [[ "$mode" == own ]]; then
      _as_msg "connect: '$key' is under your home directory, which is empty inside the sandbox: this is sandbox-only storage at '$p', and your real one stays hidden."
    else
      _as_msg "connect: '$key' is under your home directory, which is empty inside the sandbox: this puts your real '$p' there, at $mode."
    fi
  fi
}

# _as_connect_apply_paths -- add the path declarations' binds to $args.
#
# Called with the [ro]/[rw] binds it replaces, after the working tree and every
# channel, so a declaration lands on top of whatever it is inside and wins there.
# Presets never reach this: a path has no position until someone declares one.
#
# A PATH THAT DOES NOT EXIST IS SKIPPED, with a notice, in every mode but one. The
# engine would otherwise have to create it on the host to have something to bind,
# and every mode except `own` promises something about the path OUTSIDE. The
# exception is a trailing slash under `own`, which reads as "a directory of the
# sandbox's own here" and needs nothing outside. Anything the sandbox then creates
# at a skipped path is picked up at the next launch.
_as_connect_apply_paths() {
  ((${#_connect_paths[@]})) || return 0
  local p key mode base slot manifest real kind rolebase
  local _prot_what _prot_path _prot_how
  rolebase="$(_as_sandbox_dir)"
  for p in "${_connect_paths[@]}"; do
    key="${_connect_key[$p]}"
    mode="${_connect_mode[$p]}"
    base="$rolebase/@paths"
    [[ "${_connect_scope[$p]:-}" == run-scoped ]] && base="$rolebase/@run/@paths"
    if [[ "$mode" == own && "${_connect_scope[$p]:-}" == join-scoped ]]; then
      if ((${_connect_isdir[$p]})) || [[ -d "$p" ]]; then
        _as_join_scoped_bind dir "$p" || return 1
      elif [[ -e "$p" ]]; then
        _as_join_scoped_bind file "$p" || return 1
      else
        _as_msg "connect: '$key' does not exist, so its declaration is skipped this launch; it takes effect at the first launch after the path exists."
      fi
      continue
    fi
    if [[ ! -e "$p" ]]; then
      if [[ "$mode" == own ]] && ((${_connect_isdir[$p]})); then
        _as_connect_path_warn "$p" "$key" "$mode"
        slot="$base/own/$(_as_iso_slug "$p")"
        mkdir -p -- "$slot" || return 1
        args+=(--bind "$slot" "$p")
      else
        _as_msg "connect: '$key' does not exist, so its declaration is skipped this launch; it takes effect at the first launch after the path exists."
      fi
      continue
    fi
    kind="file"
    [[ -d "$p" ]] && kind="dir"
    if ((${_connect_isdir[$p]})) && [[ "$kind" != dir ]]; then
      _as_msg "connect: '$key' ends in '/' but '$p' is not a directory. Refusing rather than guessing which was meant."
      return 1
    fi
    # Resolved again at bind time and re-checked fail-closed, as _as_add_paths does:
    # a symlink repointed after the parse must not mount a target that was refused.
    real="$(readlink -f -- "$p" 2>/dev/null || printf '%s' "$p")"
    if [[ "$real" == / || "$real" == "$HOME" || "$HOME" == "$real"/* ]] || _as_path_protected "$real"; then
      _as_msg "connect: refusing to bind '$key': it resolves to a protected path ('$real')"
      return 1
    fi
    _as_connect_path_warn "$p" "$key" "$mode"
    if [[ "$kind" == file ]]; then
      local cow_note=""
      [[ "$mode" == copy-on-write ]] && cow_note=" And copy-on-write on a file is copy: overlayfs cannot stack on a single file."
      _as_msg "connect: '$key' is a file. It is bound over, so it cannot be deleted or renamed from inside the sandbox.$cow_note"
    fi
    case "$mode" in
      own)
        slot="$base/own/$(_as_iso_slug "$p")"
        if [[ "$kind" == dir ]]; then
          mkdir -p -- "$slot" || return 1
        else
          mkdir -p -- "$(dirname -- "$slot")" || return 1
          [[ -e "$slot" ]] || : >"$slot" || return 1
        fi
        args+=(--bind "$slot" "$p")
        ;;
      seed-only)
        slot="$base/seed-only/$(_as_iso_slug "$p")"
        _as_connect_seed "$real" "$slot" "$kind" || return 1
        args+=(--bind "$slot" "$p")
        ;;
      copy | copy-on-write)
        if [[ "$mode" == copy-on-write && "$kind" == dir ]]; then
          if [[ "$_overlay_mode" != off ]] && _as_overlay_ok; then
            # An overlay at the declared path, mounted by the keeper as a channel's is:
            # the source reads through, a write lands in the role's upper layer and
            # shadows it from then on. The lower is the path itself, which exists
            # (a declaration of a missing path is skipped above). One launch per role
            # (#121) is what makes an overlay the launch chooses safe: there is never a
            # second one over the same upper layer.
            local upper work seen
            upper="$base/upper/$(_as_iso_slug "$p")"
            work="$base/work/$(_as_iso_slug "$p")"
            seen="$base/seen/$(_as_iso_slug "$p").json"
            mkdir -p -- "$upper" "$work" "$(dirname -- "$seen")" || return 1
            _as_connect_shadows "$key" "$real" "$upper" "$seen" || return 1
            args+=(--overlay-src "$real" --overlay "$upper" "$work" "$p")
            continue
          fi
          local why="this bubblewrap cannot mount an overlay (it needs 0.11)"
          [[ "$_overlay_mode" == off ]] && why="the overlay is turned off"
          _as_msg "connect: '$key': copy-on-write is using copy here -- $why. Across launches the two behave the same; a source edit reaches a file this sandbox has not written at the NEXT launch rather than during a running one."
        fi
        slot="$base/copy/$(_as_iso_slug "$p")"
        manifest="$base/base/$(_as_iso_slug "$p").json"
        mkdir -p -- "$(dirname -- "$slot")" "$(dirname -- "$manifest")" || return 1
        _as_connect_sync sync "$key" "$kind" "$real" "$slot" "$manifest" || return 1
        if [[ ! -e "$slot" ]]; then
          if [[ "$kind" == dir ]]; then mkdir -p -- "$slot"; else : >"$slot"; fi || return 1
        fi
        args+=(--bind "$slot" "$p")
        ;;
      read-only) args+=(--ro-bind "$real" "$p") ;;
      read-write) args+=(--bind "$real" "$p") ;;
    esac
  done
  return 0
}

# _as_overlay_ok -- can this bubblewrap mount an overlay? (>= 0.11). Asked once
# and cached: it is a fork per call otherwise, and the answer cannot change
# mid-launch.
_as_overlay_ok() {
  if [[ -z "${_overlay_supported:-}" ]]; then
    if bwrap --help 2>&1 | grep -q -- '--overlay '; then
      _overlay_supported=yes
    else
      _overlay_supported=no
    fi
  fi
  [[ "$_overlay_supported" == yes ]]
}

# _as_connect_sync VERB CHANNEL KIND SOURCE COPY MANIFEST -- run the three-way
# sync (or a reset) for one path, and relay what it says.
#
# REFUSES WITHOUT python3 rather than binding an unsynced copy. An out-of-date
# copy is not a smaller version of `copy`; it is a channel the user believes is
# tracking their edits and is not. The config file takes the other route --
# degrade and say so -- because there a stale copy still carries the account and
# the project entry, and the alternative was no session at all.
_as_connect_sync() {
  local verb="$1" ch="$2" kind="$3" src="$4" copy="$5" manifest="$6" out rc=0
  command -v python3 >/dev/null 2>&1 || {
    _as_msg "connect: '$ch' asks for mode copy, which needs python3 to work out what changed. Refusing rather than binding a copy that silently stops tracking your edits."
    return 1
  }
  [[ -r "$connect_sync" ]] || {
    _as_msg "connect: cannot find the sync helper at $connect_sync (re-run install.sh, or set AGENT_SANDBOX_CONNECT_SYNC)"
    return 1
  }
  out="$(python3 "$connect_sync" "$verb" --kind "$kind" --source "$src" \
    --copy "$copy" --base "$manifest" 2>&1)" || rc=$?
  ((rc == 0)) || {
    _as_msg "connect: syncing '$ch' failed (exit $rc): $out"
    return 1
  }
  # One line per file the sync refused to overwrite. A WARNING, never suppressed
  # by --quiet: the sandbox is running with its own version of something the user
  # has since changed, and saying so once quietly is how that goes unnoticed for
  # a month.
  local line f
  while IFS= read -r line; do
    [[ "$line" == conflict\ * ]] || continue
    f="${line#conflict }"
    _as_msg "connect: $ch: kept this sandbox's '$f'; your own copy of it has changed since. To take yours instead: $(_as_self_cmd --reset "$ch")"
  done <<<"$out"
  return 0
}

# _as_connect_shadows CHANNEL SOURCE UPPER SEEN -- warn about files this sandbox
# is shadowing whose source has changed underneath.
#
# The one thing `copy-on-write` hides, and the design says it hides it loudly: the user
# edited their own copy, the sandbox has its own version, and without a word the
# sandbox would go on using a file the user believes they have updated.
_as_connect_shadows() {
  local ch="$1" src="$2" upper="$3" seen="$4" out rc=0
  command -v python3 >/dev/null 2>&1 || return 0 # nothing to warn WITH; the mount still works
  [[ -r "$connect_sync" ]] || return 0
  out="$(python3 "$connect_sync" shadows --source "$src" --upper "$upper" \
    --seen "$seen" 2>&1)" || rc=$?
  ((rc == 0)) || {
    _as_msg "connect: could not check '$ch' for shadowed files (exit $rc): $out"
    return 0 # a failed CHECK must not stop a launch the mount itself can serve
  }
  local line f
  while IFS= read -r line; do
    [[ "$line" == conflict\ * ]] || continue
    f="${line#conflict }"
    _as_msg "connect: $ch: this sandbox has its own '$f' and your copy of it has changed since. The sandbox goes on using its own. To take yours: $(_as_self_cmd --reset "$ch")"
  done <<<"$out"
  return 0
}

# _as_connect_placeholder PATH -- record a mount point bwrap will CREATE on the
# host, so the session cleanup removes it again while it is still empty.
#
# MEASURED, and it is not cosmetic. A channel bound over a path the source does
# not have makes bwrap create the mount point inside the state directory, which
# is bound read-write from the host -- so an empty, mode-444 `~/.claude/CLAUDE.md`
# was left behind, and the next thing that tried to write there got EPERM. The
# engine already had this exact problem with the config file and already solved
# it; the connection binds simply have to use the same list. Files only, as
# there: an empty leftover directory is indistinguishable from an empty one the
# user made, while an empty FILE is a channel that silently parses as nothing.
_as_connect_placeholder() {
  [[ -e "$1" ]] || _as_placeholder_files+=("$1")
}

# ----- the keeper: one launch per role, and every app joins it (#121) ---------
# A role's stores belong to one launch. A second launch of the same role at the
# same time would bind them from a second sandbox -- for `copy-on-write` two
# overlays over one upper directory, which overlayfs documents as undefined. The
# answer is not to arbitrate between two launches but not to have two: the launch
# is a KEEPER, a sandbox whose only process holds its namespaces, and every app,
# the first included, is JOINED into it (components/join.py) as that process's
# equal. So there is never a second set of mounts for anything to disagree about.
#
# WHAT RUNS WHERE. On the host, a supervisor -- a background copy of the engine that
# started the keeper -- is the launch's parent: it owns what used to be the
# launch's exit (the session directory, the ssh agent, the mount-point files), and
# it ends the keeper once nothing is joined. Inside, the payload does nothing but
# exist, marked in its argv so it can be found. Every join is accounted on the
# HOST, in <sandbox>/keeper/joined/, under <sandbox>/keeper.lock: the state
# directory is a control path the sandbox cannot see, and "joined" means what the
# engine joined -- a stray that `--exec bash` left behind dies with the keeper, as
# it died with bwrap before.
#
# POLICY IS FIXED WHEN THE KEEPER STARTS. A join runs under the running launch's
# policy; it may repeat it but not change it (see _as_keeper_admit), and a changed
# dot-file applies at the next keeper, once nothing is joined.
#
#   <sandbox>/keeper.lock       taken to start a keeper, to join one, and to end one
#   <sandbox>/keeper.log        the supervisor's and the keeper's own output
#   <sandbox>/keeper/id         SUPERVISOR START PAYLOAD START INIT START
#   <sandbox>/keeper/policy     what the keeper was started with (_as_keeper_policy)
#   <sandbox>/keeper/dotfile    the approved dot-file's hash then, or -
#   <sandbox>/keeper/session    its session directory
#   <sandbox>/keeper/seccomp    its syscall filter file, or empty
#   <sandbox>/keeper/joined/N   one per join: the joining engine's PID and start time

# The payload's marker: argv[0] of the process that holds the namespaces.
_as_keeper_marker='agent-sandbox-keeper'

# _as_proc_start PID -- set _ps_start to the process's start time (field 22 of its
# stat), empty if there is no such process. The comm field can hold spaces and
# parentheses, so the fields are counted from the LAST `)`. It sets a variable and
# reads with a builtin because it runs in polling loops, where a command substitution
# (a fork of this whole shell) per call was most of the keeper's start-up time.
_as_proc_start() {
  local st
  _ps_start=""
  { read -r st <"/proc/$1/stat"; } 2>/dev/null || return 1
  st="${st##*) }"
  local -a f
  read -r -a f <<<"$st"
  _ps_start="${f[19]:-}"
  [[ -n "$_ps_start" ]]
}

# _as_proc_is PID START -- is PID still the process that started at START?
_as_proc_is() {
  [[ -n "$1" && -n "$2" ]] || return 1
  _as_proc_start "$1" && [[ "$_ps_start" == "$2" ]]
}

# _as_keeper_live SANDBOXDIR -- is this role's keeper running? Sets _keeper_target
# (the host PID of the payload, what a join enters) and _keeper_spid (the supervisor).
# Both the supervisor and the payload must be the processes recorded, by PID and start
# time, so a recycled PID is never mistaken for them.
_as_keeper_live() {
  local spid sstart tpid tstart
  read -r spid sstart tpid tstart _ 2>/dev/null <"$1/keeper/id" || return 1
  _as_proc_is "$spid" "$sstart" && _as_proc_is "$tpid" "$tstart" || return 1
  _keeper_target="$tpid" _keeper_spid="$spid"
  return 0
}

# _as_keeper_lock SANDBOXDIR / _as_keeper_unlock -- the keeper lock, on fd 9.
#
# A BOUNDED WAIT, and a long one. The lock is held while a keeper is started, which
# includes seeding its stores, so a second invocation arriving then waits for the
# first to finish and joins it. Thirty seconds means something is wrong, not busy.
# Every process that outlives the engine is started with fd 9 closed (the
# supervisor closes everything it inherited): a lock held by a leftover descriptor
# is released by nothing, and every later launch of the role would hang on it.
_as_keeper_lock() {
  mkdir -p -- "$1" || return 1
  command -v flock >/dev/null 2>&1 || {
    _as_msg "the keeper needs flock (util-linux), which is not on PATH"
    return 1
  }
  exec 9>"$1/keeper.lock" || return 1
  flock -w 30 9 || {
    _as_msg "role '${_role:-default}': another launch of this role has held its lock for 30 s; not waiting any longer ($1/keeper.lock)"
    exec 9>&-
    return 1
  }
}
_as_keeper_unlock() {
  { flock -u 9 && exec 9>&-; } 2>/dev/null || true
}

# _as_keeper_grace -- seconds an idle keeper waits before it ends, so that commands
# run one after another (`--exec` in a script) share one launch instead of starting
# a keeper each. AGENT_SANDBOX_KEEPER_GRACE is for the test suites, which run every
# launch to completion and set it to 0; with 0 a join also waits for the keeper to
# end before it returns, so the next launch never meets the previous one.
_as_keeper_grace() {
  local g="${AGENT_SANDBOX_KEEPER_GRACE:-2}"
  [[ "$g" =~ ^[0-9]+(\.[0-9]+)?$ ]] || g=2
  printf '%s' "$g"
}

# _as_keeper_policy all|set -- what this invocation resolved, one `key<TAB>value<TAB>
# where` line per value. `all` is every knob, recorded when a keeper starts; `set` is
# only the knobs THIS invocation set by flag or environment, which is what a join is
# checked on. A key beginning with `+` is a list, where the join's values must each
# be among the keeper's; any other key must be equal.
#
# The dot-file is not in `set`: a join cannot set it (it is the project's, and the
# keeper read it when it started), and a changed one is a warning, not a refusal.
# Uses the engine's resolved locals by dynamic scope.
# shellcheck disable=SC2154
_as_keeper_policy() {
  local all=0 k v
  [[ "$1" == all ]] && all=1
  _kp() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }
  if ((all)) || [[ -n "$_preset_flag" || -n "${AGENT_SANDBOX_PRESET:-}" ]]; then
    _kp preset "$_preset" "$([[ -n "$_preset_flag" ]] && echo --preset || echo AGENT_SANDBOX_PRESET)"
  fi
  for k in "${!_connect_mode[@]}"; do
    v="${_connect_where[$k]}"
    if ((all)) || [[ "$v" == --connect || "$v" == AGENT_SANDBOX_CONNECT ]]; then
      _kp "connect:$k" "${_connect_mode[$k]}${_connect_scope[$k]:+ ${_connect_scope[$k]}}" "$v"
    fi
  done
  if ((all)) || [[ -n "$_overlay_flag" || -n "${AGENT_SANDBOX_OVERLAY:-}" ]]; then
    _kp overlay "$_overlay_mode" "$([[ -n "$_overlay_flag" ]] && echo --overlay || echo AGENT_SANDBOX_OVERLAY)"
  fi
  if ((all)) || [[ -n "${AGENT_SANDBOX_NET:-}" ]]; then
    _kp net "${_knob_net:-proxy}" AGENT_SANDBOX_NET
  fi
  v="${_knob_seccomp:-on}"
  [[ "$v" == 1 ]] && v=on
  [[ "$v" == 0 ]] && v=off
  if ((all)) || [[ -n "${AGENT_SANDBOX_SECCOMP:-}" ]]; then _kp seccomp "$v" AGENT_SANDBOX_SECCOMP; fi
  v="${_knob_briefing:-on}"
  [[ "$v" == 1 ]] && v=on
  [[ "$v" == 0 ]] && v=off
  if ((all)) || [[ -n "${AGENT_SANDBOX_BRIEFING:-}" ]]; then _kp briefing "$v" AGENT_SANDBOX_BRIEFING; fi
  if ((all)) || [[ -n "${AGENT_SANDBOX_CONDA_WRITE:-}" ]]; then _kp conda-write "${_knob_conda_write:-}" AGENT_SANDBOX_CONDA_WRITE; fi
  if ((all)) || [[ -n "${AGENT_SANDBOX_CONDA_PKGS:-}" ]]; then _kp conda-pkgs "${_knob_conda_pkgs:-}" AGENT_SANDBOX_CONDA_PKGS; fi
  local -a l=()
  local item
  # The lists. The keeper records the union it launched with (flags, environment
  # and dot-file); a join is checked on what its own flags and environment named.
  _as_split l : "${AGENT_SANDBOX_RO:-}"
  ((all)) && l+=(${_df_ro[@]+"${_df_ro[@]}"})
  for item in ${l[@]+"${l[@]}"}; do [[ -n "$item" ]] && _kp +ro "$item" AGENT_SANDBOX_RO; done
  l=()
  _as_split l : "${AGENT_SANDBOX_RW:-}"
  ((all)) && l+=(${_df_rw[@]+"${_df_rw[@]}"})
  for item in ${l[@]+"${l[@]}"}; do [[ -n "$item" ]] && _kp +rw "$item" AGENT_SANDBOX_RW; done
  l=()
  _as_split l $', \t\n' "${AGENT_SANDBOX_FORWARD:-}"
  ((all)) && l+=(${_df_forward[@]+"${_df_forward[@]}"})
  for item in ${l[@]+"${l[@]}"}; do [[ -n "$item" ]] && _kp +forward "$item" AGENT_SANDBOX_FORWARD; done
  l=(${_allow_hosts[@]+"${_allow_hosts[@]}"})
  ((all)) && l+=(${_df_allow[@]+"${_df_allow[@]}"})
  for item in ${l[@]+"${l[@]}"}; do [[ -n "$item" ]] && _kp +allow "$item" --allow; done
  for item in ${_ssh_hosts[@]+"${_ssh_hosts[@]}"}; do _kp +ssh "$item" --ssh; done
  if ((all || _ssh_unrestricted)); then _kp ssh-unrestricted "$_ssh_unrestricted" --ssh-unrestricted; fi
  if ((all)) || [[ -n "$_ssh_key" ]]; then _kp ssh-key "$_ssh_key" --ssh-key; fi
  if ((all)) || [[ -n "$_ssh_timeout" ]]; then _kp ssh-timeout "$_ssh_timeout" --ssh-timeout; fi
  # Ports: the keeper's are the merged set; a join's are what it named itself.
  if ((all)); then
    for item in ${_host_ports[@]+"${_host_ports[@]}"}; do _kp +host-port "$item" --host-port; done
    for item in ${_agent_ports[@]+"${_agent_ports[@]}"}; do _kp +agent-port "$item" --agent-port; done
    ((_host_none)) && _kp +host-port none --host-port
    ((_agent_none)) && _kp +agent-port none --agent-port
  else
    for item in ${_keeper_join_host_ports[@]+"${_keeper_join_host_ports[@]}"}; do _kp +host-port "$item" "--host-port/AGENT_SANDBOX_HOST_PORTS"; done
    for item in ${_keeper_join_agent_ports[@]+"${_keeper_join_agent_ports[@]}"}; do _kp +agent-port "$item" "--agent-port/AGENT_SANDBOX_AGENT_PORTS"; done
  fi
  # THE AGENT ITSELF: the keeper binds the binary it launched with, so a join that runs
  # another one would find nothing at that path inside (measured: "No such file", exit
  # 127). Every join names one -- CMD resolved, or the profile's command on PATH -- so it
  # is always compared, but for --exec, which runs a command of its own. After an update
  # moves `claude` to a new binary, an idle keeper is replaced and a busy one refuses,
  # which is the rule for every other part of a running role's policy.
  if ((all || ! _do_exec)); then _kp agent "$profile_bin" "this launch's agent"; fi
  unset -f _kp
  return 0
}

# _as_keeper_admit SANDBOXDIR -- may this invocation join the running keeper?
#
# A JOIN MAY REPEAT THE KEEPER'S POLICY, NOT CHANGE IT. Only the knobs this invocation
# set are compared, so a bare `claude --role x` always joins; one that asks for what
# the keeper already has joins too; one that asks for something else is refused,
# naming the knob. Refused rather than warned-and-ignored because a flag is a request
# for THIS invocation: there is no next keeper for it to apply to, and ignoring it
# would be asking for `isolated` and getting `shared`.
#
# A CHANGED DOT-FILE WARNS AND JOINS (the caller says so; this sets
# _keeper_dotfile_changed). It is standing policy, and it applies at the next keeper by
# itself, so saying so is complete information. With QUIET nothing is said: the caller
# is asking about an idle keeper, which it replaces rather than refuses.
_as_keeper_admit() {
  local kd="$1/keeper" quiet="${2:-}" key val where have
  _keeper_dotfile_changed=0
  local -A kv=() kl=()
  while IFS=$'\t' read -r key val where; do
    [[ -n "$key" ]] || continue
    if [[ "$key" == +* ]]; then
      kl["$key"$'\t'"$val"]=1
    else
      kv["$key"]="$val"
    fi
  done <"$kd/policy"
  while IFS=$'\t' read -r key val where; do
    [[ -n "$key" ]] || continue
    if [[ "$key" == +* ]]; then
      [[ -n "${kl["$key"$'\t'"$val"]:-}" ]] && continue
      have=""
      local k2
      for k2 in "${!kl[@]}"; do [[ "${k2%%$'\t'*}" == "$key" ]] && have+="${have:+, }${k2#*$'\t'}"; done
      [[ -n "$quiet" ]] || _as_msg "role '${_role:-default}' is running, and $where $val is not part of its policy (${key#+}: ${have:-none}). A running role's policy cannot change: exit what is joined into it, then launch again."
      return 1
    fi
    have="${kv[$key]-}"
    [[ "$have" == "$val" ]] && continue
    [[ -n "$quiet" ]] || _as_msg "role '${_role:-default}' is running with ${key} = ${have:-(none)}, and $where asks for '$val'. A running role's policy cannot change: exit what is joined into it, then launch again."
    return 1
  done < <(_as_keeper_policy set)
  [[ "$(cat "$kd/dotfile" 2>/dev/null)" == "$(_as_keeper_dotfile_hash)" ]] || _keeper_dotfile_changed=1
  return 0
}

# _as_keeper_dotfile_hash -- the approved dot-file's hash, or `-` when there is none:
# a file that is present but not approved is not read, so it is not policy either.
# shellcheck disable=SC2154
_as_keeper_dotfile_hash() {
  if [[ -f "$_dotfile" ]] && _as_dotfile_trusted "$_proj" "$_dotfile"; then
    _as_sha256_file "$_dotfile"
  else
    printf -- '-'
  fi
}

# _as_keeper_find BWRAPPID -- set _kf_found to the keeper's payload: the process at the
# end of the single chain of children below the launch, with the marker as its argv[0].
# `PAYLOAD INIT`, where INIT is its parent (bwrap's pid 1 in the sandbox), or the payload
# itself when it has no parent of its own below the launch.
_as_keeper_find() {
  local c="$1" prev="" kids a0 f
  _kf_found=""
  while :; do
    kids=""
    for f in /proc/"$c"/task/*/children; do
      # No trailing newline in this file, so `read` reports EOF having read it all.
      _kf_kids=()
      { read -r -a _kf_kids <"$f"; } 2>/dev/null
      ((${#_kf_kids[@]})) && kids="${_kf_kids[0]}" && break
    done
    [[ -n "$kids" ]] || break
    prev="$c" c="$kids"
  done
  { IFS= read -r -d '' a0 <"/proc/$c/cmdline"; } 2>/dev/null
  [[ "${a0:-}" == "$_as_keeper_marker" ]] || return 1
  _kf_found="$c ${prev:-$c}"
}

# _as_keeper_supervise SANDBOXDIR -- LAUNCHER... -- the keeper's host side. Runs in
# the background, a fork of the engine, so it has the launch's whole state.
_as_keeper_supervise() {
  local sb="$1" kd="$1/keeper" fd
  shift 2
  # Nothing it inherited stays open: the lock, a pipe someone reads (bats reads its
  # results through one it passes to every child, and a holder that kept it open once
  # hung the whole suite), a terminal. The loop is general on purpose.
  for fd in /proc/"$BASHPID"/fd/*; do
    case "${fd##*/}" in 0 | 1 | 2) ;; *) eval "exec ${fd##*/}>&-" 2>/dev/null ;; esac
  done
  exec </dev/null >>"$sb/keeper.log" 2>&1
  # The terminal it was started from is not its own: Ctrl-C there, or closing it,
  # ends what is joined from there, never the launch other terminals joined too.
  trap '' INT QUIT HUP TSTP TTIN TTOU
  trap - EXIT TERM
  trap ':' USR1
  local me mestart
  me="$BASHPID"
  _as_proc_start "$me"
  mestart="$_ps_start"
  # The session directory is now this process's: the janitor and the proxy addon
  # judge it by its owner, and the engine that made it is about to exit.
  [[ -n "${_session_dir:-}" ]] && printf '%s %s\n' "$me" "$mestart" >"$_session_dir/owner.id"
  "$@" &
  local b=$! found="" t tstart init istart i
  for ((i = 0; i < 1000; i++)); do
    _as_keeper_find "$b" && found="$_kf_found" && break
    kill -0 "$b" 2>/dev/null || break
    sleep 0.01
  done
  if [[ -z "$found" ]]; then
    # The launch's own status is what the engine reports: 127 and 126 mean bwrap
    # itself could not run, which is when the unsandboxed way back is worth naming.
    local brc=0
    kill "$b" 2>/dev/null
    { wait "$b"; } 2>/dev/null || brc=$?
    printf '%s\n' "$brc" >"$kd/failed"
    exit 1
  fi
  read -r t init <<<"$found"
  _as_proc_start "$t"
  tstart="$_ps_start"
  _as_proc_start "$init"
  istart="$_ps_start"
  printf '%s %s %s %s %s %s\n' "$me" "$mestart" "$t" "$tstart" "$init" "$istart" >"$kd/id.new" \
    && mv -f -- "$kd/id.new" "$kd/id"
  local grace sl
  grace="$(_as_keeper_grace)"
  exec 8>"$sb/keeper.lock"
  local again=0
  while :; do
    # Woken by a join's exit (USR1), or every five seconds to notice one that died
    # without saying so.
    if ((! again)); then
      sleep 5 8>&- &
      sl=$!
      wait "$sl" 2>/dev/null
      kill "$sl" 2>/dev/null
    fi
    again=0
    _as_proc_is "$t" "$tstart" || break # the launch ended from inside
    if [[ -e "$kd/force" ]]; then       # --shutdown: whatever is joined or running
      flock 8
      rm -f -- "$kd/id"
      break
    fi
    flock 8
    _as_keeper_count "$kd"
    flock -u 8
    ((_kc_n == 0)) || continue
    _as_keeper_daemon "$kd" && continue
    # The grace, interruptible: a reset that ends an idle keeper signals it here. Any
    # other signal is a join that came and went meanwhile, and the grace starts over.
    if [[ ! -e "$kd/stop" && "$grace" != 0 ]]; then
      sleep "$grace" 8>&- &
      sl=$!
      local wrc=0
      wait "$sl" 2>/dev/null || wrc=$?
      kill "$sl" 2>/dev/null
      if ((wrc > 128)) && [[ ! -e "$kd/stop" ]]; then
        again=1
        continue
      fi
    fi
    flock 8
    _as_keeper_count "$kd"
    if ((_kc_n == 0)) && { [[ -e "$kd/force" ]] || ! _as_keeper_daemon "$kd"; }; then
      rm -f -- "$kd/id"
      break # the lock stays held until the launch is gone and cleaned up
    fi
    flock -u 8
  done
  # Ending it: pid 1 of the sandbox first, which takes every process in it along, and
  # the launch with it. The watchdog is for a launch that does not follow (a pasta
  # that outlived its child): five seconds, then it is killed too.
  _as_proc_is "$init" "$istart" && kill -KILL "$init" 2>/dev/null
  (sleep 5 && kill -KILL "$b") 2>/dev/null 8>&- &
  local dog=$!
  { wait "$b"; } 2>/dev/null
  kill "$dog" 2>/dev/null
  flock 8 # held already when it ended because it was idle; taken when it ended from inside
  _as_session_cleanup
  _as_run_scoped_clear "$sb"
  _as_join_scoped_clear "$sb"
  rm -rf -- "$kd"
  flock -u 8
  exit 0
}

# _as_keeper_count KEEPERDIR -- set _kc_n to how many joins are live, forgetting the
# ones that are not. Called with the lock held.
_as_keeper_count() {
  local f pid start
  _kc_n=0
  for f in "$1"/joined/*; do
    [[ -f "$f" ]] || continue
    pid="" start=""
    { read -r pid start <"$f"; } 2>/dev/null
    if _as_proc_is "$pid" "$start"; then
      _kc_n=$((_kc_n + 1))
    else
      rm -f -- "$f"
      _as_join_scoped_clear "${1%/keeper}" "j${f##*/}" # a join killed with -9
    fi
  done
  return 0
}

# _as_keeper_daemon KEEPERDIR -- is a background daemon running inside this keeper?
#
# A DAEMON HOLDS THE KEEPER, as a join does (#123): the rule is "something the user
# started in this role is still running", and `claude --bg` returns once it has
# handed its task to a daemon that outlives it. The profile says what a daemon looks
# like (profile_daemon_argv: tokens that appear in order in its argv). It detaches, so
# inside the sandbox it is reparented to pid 1 -- bwrap's init, the keeper payload's
# parent -- and it is found among that process's descendants, which the host can walk
# without entering anything. Claude Code's daemon does not exit when idle (measured),
# so a role that has one ends by --shutdown.
_as_keeper_daemon() {
  ((${#profile_daemon_argv[@]})) || return 1
  local init istart
  read -r _ _ _ _ init istart 2>/dev/null <"$1/id" || return 1
  _as_proc_is "$init" "$istart" || return 1
  local -a todo=("$init") kids a
  local p f want
  want=" ${profile_daemon_argv[*]} "
  while ((${#todo[@]})); do
    p="${todo[0]}"
    todo=("${todo[@]:1}")
    for f in /proc/"$p"/task/*/children; do
      kids=()
      { read -r -a kids <"$f"; } 2>/dev/null
      todo+=(${kids[@]+"${kids[@]}"})
    done
    [[ "$p" == "$init" ]] && continue
    a=()
    { mapfile -d '' -t a <"/proc/$p/cmdline"; } 2>/dev/null
    ((${#a[@]} > 1)) || continue
    [[ " ${a[*]:1} " == *"$want"* ]] && return 0
  done
  return 1
}

# _as_keeper_busy SANDBOXDIR -- is anything holding this role's keeper: a join, or a
# daemon? Called with the lock held; sets _kc_n as _as_keeper_count does.
_as_keeper_busy() {
  _as_keeper_count "$1/keeper"
  ((_kc_n > 0)) && return 0
  _as_keeper_daemon "$1/keeper"
}

# _as_keeper_shutdown SANDBOXDIR -- end this role's launch: the keeper, everything
# joined into it, and a daemon with its pool. What --shutdown does. A later launch of
# the role starts a fresh keeper under the policy then in force.
_as_keeper_shutdown() {
  local sb="$1" kd="$1/keeper" i spid
  _as_keeper_lock "$sb" || return 1
  if ! _as_keeper_live "$sb"; then
    _as_keeper_unlock
    _as_info "role '${_role:-default}' is not running"
    return 0
  fi
  spid="$_keeper_spid"
  : >"$kd/stop"
  : >"$kd/force"
  _as_keeper_unlock
  kill -USR1 "$spid" 2>/dev/null
  for ((i = 0; i < 1500; i++)); do
    if [[ ! -d "/proc/$spid" ]]; then
      _as_msg "role '${_role:-default}': ended, with everything that ran in it"
      return 0
    fi
    sleep 0.01
  done
  _as_msg "role '${_role:-default}': its keeper did not end within 15 s (supervisor $spid); see $sb/keeper.log"
  return 1
}

# ----- join-scoped: a store for one join (#147) -------------------------------------
# A joined process shares the keeper's mounts, so a store of one join's own lives in a
# mount namespace of the join's own, which components/join.py makes (see there). What
# the launch provides: an empty, read-only mount point at each join-scoped path -- what
# the keeper, and anything not joined through join.py, sees there -- and a STAGING
# directory, <sandbox>/@join-stage, bound read-write at a hidden inside path, through
# which each join's stores reach the sandbox: a bind's source has to be inside the
# caller's mount namespace, and the role's state directory is not (measured,
# probes/join-scoped-spike.py). A join's stores then move out of staging to
# <sandbox>/@join/<id> before its command starts, and go when the join ends.
_as_join_stage_inside() { printf '/run/agent-sandbox-stage'; }

# _as_join_scoped_bind KIND PATH -- the launch's side of one join-scoped path.
# shellcheck disable=SC2154
_as_join_scoped_bind() {
  local kind="$1" path="$2" empty sb
  _as_session_begin || return 1
  empty="$_session_dir/connect/@join/$(_as_iso_slug "$path")"
  if [[ "$kind" == dir ]]; then
    mkdir -p -- "$empty" || return 1
  else
    mkdir -p -- "$(dirname -- "$empty")" || return 1
    : >"$empty" || return 1
    _as_connect_placeholder "$path"
  fi
  args+=(--ro-bind "$empty" "$path")
  if ((! _join_stage_bound)); then
    sb="$(_as_sandbox_dir)"
    mkdir -p -- "$sb/@join-stage" "$sb/@join" || return 1
    args+=(--bind "$sb/@join-stage" "$(_as_join_stage_inside)")
    _join_stage_bound=1
  fi
  _join_scoped+=("$kind"$'\t'"$(_as_iso_slug "$path")"$'\t'"$path")
}

# _as_join_scoped_clear SANDBOXDIR [ID] -- remove one join's stores, or every join's.
_as_join_scoped_clear() {
  local d
  for d in "$1/@join-stage${2:+/$2}" "$1/@join${2:+/$2}"; do
    [[ -e "$d" ]] || continue
    chmod -R u+rwX -- "$d" 2>/dev/null
    rm -rf -- "$d"
  done
  return 0
}

# _as_run_scoped_clear SANDBOXDIR -- discard every run-scoped store of the role: its
# @run directory (#105). Called at a keeper's COLD START, before anything is built or
# mounted, and by the supervisor once the launch has ended. The start is what makes it
# crash-safe -- a launch killed with -9 runs no exit step, and the next one clears what it
# left -- and the exit is what makes the store "gone when the run ends" (#125) rather
# than lying on disk until the next run. A process that joins a running launch shares
# what is there: one run of a role is one installation.
_as_run_scoped_clear() {
  [[ -e "$1/@run" ]] || return 0
  # CHMOD BEFORE REMOVING: an overlay's workdir keeps a mode-000 directory.
  chmod -R u+rwX -- "$1/@run" 2>/dev/null
  rm -rf -- "$1/@run"
}

# _as_keeper_start SANDBOXDIR LAUNCHER... -- start this role's keeper; the lock is held.
# The launcher is the command line that runs the sandbox (bwrap, or pasta running
# bwrap), ending in `--` and the payload.
_as_keeper_start() {
  local sb="$1" kd="$1/keeper" i
  shift
  _as_holder_legacy_stop "$sb"
  # A record left by a keeper that did not end cleanly (a reboot, a SIGKILL) says
  # nothing now: this is only reached when no keeper is live.
  rm -rf -- "$kd"
  mkdir -p -- "$kd/joined" || return 1
  : >"$sb/keeper.log"
  _as_keeper_policy all >"$kd/policy"
  _as_keeper_dotfile_hash >"$kd/dotfile"
  # The copy a join parses: the approved file as it is now (see the trust gate).
  if [[ "$(cat "$kd/dotfile")" != - ]]; then
    cp -- "$_dotfile" "$kd/dotfile.copy" || return 1
  fi
  printf '%s\n' "${_session_dir:-}" >"$kd/session"
  printf '%s\n' "${_seccomp_bpf:-}" >"$kd/seccomp"
  # The join-scoped paths, for each join to make its own stores for.
  ((${#_join_scoped[@]})) && printf '%s\n' "${_join_scoped[@]}" >"$kd/join-scoped"
  (_as_keeper_supervise "$sb" -- "$@") &
  local sup=$!
  for ((i = 0; i < 1500; i++)); do
    _as_keeper_live "$sb" && return 0
    kill -0 "$sup" 2>/dev/null || break
    sleep 0.01
  done
  wait "$sup" 2>/dev/null
  local frc=1
  read -r frc 2>/dev/null <"$kd/failed" || frc=1
  ((frc)) || frc=1
  _as_msg "role '${_role:-default}': the sandbox did not start${frc:+ (exit $frc)}. Its output:"
  sed 's/^/  /' "$sb/keeper.log" >&2
  kill "$sup" 2>/dev/null
  rm -rf -- "$kd"
  return "$frc"
}

# _as_keeper_join SANDBOXDIR CMD... -- run CMD in the running keeper, as its equal, and
# return its exit status. The lock is held on entry and released here, once this join
# is on the record, so the keeper cannot count it out while it starts.
#
# THE ENVIRONMENT IS THE KEEPER'S, except what describes the terminal this join came
# from: TERM and the locale group. The rest -- HOME, PATH, the conda variables, the
# proxy and CA variables, the profile's own -- describes the sandbox, and that is the
# keeper's. The working directory is the keeper's too, which is this invocation's:
# the sandbox key is the project, and a join from another directory is another
# project's keeper.
# shellcheck disable=SC2154
_as_keeper_join() {
  local sb="$1" kd="$1/keeper" join rec rc=0 v g
  shift
  join="${AGENT_SANDBOX_JOIN:-$(dirname -- "$engine")/components/join.py}"
  [[ -r "$join" ]] || {
    _as_keeper_unlock
    _as_msg "the keeper's join is missing ($join); re-run install.sh"
    return 1
  }
  command -v python3 >/dev/null 2>&1 || {
    _as_keeper_unlock
    _as_msg "joining the sandbox needs python3, which is not on PATH"
    return 1
  }
  rec="$kd/joined/$BASHPID"
  _as_proc_start "$BASHPID"
  printf '%s %s\n' "$BASHPID" "$_ps_start" >"$rec"
  local spid="$_keeper_spid" target="$_keeper_target" bpf
  bpf="$(cat "$kd/seccomp" 2>/dev/null)"
  _as_keeper_unlock
  local -a jargs=()
  [[ -n "$bpf" ]] && jargs+=(--seccomp "$bpf")
  jargs+=(--unset SHLVL --env "TERM=${TERM:-xterm-256color}")
  # This join's own stores, when the launch declares join-scoped paths.
  local jid="" jkind jname jpath
  if [[ -s "$kd/join-scoped" ]]; then
    jid="j$BASHPID"
    mkdir -p -- "$sb/@join-stage/$jid" "$sb/@join" || return 1
    jargs+=(--private "$sb/@join-stage" "$(_as_join_stage_inside)" "$sb/@join" "$jid")
    while IFS=$'\t' read -r jkind jname jpath; do
      [[ -n "$jname" ]] || continue
      if [[ "$jkind" == dir ]]; then mkdir -p -- "$sb/@join-stage/$jid/$jname"; else : >"$sb/@join-stage/$jid/$jname"; fi
      jargs+=(--private-path "$jname" "$jpath")
    done <"$kd/join-scoped"
  fi
  for v in LANG LC_ALL LC_CTYPE LC_MESSAGES LC_NUMERIC LC_TIME LC_COLLATE TZ COLORTERM NO_COLOR FORCE_COLOR; do
    if [[ -n "${!v+x}" ]]; then jargs+=(--env "$v=${!v}"); else jargs+=(--unset "$v"); fi
  done
  # The engine does not leave while the joined command runs: Ctrl-C reaches the join
  # (which passes it on) and this process, which must still take its record off.
  trap ':' INT QUIT
  trap - HUP TERM
  python3 "$join" "${jargs[@]}" "$target" -- "$@" || rc=$?
  trap - INT QUIT
  [[ -n "${_join_brief:-}" ]] && rm -rf -- "$_join_brief"
  [[ -n "$jid" ]] && _as_join_scoped_clear "$sb" "$jid"
  local last=0
  if _as_keeper_lock "$sb" 2>/dev/null; then
    rm -f -- "$rec"
    _as_keeper_count "$kd"
    ((_kc_n == 0)) && last=1
    _as_keeper_unlock
  else
    rm -f -- "$rec"
  fi
  kill -USR1 "$spid" 2>/dev/null
  # With no grace the keeper ends with its last join, and the join returns once it has.
  g="$(_as_keeper_grace)"
  if [[ "$g" == 0 && "$last" == 1 ]]; then
    local i
    # ...unless something else holds it: a daemon this join left behind.
    for ((i = 0; i < 1000; i++)); do
      [[ -d "/proc/$spid" ]] || break
      _as_keeper_daemon "$kd" && break
      kill -USR1 "$spid" 2>/dev/null
      sleep 0.01
    done
  fi
  return "$rc"
}

# _as_keeper_stop_idle SANDBOXDIR -- end this role's keeper if nothing is joined; fail
# if something is. What a reset does first: the layers it removes are the keeper's
# mounts.
_as_keeper_stop_idle() {
  local sb="$1" kd="$1/keeper" i spid
  _as_keeper_lock "$sb" || return 1
  if ! _as_keeper_live "$sb"; then
    _as_keeper_unlock
    return 0
  fi
  if _as_keeper_busy "$sb"; then
    _as_keeper_unlock
    return 1
  fi
  spid="$_keeper_spid"
  : >"$kd/stop"
  _as_keeper_unlock
  kill -USR1 "$spid" 2>/dev/null
  for ((i = 0; i < 400; i++)); do
    [[ -d "/proc/$spid" ]] || return 0
    sleep 0.025
  done
  return 1
}

# _as_holder_legacy_stop SANDBOXDIR -- stop a holder an engine before the keeper left.
# A holder mounted this role's copy-on-write overlays at staging paths and outlived
# its launches; one still running would be a second overlay over the upper layers the
# keeper is about to mount. It stayed alive only while <sandbox>/holder.id named it.
_as_holder_legacy_stop() {
  local f="$1/holder.id" pid start i
  [[ -e "$f" ]] || return 0
  read -r pid start 2>/dev/null <"$f"
  if _as_proc_is "${pid:-}" "${start:-}"; then
    kill "$pid" 2>/dev/null
    for ((i = 0; i < 100; i++)); do
      [[ -d "/proc/$pid" ]] || break
      sleep 0.05
    done
  fi
  rm -f -- "$f" "$1/holder.lock"
  return 0
}

# _as_connect_reset CHANNEL|PATH -- discard what this role holds at one channel or
# one declared path, and take the source's version again (#126).
#
# Destructive of the role's own work there and of nothing else, so it says what it
# removed rather than working in silence. It resets whatever store is there whatever
# the current mode: a channel moved back to `read-write` still has its old copy on
# disk, and leaving it would surprise whoever moves it back again. Every mode's store
# is discarded, `own` included, whose "source's version" is the empty start.
_as_connect_reset() {
  local want="$1" line ch entry kind path slot manifest base found=0 upper work seen seeded own _connect_from
  local -a fields=()
  base="$(_as_sandbox_dir)"
  # Never while anything is joined into this role's keeper: its overlays' layers are
  # these directories, and removing them under a live mount is the one way this verb
  # can do damage rather than undo it. An IDLE keeper is ended first -- its mounts hold
  # references to the layer directories rather than their paths, so removing them
  # underneath it would leave the old content still being served.
  if ! _as_keeper_stop_idle "$base"; then
    _as_msg "connect: role '${_role:-default}' is running. Resetting would remove the layers it has mounted. End it first ($(_as_self_cmd --role "${_role:-default}" --shutdown)) and run this again."
    return 1
  fi
  _as_holder_legacy_stop "$base"
  # A PATH DECLARATION: any key with a `/`, resolved as the declaration was.
  if [[ "$want" == */* ]]; then
    local _path_key
    _as_connect_parse_path "$want" own --reset || return 1
    path="$_path_key"
    local pb="$base/@paths" s1
    for s1 in "$pb/own/$(_as_iso_slug "$path")" "$pb/seed-only/$(_as_iso_slug "$path")" \
      "$pb/copy/$(_as_iso_slug "$path")" "$pb/base/$(_as_iso_slug "$path").json" \
      "$pb/upper/$(_as_iso_slug "$path")" "$pb/work/$(_as_iso_slug "$path")" \
      "$pb/seen/$(_as_iso_slug "$path").json"; do
      [[ -e "$s1" ]] || continue
      chmod -R u+rwX -- "$s1" 2>/dev/null
      rm -rf -- "$s1" || return 1
      found=1
    done
    if ((found)); then
      _as_msg "connect: reset '$want' ($path); the next launch starts it from the source again"
    else
      _as_msg "connect: role '${_role:-default}' holds nothing at '$want' ($path)"
    fi
    return 0
  fi
  for line in ${profile_channels[@]+"${profile_channels[@]}"}; do
    IFS=$'\t' read -r -a fields <<<"$line"
    ch="${fields[0]}"
    [[ "$ch" == "$want" ]] || continue
    found=1
    for entry in "${fields[@]:1}"; do
      kind="${entry%%:*}"
      path="${entry#*:}"
      slot="$base/$ch/copy/$(_as_iso_slug "$path")"
      manifest="$base/$ch/base/$(_as_iso_slug "$path").json"
      upper="$base/$ch/upper/$(_as_iso_slug "$path")"
      work="$base/$ch/work/$(_as_iso_slug "$path")"
      seen="$base/$ch/seen/$(_as_iso_slug "$path").json"
      seeded="$base/$ch/seed-only/$(_as_iso_slug "$path")"
      own="$base/$ch/own/$(_as_iso_slug "$path")"
      [[ -e "$slot" || -e "$manifest" || -e "$upper" || -e "$seeded" || -e "$own" ]] || continue
      # seed-only and own: discarding the store is the reset; the next launch seeds
      # again, or starts empty.
      [[ -e "$seeded" ]] && { rm -rf -- "$seeded" 2>/dev/null || true; }
      [[ -e "$own" ]] && { rm -rf -- "$own" 2>/dev/null || true; }
      # copy-on-write first: the upper layer holds the shadows AND the whiteouts, so
      # removing it is what brings a file the sandbox deleted back into view.
      # CHMOD BEFORE REMOVING -- measured: once anything has been written through
      # an overlay its workdir keeps a mode-000 directory that `rm -rf` cannot
      # enter, even as its owner.
      if [[ -e "$upper" || -e "$work" ]]; then
        chmod -R u+rwX -- "$upper" "$work" 2>/dev/null || true
        rm -rf -- "$upper" "$work" "$seen" 2>/dev/null || true
      fi
      if [[ -e "$slot" || -e "$manifest" ]]; then
        _as_connect_view "$ch" "$(_as_channel_source "$path")" "$path" || return 1
        _as_connect_sync reset "$ch" "$kind" "$_connect_from" "$slot" "$manifest" || return 1
      fi
      _as_msg "connect: reset '$ch' at $path from your own copy"
    done
  done
  ((found)) || {
    _as_msg "connect: profile '$profile' has no channel '$want', and it is not a path (a path has a '/'). It carries: $(_as_connect_channels)"
    return 1
  }
  return 0
}

# _as_role_delete -- remove every store of this role (#126). Refused while anything
# holds its keeper, naming --shutdown: keeping processes running on stores that are
# gone makes no sense, and the refusal is what stands between a typo and a lost role.
# An idle keeper is ended first, as a reset does.
_as_role_delete() {
  local sb
  sb="$(_as_sandbox_dir)"
  if [[ ! -d "$sb" ]]; then
    _as_msg "role '${_role:-default}' has nothing stored"
    return 0
  fi
  if ! _as_keeper_stop_idle "$sb"; then
    _as_msg "role '${_role:-default}' is running; end it first with: $(_as_self_cmd --role "${_role:-default}" --shutdown)"
    return 1
  fi
  _as_holder_legacy_stop "$sb"
  # The chmod comes first: an overlay leaves <work>/work at mode 000, and du, unable to
  # read it, would fail -- ending this function under set -e with no message.
  local size
  chmod -R u+rwX -- "$sb" 2>/dev/null
  size="$(du -sh -- "$sb" 2>/dev/null | cut -f1)"
  rm -rf -- "$sb" || {
    _as_msg "role '${_role:-default}': could not remove all of $sb"
    return 1
  }
  _as_msg "role '${_role:-default}': deleted its stores (${size:-?}, $sb); the next launch starts from the source"
  return 0
}

# _as_role_status -- what --shutdown would end (#123, #126): the keeper (running since
# when, under which dot-file), the processes in its namespace -- a host-side view --
# and the background daemon's sessions, which only a join can ask for.
# shellcheck disable=SC2154
_as_role_status() {
  local sb kd spid since dot now
  sb="$(_as_sandbox_dir)" kd="$sb/keeper"
  if ! _as_keeper_live "$sb"; then
    if [[ -d "$sb" ]]; then
      printf "role '%s' of %s: not running; its stores (%s) are at %s\n" "${_role:-default}" "$_proj" \
        "$(du -sh -- "$sb" 2>/dev/null | cut -f1)" "$sb"
    else
      printf "role '%s' of %s: not running, and nothing stored\n" "${_role:-default}" "$_proj"
    fi
    return 0
  fi
  spid="$_keeper_spid"
  since="$(date -d "@$(stat -c %Y "$kd/id")" '+%F %T' 2>/dev/null)"
  dot="$(cat "$kd/dotfile" 2>/dev/null)"
  now="$(_as_keeper_dotfile_hash)"
  printf "role '%s' of %s: running since %s (supervisor pid %s)\n" "${_role:-default}" "$_proj" "$since" "$spid"
  if [[ "$dot" == - ]]; then
    printf '  dot-file: none approved when it started'
  else
    printf '  dot-file: the approved one of then (%s)' "${dot:0:12}"
  fi
  [[ "$dot" == "$now" ]] && printf '\n' || printf ', changed since\n'
  printf '  processes:\n'
  python3 - "$_keeper_target" <<'PY'
import os, sys
t = sys.argv[1]
ns = os.readlink(f"/proc/{t}/ns/pid")
for p in sorted((x for x in os.listdir("/proc") if x.isdigit()), key=int):
    try:
        if os.readlink(f"/proc/{p}/ns/pid") != ns or p == t:
            continue
        a = open(f"/proc/{p}/cmdline", "rb").read().split(b"\0")
    except OSError:
        continue
    cmd = " ".join(x.decode(errors="replace") for x in a if x)
    if cmd.startswith("bwrap "):
        continue  # the sandbox's own pid 1
    print(f"    {p:>8}  {cmd[:120]}")
PY
  if _as_keeper_daemon "$kd"; then
    if ((${#profile_status_argv[@]})); then
      printf '  background sessions:\n'
      _as_keeper_lock "$sb" && _as_keeper_live "$sb" || return 0
      _as_keeper_join "$sb" "$profile_bin" "${profile_status_argv[@]}" 2>&1 | sed 's/^/    /'
    fi
  else
    printf '  no background daemon\n'
  fi
  return 0
}

# _as_connect_report -- one line per channel that is not at its default, so a
# session can see what it was given. Routine state, like "using network mode
# from .agent-sandbox", so --quiet suppresses it; the REFUSALS above never are,
# and neither will the conflict warnings `copy` and `copy-on-write` bring.
_as_connect_report() {
  ((${#_connect_mode[@]})) || return 0
  local ch
  _as_info "connect: preset $_preset ($(_as_preset_mode "$_preset") for every channel this profile declares)"
  # Then only what differs from it. Listing all six every launch is how a report
  # becomes something nobody reads.
  for ch in "${!_connect_mode[@]}"; do
    [[ "${_connect_where[$ch]}" == "preset "* || "${_connect_where[$ch]}" == "built in"* ]] && continue
    if [[ "$ch" == */* ]]; then
      _as_info "connect: ${_connect_key[$ch]} = ${_connect_mode[$ch]} (${_connect_where[$ch]})"
    else
      _as_info "connect: $ch = ${_connect_mode[$ch]} native (${_connect_where[$ch]})"
    fi
  done
  return 0
}

# ----- briefing: the sandbox tells the agent what it may and may not do -----
# AGENT_SANDBOX_BRIEFING / [briefing] mode, on by default. A session that does
# not know it is sandboxed treats a deliberate block as a transient fault and
# spends turns working around it; worse, it never uses the access the user
# deliberately opened, so the grant costs effort and buys nothing. Two artefacts
# per launch, both bound READ-ONLY so the agent cannot rewrite its own briefing:
#   briefing.md          the full text, to read on demand
#   hook-*.json          a compact summary wrapped as a SessionStart /
#                        SubagentStart hook payload. The profile hands these to
#                        the agent (profiles/claude.sh), which re-reads them on
#                        every launch, resume and compaction -- so nothing here
#                        can go stale, and nothing is recorded in a system
#                        prompt that would outlive a policy change.
# Names and paths only, never contents: summarising shared material would mean
# reading it, which is another agent's job and out of scope.
_as_briefing_inside() { printf '/run/agent-sandbox'; }

# A JSON string literal for $1, in bash: no jq, no python on this path.
_as_json_str() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\n'/\\n}"
  printf '"%s"' "$s"
}

# Compose briefing.md and the two hook payloads into the session dir, and bind
# them read-only. Reads the resolved policy from agent_sandbox()'s locals.
_as_briefing_write() {
  _as_session_begin || return 1
  local inside net gal n_gal=0
  inside="$(_as_briefing_inside)"
  net="${_knob_net:-proxy}"
  gal="$(_as_config_dir)/allowlist.txt"
  local gal_desc
  if [[ -r "$gal" ]]; then
    n_gal="$(grep -cvE '^[[:space:]]*(#|$)' "$gal" 2>/dev/null || printf 0)"
    gal_desc="an allowlist of $n_gal hosts"
  else
    # Saying "0 hosts" would read as a policy; the file being absent is a
    # different thing, and worth naming so the user can be told which it is.
    gal_desc="an allowlist the sandbox could not read ($gal)"
  fi

  # every one of these gets a value below, but name them with defaults anyway:
  # agent_sandbox() runs under `set -euo pipefail`, so an unset variable is a
  # hard failure -- and an unknown net mode must still reach the network block's
  # own refusal rather than dying here.
  local egress="unknown" hosts_line="none" ssh_line="none"
  local mem_line="unknown" rw_line="" ro_line="none"
  case "$net" in
    # Both lines say HOW the filtering is enforced, not only that it is. A probe
    # run read `--share-net` out of the bwrap argv and concluded strict had no
    # network isolation and only "harness-level" filtering -- wrong on both
    # counts, and the sort of wrong conclusion that ends up in a report.
    # What is NOT said here: that proxy mode cannot filter a tool which ignores
    # HTTPS_PROXY. That limitation belongs in docs/design.md, which users read;
    # this text is read by the agent, and naming a gap to the party the gap
    # constrains invites the behaviour the briefing exists to discourage.
    proxy) egress="filtered. This sandbox shares the host's network namespace, and every request goes through an egress proxy that enforces $gal_desc. A refused host answers 403 naming itself -- deliberate, not an outage." ;;
    strict) egress="filtered, and there is no DNS and no route except the proxy. A name that does not resolve is the sandbox, not a broken network. The proxy enforces $gal_desc. This sandbox has its OWN network namespace (pasta forwards to the host in userspace) and nftables inside it allows only the proxy, so the limit is kernel-enforced rather than advisory: a tool that ignores HTTPS_PROXY has no route either." ;;
    open) egress="unfiltered (AGENT_SANDBOX_NET=open). No allowlist applies." ;;
    none) egress="none. The network namespace is unshared; nothing outside this machine is reachable." ;;
    *) egress="unknown ($net); this launch is about to be refused" ;;
  esac
  ((${#_allow_hosts[@]} > 0)) && hosts_line="${_allow_hosts[*]}"
  ((${#_ssh_hosts[@]} > 0)) && ssh_line="${_ssh_hosts[*]}"
  # two forms: the full one for briefing.md, a short one for the summary that is
  # injected on every launch (where a spare sentence is paid for every time)
  local mem_short
  case "${_memory_mode:-scoped}" in
    shared)
      mem_line="every project's memory and transcripts are visible"
      mem_short="every project is visible"
      ;;
    *) if ((${#_df_share[@]} > 0)); then
      mem_line="only this project, plus read-only memory of: ${_df_share[*]}"
      mem_short="this project, plus ${#_df_share[@]} shared read-only"
    else
      mem_line="only this project. Other projects are hidden behind a tmpfs"
      mem_short="hidden; only this project is visible"
    fi ;;
  esac
  rw_line="$cwd"
  [[ -n "${_knob_rw:-}" ]] && rw_line="$rw_line, ${_knob_rw//:/, }"
  [[ -n "${_knob_ro:-}" ]] && ro_line="${_knob_ro//:/, }"

  local sec="off"
  case "${_knob_seccomp:-}" in on | 1) sec="on: syscalls outside an allowlist fail with EPERM" ;; esac

  local ports=""
  if [[ "$net" == strict ]]; then
    ((${#_host_ports[@]} > 0)) && ports="host ports reachable: ${_host_ports[*]}. "
    ((${#_agent_ports[@]} > 0)) && ports="${ports}ports published to the host: ${_agent_ports[*]}. "
  fi

  # ONE DIRECTORY, bound read-only at $inside, rather than a bind per file: the
  # launch is a keeper that later joins also run in, and a join's own hook settings
  # (profile_briefing_args) must appear inside after the mounts are made.
  local bdir="$_session_dir/briefing"
  mkdir -p -- "$bdir" || return 1
  local md="$bdir/briefing.md"
  # The text below is literal: `$HOME` and the backticks name things for the
  # reader, they are not expansions.
  # shellcheck disable=SC2016
  {
    printf '# This session runs inside agent-sandbox\n\n'
    printf 'The limits below are the user'"'"'s policy for this project, enforced around\n'
    printf 'the agent rather than by it. Two things follow.\n\n'
    printf '1. A blocked action is deliberate. It is not a bug, not a transient fault\n'
    printf '   and not something to route around: retrying it, or reaching for another\n'
    printf '   tool to get past it, spends the budget and ends the same way.\n'
    printf '2. What is open was opened on purpose, by hand. Use it rather than working\n'
    printf '   around it.\n\n'
    printf '## Network\n\nEgress is %s\n\n' "$egress"
    printf -- '- hosts added for this session only (--allow): %s\n' "$hosts_line"
    printf -- '- SSH reachable through a constrained agent: %s\n' "$ssh_line"
    [[ -n "$ports" ]] && printf -- '- %s\n' "$ports"
    printf '\nThe allowlist itself lives on the host and is not readable from in here.\n'
    printf '\n## Filesystem\n\n'
    printf -- '- writable: %s\n' "$rw_line"
    printf -- '- extra read-only paths: %s\n' "$ro_line"
    printf -- '- everything else, /usr and /etc included, is read-only\n'
    printf -- '- $HOME is a fresh tmpfs; the host'"'"'s home directory is not here\n'
    printf '\n## Other projects\n\n%s.\n' "$mem_line"
    printf 'Other sessions leave state here too -- file snapshots, prompt history,\n'
    printf 'plans, pasted text -- and none of it is in this sandbox. What this\n'
    printf 'session writes is kept and merged back when it ends, so your own undo\n'
    printf 'history and prompt history survive a resume.\n'
    printf '\n## Syscall filter\n\nseccomp is %s.\n' "$sec"
    printf '\n## If you need something that is blocked\n\n'
    printf 'Stop and ask. You cannot widen this yourself: .agent-sandbox is\n'
    printf 'trust-gated so that an agent cannot grant itself access, and the trust\n'
    printf 'store is not bound into the sandbox. Tell the user, in one message:\n\n'
    printf -- '- what you need (host, path or project),\n'
    printf -- '- what it is for,\n'
    printf -- '- the exact lines to add to %s/.agent-sandbox, e.g.\n\n' "$cwd"
    printf '      [allow]\n      example.com\n\n'
    printf 'then ask them to run `asb --trust` in that directory and relaunch.\n'
    printf 'One clear request costs less than twenty workarounds.\n'
  } >"$md" || return 1

  local short
  short="agent-sandbox: this session is sandboxed and the limits are enforced outside the agent. Egress is ${egress%%.*}. Writable: ${rw_line}. Other projects: ${mem_short}. seccomp ${sec%%:*}. SSH: ${ssh_line}. A blocked action is deliberate, so do not retry it or route around it; what is open was opened on purpose, so use it. Details: $inside/briefing.md. If you need something blocked, stop and ask the user to add it to .agent-sandbox and re-run \`claude --trust\` -- you cannot widen this yourself."

  local ev
  for ev in SessionStart SubagentStart; do
    printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":%s}}\n' \
      "$ev" "$(_as_json_str "$short")" >"$bdir/hook-$ev.json" || return 1
  done

  args+=(--ro-bind "$bdir" "$inside")
  return 0
}

# ----- per-project config (.agent-sandbox) and its trust store -----
# A project may carry a .agent-sandbox file with per-project policy: `allow`
# hosts, `share-memory` project paths, `ro`/`rw` paths, `forward`ed variable
# names, `conda` settings, the `net` mode and strict-mode ports, and the
# `seccomp` mode. It is PARSED, never sourced. Because the project dir is writable by the sandboxed
# agent and a project may come from an untrusted repository, the file is
# honoured only after the user approves it with `--trust`: approval records
# the file's SHA-256, and any later edit or removal (by you or the agent)
# refuses launches from that directory until you review again (--trust) --
# refusing, not ignoring, because ignoring would fall back to the defaults,
# and a default can be wider than the policy you approved: a project pinning
# `[net] mode = strict` would drop to the default `proxy`, where a tool that
# ignores HTTPS_PROXY reaches the network unfiltered. So the agent can neither
# grant itself anything nor quietly get the defaults back; it can only stop
# the next launch until you look. A file with no approval on record (a cloned
# repo's) refuses in the same way (#143). The trust store and global config live under
# ~/.config/agent-sandbox, which is never bound into the sandbox, so the agent
# can neither read nor forge them.
_as_config_dir() { printf '%s' "$HOME/.config/agent-sandbox"; }
# Where install.sh puts the compiled seccomp filter for this machine.
_as_seccomp_dir() { printf '%s' "${AGENT_SANDBOX_SECCOMP_DIR:-$HOME/.local/share/agent-sandbox/seccomp}"; }
_as_sha256_file() { sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1; }
_as_sha256_str() { printf '%s' "$1" | sha256sum 2>/dev/null | cut -d' ' -f1; }

# Global default for memory scoping when a project has no trusted directive:
# `shared` (every project's memory visible -- the historical behaviour) or
# `scoped` (only the current project). ~/.config/agent-sandbox/config, key
# memory_default. Defaults to `scoped`: a session sees its own project's memory
# and transcripts and no other's, so the isolation the README promises holds
# without configuration. Set `memory_default = shared` to get the pre-0.2
# behaviour back for projects that have no dot-file.
_as_memory_default() {
  local cfg val="" line
  cfg="$(_as_config_dir)/config"
  if [[ -r "$cfg" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      [[ "$line" == *memory_default* ]] || continue
      val="${line#*=}"
      val="${val//[[:space:]]/}"
    done <"$cfg"
  fi
  case "$val" in
    scoped | shared) printf '%s' "$val" ;;
    *) printf 'scoped' ;;
  esac
}

# A strict-mode port opt-in token (--host-port / --agent-port, the knobs, the
# dot-file): a TCP port 1024-65535, or `none`. Ports below 1024 are refused:
# pasta cannot bind system ports unprivileged, and nothing the agent runs
# should sit on one. Prints why a token is bad.
_as_port_ok() { # $1 = label for messages, $2 = token
  local label="$1" t="$2"
  [[ "$t" == none ]] && return 0
  if [[ ! "$t" =~ ^[0-9]{1,5}$ ]] || ((10#$t > 65535)); then
    _as_msg "$label: bad port '$t' (expected a port 1024-65535, or none)"
    return 1
  fi
  if ((10#$t < 1024)); then
    _as_msg "$label: port $t refused (below 1024: pasta cannot bind system ports unprivileged)"
    return 1
  fi
  return 0
}

# Union of strict-mode port opt-ins from every source (flags, knob, dot-file)
# into the array named by $2, deduplicated in the order given. A `none` in any
# source empties it and sets the flag named by $3: one `none` closes that
# direction for the session whatever the other sources list. A bad token fails.
_as_ports_merge() { # $1 = label, $2 = out array name, $3 = out none-flag name, $4.. = tokens
  local label="$1"
  local -n _pm_out="$2" _pm_none="$3"
  shift 3
  local -a acc=()
  local t u seen
  for t in "$@"; do
    [[ -z "$t" ]] && continue
    _as_port_ok "$label" "$t" || return 1
    if [[ "$t" == none ]]; then
      _pm_none=1
      continue
    fi
    t=$((10#$t))
    seen=0
    for u in "${acc[@]}"; do [[ "$u" == "$t" ]] && seen=1; done
    ((seen)) || acc+=("$t")
  done
  if ((_pm_none)); then _pm_out=(); else _pm_out=("${acc[@]}"); fi
  return 0
}

# Echo the conda/mamba base prefix (where envs/ and pkgs/ live), or nothing.
# _as_path_swap_conda OLD_PREFIX NEW_PREFIX: the launching shell's PATH with
# OLD_PREFIX/bin replaced by NEW_PREFIX/bin, or NEW_PREFIX/bin prepended when the
# old one is not there (no env active, or a PATH we did not build). What
# `conda activate` does to PATH, so CONDA_PREFIX and PATH agree inside the sandbox.
_as_path_swap_conda() {
  local old="${1%/}/bin" new="${2%/}/bin" out="" p found=0
  local -a parts=()
  _as_split parts ':' "$PATH"
  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    if [[ "$p" == "$old" ]]; then
      p="$new"
      found=1
    elif [[ "$p" == "$new" ]]; then
      continue # keep exactly one copy, in the swapped position
    fi
    out="${out:+$out:}$p"
  done
  ((found)) || out="$new${out:+:$out}"
  printf '%s' "$out"
}

# Used to resolve a [conda] name = <env> from .agent-sandbox to <base>/envs/<env>.
_as_conda_base() {
  if [[ -n "${MAMBA_ROOT_PREFIX:-}" && -d "${MAMBA_ROOT_PREFIX}" ]]; then
    printf '%s' "$MAMBA_ROOT_PREFIX"
  elif [[ -n "${CONDA_ROOT_PREFIX:-}" && -d "${CONDA_ROOT_PREFIX}" ]]; then
    printf '%s' "$CONDA_ROOT_PREFIX"
  elif [[ -n "${CONDA_PYTHON_EXE:-}" && -x "${CONDA_PYTHON_EXE}" ]]; then
    printf '%s' "$(dirname "$(dirname "$CONDA_PYTHON_EXE")")"
  elif [[ "${CONDA_PREFIX:-}" == */envs/* ]]; then
    printf '%s' "${CONDA_PREFIX%/envs/*}"
  elif [[ -n "${CONDA_PREFIX:-}" && -d "${CONDA_PREFIX:-}/envs" ]]; then
    printf '%s' "$CONDA_PREFIX"
  else
    local b
    b="$({ command -v conda >/dev/null && conda info --base; } 2>/dev/null \
      || { command -v mamba >/dev/null && mamba info --base; } 2>/dev/null || true)"
    [[ -n "$b" && -d "$b" ]] && printf '%s' "$b"
  fi
  return 0 # a query: finding no base is not a failure (would trip set -e at the caller)
}

# Is the .agent-sandbox at $2 (for project dir $1) approved? Trust file is
# <config>/trust/<sha256(path)> holding the approved <sha256(content)>, and beside it
# <sha256(path)>.approved, the approved content itself, so that a later review can show
# what changed (#143). Inside a sandbox there is no gate at all (_as_inside_sandbox):
# the file there is what the outer launch approved, bound read-only, or a copy an
# inner agent changed -- and a nested sandbox can only narrow the one it is inside.
_as_dotfile_trusted() {
  local cwd="$1" file="$2" want have
  [[ -f "$file" ]] && _as_inside_sandbox && return 0
  want="$(_as_sha256_file "$file")"
  [[ -n "$want" ]] || return 1
  have="$(cat -- "$(_as_config_dir)/trust/$(_as_sha256_str "$cwd")" 2>/dev/null || true)"
  [[ -n "$have" && "$have" == "$want" ]]
}

# _as_inside_sandbox -- is this engine running inside one of its own sandboxes? Not the
# AGENT_SANDBOX marker alone: that is a UX hint any process can set, and a project's own
# shell setup (a direnv .envrc, say) setting it on the host must not switch the review
# off for the file that project ships. Pid 1 being bubblewrap is the part no process on
# the host can arrange: inside, the sandbox's pid namespace starts with it.
_as_inside_sandbox() {
  [[ -n "${AGENT_SANDBOX:-}" ]] || return 1
  local a0=""
  { IFS= read -r -d '' a0 </proc/1/cmdline; } 2>/dev/null || true
  [[ "$(basename -- "${a0:-/}")" == bwrap ]]
}

# _as_has_terminal -- can the user answer a question here? Decided by the terminal, not
# by the agent's flags: an `asb claude -p ...` typed at a shell can be asked (#143).
_as_has_terminal() { [[ -t 0 && -t 2 ]]; }

_as_trust_record() {
  local cwd="$1" file="$2" dir rec
  dir="$(_as_config_dir)/trust"
  mkdir -p "$dir" 2>/dev/null || {
    _as_msg "cannot create trust store $dir"
    return 1
  }
  rec="$dir/$(_as_sha256_str "$cwd")"
  cp -- "$file" "$rec.approved.tmp" && mv -f -- "$rec.approved.tmp" "$rec.approved" || return 1
  _as_sha256_file "$file" >"$rec" || return 1
  return 0
}

# _as_trust_forget CWD -- drop the approval of CWD's dot-file, hash and content.
_as_trust_forget() {
  local rec
  rec="$(_as_config_dir)/trust/$(_as_sha256_str "$1")"
  rm -f -- "$rec" "$rec.approved"
}

# _as_trust_show FILE -- a file as the review shows it: through cat -v, so nothing in
# it can act on the terminal.
_as_trust_show() {
  printf -- '----\n'
  cat -v -- "$1"
  printf -- '----\n'
}

# _as_trust_prompt CWD -- the review of CWD's .agent-sandbox (#143), as a launch and
# --trust both run it: what is there, against what was approved, and a question.
#   - changed since approved: the difference, approved -> now (the whole file, when the
#     approval is older than the kept content)
#   - new: the whole file
#   - gone, though one was approved: what was approved, and whether to forget it
# Returns 0 when approved (or forgotten), 1 when not. Reads the answer from stdin and
# writes everything else to stderr.
_as_trust_prompt() {
  local cwd="$1" file rec ans
  file="$cwd/.agent-sandbox"
  rec="$(_as_config_dir)/trust/$(_as_sha256_str "$cwd")"
  if [[ ! -f "$file" ]]; then
    [[ -f "$rec" ]] || return 1
    {
      printf '\nagent-sandbox: %s has no .agent-sandbox, but one was approved earlier' "$cwd"
      if [[ -f "$rec.approved" ]]; then
        printf ':\n'
        _as_trust_show "$rec.approved"
      else
        printf '.\n'
      fi
      printf 'Launching without it would put its policy (memory scoping, paths, ports, ...) back to the defaults.\n'
      printf 'agent-sandbox: forget that approval, and launch from here with the defaults? [y/N] '
    } >&2
    read -r ans || true
    case "$ans" in
      y | Y | yes | YES)
        _as_trust_forget "$cwd"
        _as_msg "approval forgotten; launches from here use the defaults."
        return 0
        ;;
    esac
    return 1
  fi
  _as_dotfile_clean "$file" || return 1
  {
    if [[ -f "$rec.approved" ]] && ! _as_dotfile_trusted "$cwd" "$file"; then
      printf '\n%s has changed since you approved it (by you, by the agent, or by a pull). What changed, approved -> now (through cat -v):\n----\n' "$file"
      diff -u --label approved --label now -- "$rec.approved" "$file" | cat -v
      printf -- '----\n'
    elif [[ -f "$rec" ]] && ! _as_dotfile_trusted "$cwd" "$file"; then
      printf '\n%s has changed since you approved it; the approved content was not kept (an earlier engine approved it), so here is all of it (sha256 %s, through cat -v):\n' "$file" "$(_as_sha256_file "$file")"
      _as_trust_show "$file"
    else
      printf '\n%s (sha256 %s; shown with cat -v, so a non-ASCII byte appears as M-x):\n' "$file" "$(_as_sha256_file "$file")"
      _as_trust_show "$file"
    fi
  } >&2
  _as_dotfile_trusted "$cwd" "$file" && _as_msg "this exact content is already approved."
  printf 'agent-sandbox: approve this .agent-sandbox for %s? [y/N] ' "$cwd" >&2
  read -r ans || true
  case "$ans" in
    y | Y | yes | YES) ;;
    *) return 1 ;;
  esac
  _as_trust_record "$cwd" "$file" || return 1
  _as_msg "approved."
  return 0
}

# Split a `key = value` line into the caller's ck (whitespace removed) and cv
# (trimmed). Used for the key/value sections ([conda], [net]).
# shellcheck disable=SC2034
_as_dotfile_kv() {
  ck="${1%%=*}" cv="${1#*=}"
  ck="${ck//[[:space:]]/}"
  cv="${cv#"${cv%%[![:space:]]*}"}"
  cv="${cv%"${cv##*[![:space:]]}"}"
}

# Parse the .agent-sandbox at $1 into the caller's _df_* arrays and scalars. An
# INI-like format: `[section]` headers (allow, share-memory, ro, rw, forward,
# conda, net, seccomp), one item per line beneath ([conda], [net] and [seccomp]
# take `key = value` lines), `#` starts a comment (whole-line or trailing),
# blank lines ignored.
# Data only -- lines are matched, never executed. One item per line means paths
# and hosts keep any spaces.
_as_dotfile_parse() {
  local file="$1" line section="" ck cv sglob="*"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" == '['*']' ]]; then
      section="${line#\[}"
      section="${section%]}"
      section="${section//[[:space:]]/}"
      # A ROLE SUFFIX, `[<section>:<glob>]`: that section for the roles the glob
      # matches, applied after the unsuffixed one, in file order, per key. Only
      # [sandbox] and [connect] take one so far; on any other section it is said
      # and the section is skipped, never quietly applied to every role.
      sglob="*"
      if [[ "$section" == *:* && "$section" != "$profile" ]]; then
        sglob="${section#*:}"
        section="${section%%:*}"
        case "$section" in
          sandbox | connect) _df_role_globs+=("$sglob") ;;
          *)
            _as_msg ".agent-sandbox: [$section:$sglob] -- [$section] does not take a role suffix yet (only [sandbox] and [connect] do); ignoring the section"
            section="-skip-"
            continue
            ;;
        esac
      fi
      case "$section" in
        allow | share-memory | ro | rw | forward | conda | net | seccomp | briefing | connect | overlay | sandbox) [[ "$section" == share-memory ]] && _df_share_set=1 ;;
        "$profile") ;; # a section named after the active profile; see below
        ssh) _as_msg ".agent-sandbox: [ssh] is not supported yet; ignoring (use --ssh on the command line)" ;;
        proxy-ca | profile-dir | session-base)
          _as_msg ".agent-sandbox: [$section] is not allowed here; it is a command-line/environment knob only"
          ;;
        *) _as_msg ".agent-sandbox: ignoring unknown section [$section]" ;;
      esac
      continue
    fi
    case "$section" in
      -skip-) ;;
      allow) _df_allow+=("$line") ;;
      share-memory) _df_share+=("${line/#\~/$HOME}") ;;
      ro) _df_ro+=("${line/#\~/$HOME}") ;;
      rw) _df_rw+=("${line/#\~/$HOME}") ;;
      forward) _df_forward+=("$line") ;;
      conda)
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [conda] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            name) _df_conda_name="$cv" ;;
            write) _df_conda_write="$cv" ;;
            pkgs) _df_conda_pkgs="${cv/#\~/$HOME}" ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [conda] key '$ck'" ;;
          esac
        fi
        ;;
      net)
        # The network mode, and strict-mode ports (validated with the flags and
        # knobs at launch).
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [net] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            mode) _df_net_mode="$cv" ;;
            host-port) _df_net_host_port+=("$cv") ;;
            agent-port) _df_net_agent_port+=("$cv") ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [net] key '$ck'" ;;
          esac
        fi
        ;;
      seccomp)
        # The syscall filter's state (validated with the knob at launch).
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [seccomp] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            mode) _df_seccomp_mode="$cv" ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [seccomp] key '$ck'" ;;
          esac
        fi
        ;;
      "$profile")
        # A section named after the ACTIVE profile. The engine does not
        # interpret these: it collects the pairs and hands them to the profile,
        # which is the only thing that knows what its agent keeps where. See
        # docs/profiles.md. A dot-file naming a different profile's section is
        # ignored as unknown, so [codex] in a claude run says nothing.
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [$profile] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          _df_profile_kv+=("$ck=$cv")
        fi
        ;;
      sandbox)
        # The sandbox's own key and position. `role` is parsed and reserved; only
        # `default` exists until roles land.
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [sandbox] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            preset) _df_preset_by+=("$sglob"$'\t'"$cv") ;;
            role)
              if [[ "$sglob" == "*" ]]; then
                _df_role="$cv"
              else
                _as_msg ".agent-sandbox: [sandbox:$sglob] role -- the default role is a key of the unsuffixed [sandbox] only; ignoring"
              fi
              ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [sandbox] key '$ck'" ;;
          esac
        fi
        ;;
      overlay)
        # What `copy-on-write` is implemented with (validated at launch, with the knob).
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [overlay] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            mode) _df_overlay_mode="$cv" ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [overlay] key '$ck'" ;;
          esac
        fi
        ;;
      connect)
        # channel = mode [source] [scope]. Collected here, validated at launch, with
        # the flag and the environment, so one code path decides every form.
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [connect] expects 'channel = mode [source] [scope]', ignoring: $line"
        else
          _df_connect+=("$sglob"$'\t'"$line")
        fi
        ;;
      briefing)
        # Whether to tell the agent what its sandbox allows (validated at launch).
        if [[ "$line" != *=* ]]; then
          _as_msg ".agent-sandbox: [briefing] expects 'key = value', ignoring: $line"
        else
          _as_dotfile_kv "$line"
          case "$ck" in
            mode) _df_briefing_mode="$cv" ;;
            *) _as_msg ".agent-sandbox: ignoring unknown [briefing] key '$ck'" ;;
          esac
        fi
        ;;
      ssh) ;;
      "") _as_msg ".agent-sandbox: ignoring '$line' before any [section]" ;;
      *) ;;
    esac
  done <"$file"
  return 0
}

# A .agent-sandbox must be plain text: tab, newline, printable ASCII and bytes
# outside ASCII (UTF-8 text) only. A control character -- ESC, carriage return,
# backspace, NUL, DEL -- could make a terminal hide or overwrite a line while
# --trust shows the file, and that review is where the trust decision is made;
# the format never needs one. Checked at review and again at launch.
_as_dotfile_clean() { # $1 = file
  if [[ -n "$(LC_ALL=C tr -d '\011\012\040-\176\200-\377' <"$1" 2>/dev/null | head -c1)" ]]; then
    _as_msg ".agent-sandbox contains control characters (a terminal could hide lines when showing it); refusing it." \
      "Remove them: 'cat -v' shows each as ^X. A Windows editor's carriage returns count too."
    return 1
  fi
  return 0
}

# The --trust command: the review a launch runs (_as_trust_prompt), without a launch
# after it, and so the form that works without a terminal (`printf y | asb --trust`).
# Also offers to keep the file out of git: it is machine-local.
_as_trust_review() {
  local cwd="$1" file ans
  file="$cwd/.agent-sandbox"
  if [[ ! -f "$file" && ! -f "$(_as_config_dir)/trust/$(_as_sha256_str "$cwd")" ]]; then
    _as_msg "no .agent-sandbox in $cwd"
    return 1
  fi
  if [[ -f "$file" ]] && ! _as_dotfile_clean "$file"; then
    _as_msg "not approved."
    return 1
  fi
  if ! _as_trust_prompt "$cwd"; then
    if [[ -f "$file" ]]; then
      _as_msg "not approved; launches from here refuse until it is."
    else
      _as_msg "kept; launches from here stay refused until the file is restored or the approval forgotten."
    fi
    return 0
  fi
  [[ -f "$file" ]] || return 0
  if git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$cwd" check-ignore -q .agent-sandbox 2>/dev/null; then
    local _ex
    _ex="$(git -C "$cwd" rev-parse --absolute-git-dir)/info/exclude"
    printf 'agent-sandbox: add .agent-sandbox to %s so it is not committed? [y/N] ' "$_ex" >&2
    read -r ans || true
    case "$ans" in
      y | Y | yes | YES) printf '/.agent-sandbox\n' >>"$_ex" && _as_msg "added to $_ex" ;;
    esac
  fi
  return 0
}

# The system CA bundle (Debian/Ubuntu/Arch, Fedora/RHEL, openSUSE), or fail.
_as_system_ca_bundle() {
  local cand
  for cand in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
    [[ -r "$cand" ]] && {
      printf '%s' "$cand"
      return 0
    }
  done
  return 1
}

# Trust the egress proxy's CA inside the sandbox only. The proxy terminates TLS
# with a CA mitmproxy generates on first start (~/.mitmproxy/mitmproxy-ca-cert.pem,
# or AGENT_SANDBOX_PROXY_CA). Rather than installing it into the host's trust
# store (root, and every host process would trust it), bind a bundle made of the
# system bundle plus that CA over the system bundle's path inside the sandbox.
# Everything in there trusts the proxy; nothing on the host does. The bundle is
# kept under the per-user session base and rebuilt from its inputs every launch.
_as_ca_bind() {
  local bundle ca base combined tmp
  ca="${AGENT_SANDBOX_PROXY_CA:-$HOME/.mitmproxy/mitmproxy-ca-cert.pem}"
  bundle="$(_as_system_ca_bundle)" || {
    _as_msg "warning — no system CA bundle found; the proxy CA cannot be trusted inside the sandbox"
    return 0
  }
  [[ -r "$ca" ]] || {
    _as_msg "warning — proxy CA '$ca' not found: HTTPS through the proxy will fail (run install.sh, or set AGENT_SANDBOX_PROXY_CA)"
    return 0
  }
  base="$(_as_session_base)"
  { mkdir -p "$base" 2>/dev/null && chmod 700 "$base"; } || {
    _as_msg "warning — cannot create $base; proxy CA not bound"
    return 0
  }
  combined="$base/ca-bundle.crt"
  # Rebuild every launch rather than caching on mtime. An mtime check cannot tell
  # that a cached bundle's proxy CA no longer matches the CA the egress proxy now
  # presents: a rotated CA whose file mtime is not newer than the cache would be
  # served stale, and every agent that verifies the proxy leaf then fails TLS
  # ("SSL certificate verification failed"). The inputs are small and the mv is
  # atomic, so an unconditional rebuild is cheap and closes that staleness hole.
  tmp="$(mktemp "$base/ca-bundle.XXXXXX")" || return 0
  cat "$bundle" "$ca" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$combined"
  args+=(--ro-bind "$combined" "$bundle")
  return 0
}

# Tools that ship their own CA bundle (conda/mamba, pip, a conda git, node, npm,
# cargo, anything honouring SSL_CERT_FILE) never read the system bundle, so in
# the modes that go through the proxy point every well-known override at it --
# inside the sandbox that path holds the bundle _as_ca_bind prepared. Names the
# caller set were forwarded already and are left alone.
_as_ca_env() {
  local bundle="${SSL_CERT_FILE:-}" var
  [[ -n "$bundle" ]] || bundle="$(_as_system_ca_bundle)" || {
    _as_msg "warning — no system CA bundle found; tools with a private CA store will not trust the proxy"
    return 0
  }
  for var in SSL_CERT_FILE REQUESTS_CA_BUNDLE CURL_CA_BUNDLE CONDA_SSL_VERIFY PIP_CERT \
    GIT_SSL_CAINFO NODE_EXTRA_CA_CERTS NPM_CONFIG_CAFILE CARGO_HTTP_CAINFO; do
    [[ -n "${!var+x}" ]] && continue
    args+=(--setenv "$var" "$bundle")
  done
  [[ -n "${SSL_CERT_DIR+x}" ]] || args+=(--setenv SSL_CERT_DIR "$(dirname -- "$bundle")")
  return 0
}

# With per-session state (an ssh agent to kill, an --allow file to remove)
# bash must outlive bwrap to clean up, so it cannot exec. Otherwise exec.
# Print, to stderr, a footer pointing at --engine-help. Shown after the agent's
# own --help so a user who only knows the `claude` command can discover the
# sandbox's flags. Uses the caller's profile_command and invoked (dynamic scope).
_as_engine_help_footer() {
  {
    printf -- '---\n'
    printf 'agent-sandbox: the help above is %s'"'"'s own. It runs inside a sandbox;\n' "$profile_command"
    printf 'for the sandbox'"'"'s flags (--allow, --ssh, --trust) run: %s --engine-help\n' "$invoked"
  } >&2
}

# For AGENT_SANDBOX_NET=strict: turn the --ssh endpoints (_ssh_endpoints, "host
# port" pairs captured by _as_ssh_setup) into nft accept rules and an /etc/hosts
# the sandbox can resolve without DNS. Runs on the HOST. Each host is resolved
# to its IPv4 address(es) and ALL are pinned (so a round-robin rotation within
# the session still lands on an allowed address); IPv6 is not supported yet.
# Sets the caller's _ssh_nftrules (nft chain lines) and binds a combined
# /etc/hosts. The socket, known_hosts and the destination constraint are already
# handled by _as_ssh_setup; this only opens the firewall to the named hosts and
# lets their names resolve.
_as_strict_ssh_rules() {
  _ssh_nftrules=""
  ((${#_ssh_endpoints[@]})) || return 0
  command -v getent >/dev/null || {
    _as_msg "strict --ssh needs 'getent' to resolve hosts and pin the firewall; not found."
    return 1
  }
  local ep host port ips ip hosts_extra=""
  for ep in "${_ssh_endpoints[@]}"; do
    host="${ep% *}" port="${ep#* }"
    ips="$(getent ahostsv4 "$host" 2>/dev/null | awk '{print $1}' | sort -u)"
    [[ -n "$ips" ]] || {
      _as_msg "strict --ssh: cannot resolve '$host' to an IPv4 address to pin the firewall (IPv6-only is not supported yet)."
      return 1
    }
    while IFS= read -r ip; do
      [[ -z "$ip" ]] && continue
      printf -v _ssh_nftrules '%s  ip daddr %s tcp dport %s accept\n' "$_ssh_nftrules" "$ip" "$port"
      hosts_extra+="$ip $host"$'\n'
    done <<<"$ips"
    _as_msg "strict --ssh: $host reachable at $(tr '\n' ' ' <<<"$ips")on port $port (direct, outside the proxy)"
  done
  # Names cannot be resolved by DNS in strict mode (the firewall drops it), so
  # bind the host's /etc/hosts plus these mappings over /etc/hosts inside.
  local hostsfile="$_session_dir/etc-hosts"
  {
    [[ -r /etc/hosts ]] && cat /etc/hosts
    printf '%s' "$hosts_extra"
  } >"$hostsfile" || {
    _as_msg "strict --ssh: cannot write $hostsfile"
    return 1
  }
  args+=(--ro-bind "$hostsfile" /etc/hosts)
  return 0
}

# _as_resolve_bin WORD -- set profile_bin to the agent WORD names (#151): a path
# (`/path/to/2.1.284`, `./build/claude`), or a name looked up on PATH as a shell would.
# Resolved through symlinks, because that is what is bound inside and executed there:
# the native installer's ~/.local/bin/claude is a link into its versions/, and bwrap
# refuses to bind over a symlink. A PATH entry that resolves to this engine is a
# launcher an earlier install left (see the refusal in agent_sandbox); it is passed
# over, with a note, and the agent is the next one on PATH -- as is a link to any other
# copy of the engine (the installed one, when this is a checkout's): recognised the way
# install.sh recognises its own, a file named agent-sandbox that defines agent_sandbox().
# Reads the caller's engine and invoked by dynamic scope.
# shellcheck disable=SC2154
_as_resolve_bin() {
  local w=$1 d c r shadow=""
  profile_bin=""
  if [[ "$w" == */* ]]; then
    if [[ -f "$w" && -x "$w" ]]; then
      profile_bin="$(readlink -f -- "$w")"
    else
      _as_msg "'$w' is not an executable file"
      return 1
    fi
  else
    local -a _dirs
    _as_split _dirs : "$PATH"
    for d in "${_dirs[@]}"; do
      # An empty entry means the current directory, which in a project is the
      # project's own files: not a place to pick up the agent from.
      [[ -n "$d" ]] || continue
      c="$d/$w"
      [[ -f "$c" && -x "$c" ]] || continue
      r="$(readlink -f -- "$c")"
      if [[ "$r" == "$engine" ]] || { [[ "$(basename -- "$r")" == agent-sandbox ]] && grep -qE '^agent_sandbox\(\)' "$r" 2>/dev/null; }; then
        shadow="$c"
        continue
      fi
      profile_bin="$r"
      break
    done
    [[ -n "$shadow" ]] \
      && _as_msg "note: $shadow is a launcher an earlier install.sh left (#151); install.sh removes it and puts back the '$w' you had"
    if [[ -z "$profile_bin" ]]; then
      _as_msg "no '$w' on PATH to run. Install the agent, or name its binary: $invoked --profile $profile /path/to/$w"
      return 1
    fi
  fi
  return 0
}

# _as_self_cmd [FLAGS...] -- the command line that runs this engine for this profile
# with FLAGS, for a message to print: `asb --reset skills claude`. The profile's own
# spelling -- --profile when that is how it was chosen, else the command as typed.
# Reads the caller's invoked, profile, _cmd_word and _profile_given by dynamic scope.
# shellcheck disable=SC2154
_as_self_cmd() {
  printf '%s' "$invoked"
  (($# == 0)) || printf ' %s' "$@"
  if ((_profile_given)) || [[ -z "$_cmd_word" ]]; then
    printf ' --profile %s' "$profile"
  else
    printf ' %s' "$_cmd_word"
  fi
}

# If the sandbox itself cannot start, say so, and name the way to a working agent:
# the agent itself, which agent-sandbox never touches and nothing shadows (#151), run
# directly. Deliberately not a `--no-sandbox` flag: the way out should be documented
# and discoverable, not ergonomic, or it becomes the habit rather than the last
# resort.
_as_fallback_hint() {
  _as_msg "the sandbox did not start, so '$profile_command' cannot run in it. The agent itself is not affected; to run it without the sandbox -- to fix this, for instance:"
  _as_msg "  $profile_command    ($profile_bin)"
  _as_msg "See docs/troubleshooting.md, section 'The sandbox will not start'."
}

# _as_launch -- -- CMD... -- start the keeper that ${_launch[@]} names and join CMD
# into it; return CMD's status. Every launch is a keeper (see the keeper section).
# shellcheck disable=SC2154
_as_launch() {
  shift # the --
  local rc=0
  # The payload: `sleep` under the marker as its argv[0] (bwrap's --argv0 is newer
  # than the oldest bubblewrap this supports). The environment a join inherits is
  # read from it, so the shell that sets argv[0] takes back what it added: PWD and
  # OLDPWD here, and SHLVL, which `exec` sets anyway, is dropped by every join.
  # shellcheck disable=SC2016 # $0 is the payload shell's own, inside the sandbox
  _as_keeper_start "$_keeper_sb" _as_keeper_exec "${_launch[@]}" -- \
    bash -c 'unset PWD OLDPWD; exec -a "$0" sleep infinity' "$_as_keeper_marker" || rc=$?
  if ((rc)); then
    _as_keeper_unlock
    ((rc == 126 || rc == 127)) && _as_fallback_hint
    return "$rc"
  fi
  # The launch's exit is the supervisor's now: it removes the session directory, stops
  # the ssh agent and removes the mount-point files once the keeper ends.
  trap - EXIT INT TERM HUP
  _session_dir="" _ssh_agent_pid="" _as_placeholder_files=()
  ((_do_exec)) || ! declare -F profile_before_join >/dev/null || profile_before_join "$@"
  _as_keeper_join "$_keeper_sb" "$@" || rc=$?
  [[ -n "${_help_footer:-}" ]] && _as_engine_help_footer
  return "$rc"
}

# _as_keeper_exec LAUNCH... -- the keeper's launch, as the supervisor runs it: in a
# session of its own, so nothing the terminal sends reaches it, with the syscall
# filter on fd 10 where bwrap (or the strict wrapper) reads it.
_as_keeper_exec() {
  exec setsid "$@" 10<"${_seccomp_bpf:-/dev/null}"
}

# Launch for strict mode. pasta owns the network namespace and forwards it to
# the host in userspace, so the sandbox has no direct route out; an nftables
# rule installed in that netns drops everything except the proxy on the gateway.
# bwrap then makes its OWN child user namespace (via --unshare-all in args) and
# shares pasta's netns, so the agent -- root only in bwrap's userns -- has no
# authority over the netns (owned by pasta's parent userns) and cannot alter the
# firewall. The rule is installed before bwrap execs, so there is no window with
# open egress; a failed rule refuses the launch. See docs/network.md and issue #1.
#
# The gateway is read INSIDE the netns (ip route in the wrapper), not guessed
# from the host's routes: pasta configures the netns's own default route and maps
# that gateway to the host, and it can differ from the host's (a VPN default via
# a point-to-point interface, or an IPv6-only default route). The wrapper builds
# the nft rule and the agent's proxy variables from the address pasta actually
# used, and refuses if the netns has no IPv4 gateway.
#
# pasta's port forwarding is off in both directions unless the user opened
# ports: $2 is the -T spec (host TCP ports the sandbox may reach at 127.0.0.1,
# or none) and $3 the -t spec (agent TCP ports published at the host's
# 127.0.0.1, or none); UDP stays off. pasta's defaults ("auto") would bind
# every port listening on the host inside the netns, which the lo accept rule
# below lets the agent reach, and publish every sandbox listener on the host.
# Verified on Ubuntu 24.04 (passt 2024-02-20): with the defaults a host-only
# 127.0.0.1 listener was reachable from inside and a sandbox listener appeared
# on the host; with none, neither.
# $1 = nft binary path, $2 = extra nft chain lines (strict --ssh host pinholes,
# or empty), $3 = per-session proxy token (userinfo for the proxy URL, or empty),
# $4 = -T spec, $5 = -t spec, $6 = seccomp filter path (or empty), $7.. = the full
# "bwrap ... -- agent" line.
_as_launch_pasta() {
  local nftbin="$1" sshrules="$2" proxy_auth="$3" tcp_ns="$4" tcp_host="$5" seccomp_bpf="$6"
  shift 6
  # The bash -c body runs inside pasta's netns, before bwrap; its $vars expand
  # there, not here. $sshrules (built on the host from --ssh, already resolved to
  # IPs) is spliced into the chain after the proxy rule.
  # shellcheck disable=SC2016
  _launch=(pasta --config-net --quiet -T "$tcp_ns" -U none -t "$tcp_host" -u none -- bash -c '
    nftbin=$1 sshrules=$2 auth=$3 bpf=$4
    shift 4
    ipbin=$(command -v ip 2>/dev/null || true)
    [ -n "$ipbin" ] || for c in /usr/sbin/ip /sbin/ip; do [ -x "$c" ] && ipbin=$c && break; done
    gw=$([ -n "$ipbin" ] && "$ipbin" -4 route show default 2>/dev/null | sed -n "s/.*via \([0-9.]*\).*/\1/p" | head -1)
    if [ -z "$gw" ]; then
      echo "agent-sandbox: strict mode found no IPv4 gateway inside the network namespace, so there is no route to the proxy; refusing to launch." >&2
      exit 1
    fi
    printf "table inet agent_sandbox {\n chain output {\n  type filter hook output priority 0; policy drop\n  oifname \"lo\" accept\n  ip daddr %s tcp dport 8888 accept\n%s }\n}\n" "$gw" "$sshrules" | "$nftbin" -f - || {
      echo "agent-sandbox: strict-mode egress firewall failed to load; refusing to launch" >&2
      exit 1
    }
    bwrapbin=$1
    shift
    pxy="http://${auth:+$auth@}$gw:8888"
    # The proxy env must be set AFTER the base args reach their --clearenv, or
    # bwrap clears it and the agent launches with no proxy -- it then resolves
    # api.anthropic.com directly, which strict mode has no DNS route for, and
    # fails with ENOTFOUND. Split the bwrap options from the "-- command" tail
    # and insert the proxy env between them, past --clearenv.
    opts=()
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
      opts+=("$1")
      shift
    done
    # fd 10 carries the seccomp filter when AGENT_SANDBOX_SECCOMP is on (else /dev/null).
    exec "$bwrapbin" "${opts[@]}" \
      --setenv HTTP_PROXY "$pxy" --setenv HTTPS_PROXY "$pxy" \
      --setenv http_proxy "$pxy" --setenv https_proxy "$pxy" \
      "$@" 10<"${bpf:-/dev/null}"
  ' agent-sandbox-strict "$nftbin" "$sshrules" "$proxy_auth" "$seccomp_bpf" "$@")
}

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------
agent_sandbox() (
  set -euo pipefail

  local engine profile_dir invoked connect_sync
  engine="$(readlink -f -- "${BASH_SOURCE[0]}")"
  profile_dir="${AGENT_SANDBOX_PROFILE_DIR:-$(dirname -- "$engine")/profiles}"
  # The `copy` mode's three-way sync. Beside the engine in BOTH layouts: the
  # checkout has components/ at its root, and install.sh writes the same file
  # into the app directory next to the engine it copies there. The override is
  # for the tests, which run the engine from a checkout but should not depend
  # on the checkout's own copy being the one under test.
  connect_sync="${AGENT_SANDBOX_CONNECT_SYNC:-$(dirname -- "$engine")/components/connect-sync.py}"
  invoked="$(basename -- "$0")"

  # ---- engine flags (must precede the agent's own arguments) ----
  # See ENGINE FLAGS in the header and docs/ssh.md. Parsing stops at the
  # first token that is not one of ours; everything from there on is passed
  # to the agent untouched.
  local profile=""
  local -a _ssh_hosts=() _allow_hosts=() _host_ports=() _agent_ports=()
  local _ssh_unrestricted=0 _ssh_key="" _ssh_timeout="" _ssh_want=0 _do_trust=0 _do_engine_help=0
  local _host_none=0 _agent_none=0 _do_exec=0 _do_quiet=0 _do_shutdown=0 _do_delete=0 _do_status=0
  local _user_mcp_flag="" _user_mcp_flag_set=0
  # Connections: the resolved channel -> mode map, and where each came from, so
  # a refusal or a report can name the source the user has to go and edit.
  # `_role` is the sandbox key's second half; only `default` exists until roles
  # land, and the directory level is here so that arriving changes no layout.
  local -A _connect_mode=() _connect_where=() _connect_scope=()
  # Path declarations, in the order declared: the resolved path, what the user
  # wrote, and whether they wrote a trailing slash.
  local -a _connect_paths=()
  local -A _connect_key=() _connect_isdir=()
  local _path_key
  local -a _connect_flag=()
  # The command line that runs the sandbox: bwrap, or pasta running bwrap. Set by the
  # network mode, run by _as_launch.
  local -a _launch=()
  # The join-scoped paths the launch declares (#147): `kind<TAB>name<TAB>path`.
  local -a _join_scoped=()
  local _join_stage_bound=0
  local _role=default _reset_connection="" _overlay_flag="" _overlay_mode=auto
  local _preset_flag="" _preset=inherit _role_flag="" _role_flag_set=0
  while (($# > 0)); do
    case "$1" in
      --profile)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--profile needs a name"
            return 2
          }
        profile="$2"
        shift 2
        ;;
      --profile=?*)
        profile="${1#--profile=}"
        shift
        ;;
      --quiet)
        _do_quiet=1
        shift
        ;;
      --exec)
        # Run a command INSTEAD of the agent, in the sandbox this profile would
        # have built for it: same binds, environment, network, seccomp and state
        # isolation. Everything after --exec is that command and its arguments,
        # so engine flags must precede it -- the same rule agent flags already
        # follow, since the loop below breaks at the first unrecognised word.
        _do_exec=1
        shift
        break
        ;;
      --allow)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--allow needs a host (hostname, or .domain for a domain and its subdomains)"
            return 2
          }
        _allow_hosts+=("$2")
        shift 2
        ;;
      --allow=?*)
        _allow_hosts+=("${1#--allow=}")
        shift
        ;;
      --ssh)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--ssh needs a host (hostname, user@host, or ~/.ssh/config alias)"
            return 2
          }
        _ssh_hosts+=("$2")
        shift 2
        ;;
      --ssh=?*)
        _ssh_hosts+=("${1#--ssh=}")
        shift
        ;;
      --ssh-unrestricted)
        _ssh_unrestricted=1
        shift
        ;;
      --ssh-key)
        [[ $# -ge 2 && -n "$2" ]] || {
          _as_msg "--ssh-key needs a path"
          return 2
        }
        _ssh_key="$2"
        shift 2
        ;;
      --ssh-key=?*)
        _ssh_key="${1#--ssh-key=}"
        shift
        ;;
      --ssh-timeout)
        [[ $# -ge 2 && -n "$2" ]] || {
          _as_msg "--ssh-timeout needs a lifetime (seconds, or e.g. 30m)"
          return 2
        }
        _ssh_timeout="$2"
        shift 2
        ;;
      --ssh-timeout=?*)
        _ssh_timeout="${1#--ssh-timeout=}"
        shift
        ;;
      --host-port | --agent-port)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "$1 needs a port (1024-65535), or none"
            return 2
          }
        if [[ "$1" == --host-port ]]; then _host_ports+=("$2"); else _agent_ports+=("$2"); fi
        shift 2
        ;;
      --host-port=?*)
        _host_ports+=("${1#--host-port=}")
        shift
        ;;
      --agent-port=?*)
        _agent_ports+=("${1#--agent-port=}")
        shift
        ;;
      --engine-help)
        _do_engine_help=1
        shift
        ;;
      --engine-version)
        _as_version
        return 0
        ;;
      --trust)
        _do_trust=1
        shift
        ;;
      --sandbox)
        # Removed with the wrapper machinery (#123): foreground and background
        # sessions both run in the role's sandbox, so there is no scope to choose.
        # Running without a sandbox is the `none` preset, typed per launch.
        _as_msg "--sandbox was removed: every session, --bg included, runs in its role's sandbox (#123). To run without one: --preset none"
        return 2
        ;;
      --sandbox=*)
        _as_msg "--sandbox was removed: every session, --bg included, runs in its role's sandbox (#123). To run without one: --preset none"
        return 2
        ;;
      --user-mcp)
        # Whether the claude profile carries the host's user-level mcpServers
        # into this project's copy of the config file (inherit, the default) or
        # leaves them out (none). A narrowing, so a launch-time choice like
        # --sandbox; the dot-file form is [claude] user-mcp. See the profile's
        # _claude_user_mcp_refuse: the knob is removed, and refused (#132).
        [[ $# -ge 2 && -n "$2" ]] || {
          _as_msg "--user-mcp needs a value (inherit or none)"
          return 2
        }
        _user_mcp_flag="$2"
        _user_mcp_flag_set=1
        shift 2
        ;;
      --user-mcp=*)
        _user_mcp_flag="${1#--user-mcp=}"
        _user_mcp_flag_set=1
        shift
        ;;
      --connect)
        # One `channel = mode [source] [scope]`, repeatable. The highest-precedence
        # form: it beats AGENT_SANDBOX_CONNECT and an approved dot-file, the
        # same order --user-mcp already follows.
        [[ $# -ge 2 && -n "$2" ]] \
          || {
            _as_msg "--connect needs a spec, e.g. --connect 'instructions=read-only native'"
            return 2
          }
        _connect_flag+=("$2")
        shift 2
        ;;
      --connect=*)
        _connect_flag+=("${1#--connect=}")
        shift
        ;;
      --reset)
        # Throw away what this role has at one channel or path declaration and take
        # the source's again, keeping the rest (#126). The supported way back, and the
        # one the conflict warning points at. Does its work and exits; it never
        # launches the agent, so it cannot be confused with "reset and then run".
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--reset needs a channel name or a declared path"
            return 2
          }
        _reset_connection="$2"
        shift 2
        ;;
      --reset=*)
        _reset_connection="${1#--reset=}"
        shift
        ;;
      --reset-connection)
        # Renamed in 0.4 (#126), refused with the new name as the 0.3 renames were.
        _as_msg "--reset-connection was renamed: write --reset (it takes a declared path too)"
        return 2
        ;;
      --reset-connection=*)
        _as_msg "--reset-connection was renamed: write --reset (it takes a declared path too)"
        return 2
        ;;
      --delete)
        # Remove every store of the role (#126). Refused while anything holds it.
        _do_delete=1
        shift
        ;;
      --status)
        # What --shutdown would end: the keeper, what runs in it, the daemon's sessions.
        _do_status=1
        shift
        ;;
      --overlay)
        # What `copy-on-write` is implemented WITH. `off` forces the copy fallback on a
        # host that could mount an overlay; it can only move `copy-on-write` to `copy`,
        # which is a step down the scale, so it is never trust-gated.
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--overlay needs a value (auto or off)"
            return 2
          }
        _overlay_flag="$2"
        shift 2
        ;;
      --overlay=*)
        _overlay_flag="${1#--overlay=}"
        shift
        ;;
      --role)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--role needs a name"
            return 2
          }
        _role_flag="$2" _role_flag_set=1
        shift 2
        ;;
      --role=*)
        _role_flag="${1#--role=}" _role_flag_set=1
        shift
        ;;
      --preset)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--preset needs a name (independent, default or shared)"
            return 2
          }
        _preset_flag="$2"
        shift 2
        ;;
      --preset=*)
        _preset_flag="${1#--preset=}"
        shift
        ;;
      --wrap)
        # Removed with the wrapper machinery (#123). A background daemon an earlier
        # engine started still has CLAUDE_CODE_PROCESS_WRAPPER pointing here, so its
        # workers arrive with this flag: say what to do instead of running them.
        _as_msg "--wrap was removed: background sessions now run inside their role's sandbox (#123). A Claude Code background daemon started by an earlier agent-sandbox is still running with CLAUDE_CODE_PROCESS_WRAPPER set; stop it (claude daemon stop) and start --bg sessions again, with asb claude --bg."
        return 2
        ;;
      --shutdown)
        # End the role's launch: its keeper, everything joined into it, and a
        # background daemon with its pool (#123, #126). Does its work and exits.
        _do_shutdown=1
        shift
        ;;
      *) break ;;
    esac
  done
  # ---- invoked through a launcher named after a profile: removed (#151) ----
  # Earlier installs put this engine at ~/.local/bin/claude, so that `claude` meant
  # the sandboxed agent. It no longer does: `claude` is Claude Code itself again, and
  # the sandbox is asked for by name. Refused rather than run either way -- sandboxed
  # would keep the ambiguity alive, native would quietly drop the sandbox someone
  # typed `claude` expecting.
  # Only a profile's name is that launcher: any other name for the engine -- asb, an
  # alias of the user's own -- is the engine asked for by name.
  if [[ "${BASH_SOURCE[0]}" == "$0" && "$invoked" != "$(basename -- "$engine")" && -r "$profile_dir/$invoked.sh" ]]; then
    _as_msg "agent-sandbox is no longer run as '$invoked' (#151): '$invoked' is the agent itself again, and a sandboxed launch is: asb $invoked"
    _as_msg "$0 is a launcher an earlier install.sh left. Run install.sh again: it puts back the '$invoked' you had, and installs asb."
    return 2
  fi
  # ---- the command (#151): asb [ENGINE FLAGS] CMD [AGENT ARGS] ----
  # The loop above stopped at the first word that is not the engine's. That word is
  # CMD, the agent -- a name looked up on PATH or a path -- and everything after it is
  # the agent's. No CMD is right for a verb, which needs a profile but no launch
  # (`asb --profile claude --status`), and under --exec, where the words are another
  # command's. A word starting with `-` there is an option the engine does not have.
  local _cmd_word="" _profile_given=0
  [[ -n "$profile" ]] && _profile_given=1
  if ((! _do_exec)) && (($# > 0)); then
    case "$1" in
      -h | --help) ;;
      -*)
        _as_msg "'$1' is not an option of agent-sandbox. Its options come before the command, and the agent's after it: $invoked [ENGINE FLAGS] CMD [AGENT ARGS], e.g. $invoked --role reviewer claude -r"
        return 2
        ;;
      *)
        _cmd_word="$1"
        shift
        ;;
    esac
  fi
  # Resolve quiet before anything routine is printed: the dot-file notices, the
  # session allowlist and the seccomp line all come later, but the ssh-agent
  # status does not wait long.
  case "${AGENT_SANDBOX_QUIET:-}" in
    "" | off | 0) ;;
    on | 1) _as_quiet=1 ;;
    *)
      _as_msg "AGENT_SANDBOX_QUIET='$AGENT_SANDBOX_QUIET' is not recognised (use 'on' or 'off')"
      return 2
      ;;
  esac
  ((_do_quiet)) && _as_quiet=1
  if ((_do_exec)); then
    [[ $# -ge 1 ]] || {
      _as_msg "--exec needs a command, e.g. --exec bash -l"
      return 2
    }
  fi
  ((${#_ssh_hosts[@]} > 0 || _ssh_unrestricted)) && _ssh_want=1
  if ((_ssh_unrestricted && ${#_ssh_hosts[@]} > 0)); then
    _as_msg "--ssh-unrestricted and --ssh HOST are mutually exclusive"
    return 2
  fi
  if ((! _ssh_want)) && [[ -n "$_ssh_key$_ssh_timeout" ]]; then
    _as_msg "--ssh-key / --ssh-timeout need --ssh HOST or --ssh-unrestricted"
    return 2
  fi
  if [[ -n "$_ssh_timeout" && ! "$_ssh_timeout" =~ ^[0-9]+[smhdwSMHDW]?$ ]]; then
    _as_msg "--ssh-timeout: bad lifetime '$_ssh_timeout' (seconds, or e.g. 30m, 2h)"
    return 2
  fi
  if [[ -n "$_ssh_key" && ! -r "$_ssh_key" ]]; then
    _as_msg "--ssh-key: cannot read '$_ssh_key'"
    return 2
  fi
  local _hostre='^\.?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)*[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$' _h
  for _h in "${_allow_hosts[@]}"; do
    [[ "$_h" =~ $_hostre ]] || {
      _as_msg "--allow: bad host '$_h' (expected a hostname, or .domain)"
      return 2
    }
  done
  for _h in "${_host_ports[@]}"; do _as_port_ok --host-port "$_h" || return 2; done
  for _h in "${_agent_ports[@]}"; do _as_port_ok --agent-port "$_h" || return 2; done

  # ---- --engine-help: the engine's own usage, even with a profile selected ----
  if ((_do_engine_help)); then
    _as_usage
    return 0
  fi
  # A footer pointing at --engine-help is appended after the agent's own --help.
  local _help_footer=""
  [[ "${1:-}" == -h || "${1:-}" == --help ]] && _help_footer=1

  # ---- --trust: review and approve the current project's .agent-sandbox ----
  # Profile-independent; never launches the agent.
  if ((_do_trust)); then
    _as_trust_review "$(pwd -P)"
    return $?
  fi

  # ---- profile ----
  # --profile wins; otherwise CMD's basename names it (`claude`, `/usr/bin/claude`).
  # A basename that names no profile -- a versioned binary, say -- needs --profile.
  if [[ -z "$profile" && -n "$_cmd_word" ]]; then
    profile="$(basename -- "$_cmd_word")"
    if [[ ! "$profile" =~ ^[a-z][a-z0-9_-]*$ || ! -r "$profile_dir/$profile.sh" ]]; then
      _as_msg "'$_cmd_word' names no profile. Say which one runs it: $invoked --profile NAME $_cmd_word"
      _as_msg "profiles available in $profile_dir: $(_as_list_profiles "$profile_dir")"
      return 2
    fi
  fi
  if [[ -z "$profile" ]]; then
    case "${1:-}" in -h | --help)
      _as_usage
      return 0
      ;;
    esac
    if ((_do_exec)); then
      _as_msg "--exec needs the profile whose sandbox it runs in: $invoked --profile NAME --exec $1"
    else
      _as_msg "no command. Name the agent to run: $invoked [ENGINE FLAGS] CMD [AGENT ARGS], e.g. $invoked claude"
    fi
    _as_msg "profiles available in $profile_dir: $(_as_list_profiles "$profile_dir")"
    return 2
  fi
  [[ "$profile" =~ ^[a-z][a-z0-9_-]*$ ]] || {
    _as_msg "bad profile name '$profile'"
    return 2
  }
  local profile_file="$profile_dir/$profile.sh"
  [[ -r "$profile_file" ]] \
    || {
      _as_msg "no profile '$profile' ($profile_file not found). Available: $(_as_list_profiles "$profile_dir")"
      return 2
    }

  # Contract defaults; the profile overrides what it needs. The contract is
  # documented in profiles/claude.sh.
  # These are the profile contract: set here as defaults, read by the sourced
  # profile and (profile_allowlist_seed) by install.sh; not all are used here.
  # shellcheck disable=SC2034
  local AGENT_SANDBOX_ENGINE="$engine" AGENT_SANDBOX_PROFILE="$profile" AGENT_SANDBOX_PROFILE_DIR="$profile_dir"
  # shellcheck disable=SC2034
  local profile_command="$profile" profile_allowlist_seed="" profile_bin="" profile_version=""
  local -a profile_config_binds=() profile_env_pass=() profile_env_set=() profile_env_refuse=()
  local -a profile_host_subcommands=()
  # Background service (#123): the verbs that join the role's launch and never start
  # one (the observing ones answer "not running" when there is none), and the argv
  # tokens that mark the daemon, which holds the role's keeper while it runs.
  local -a profile_verbs=() profile_verbs_observe=() profile_daemon_argv=()
  # What --status joins to list the daemon's sessions (claude: `agents`).
  local -a profile_status_argv=()
  local -a profile_tmpfs=() profile_rw_binds=() profile_ro_binds=() profile_late_rw_binds=()
  # The profile's channel map: `channel<TAB>kind:path...` (profile contract 3).
  local -a profile_channels=()
  local -a profile_isolate_spec=()
  # Mount-point files the state binds create on the host (see that loop); the
  # cleanup removes them. Declared with _session_dir, for the same reason.
  local -a _as_placeholder_files=()
  # Declared HERE, not down with the launch locals: state isolation opens the
  # session dir well before that point, and a later `local _session_dir=""`
  # would reset it -- so _as_session_begin would make a SECOND dir, and the
  # cleanup trap would only ever know about the last one, leaving the first
  # behind with its staged files.
  local _session_dir=""
  # shellcheck source=profiles/claude.sh
  source "$profile_file"
  # The agent is CMD, or -- for a verb, --exec, or `asb --profile NAME` alone -- the
  # profile's command looked up on PATH.
  _as_resolve_bin "${_cmd_word:-$profile_command}" || return 1

  # ---- host-side subcommands (e.g. `claude update`) ----
  # The profile lists verbs that must run on the HOST with the caller's
  # environment, unsandboxed; see docs/updating.md. Not under --exec: there the
  # words are a command line of the caller's choosing, so `--exec update` must
  # run the program named `update` inside the sandbox, never the agent's
  # host-side updater.
  if [[ -n "${1:-}" ]] && ((! _do_exec)); then
    local _sub _rc
    for _sub in "${profile_host_subcommands[@]}"; do
      [[ "$1" == "$_sub" ]] || continue
      ((_ssh_want || ${#_allow_hosts[@]} > 0)) && _as_msg "--ssh*/--allow flags are ignored for '$1'"
      declare -F profile_handle_subcommand >/dev/null \
        || {
          _as_msg "profile '$profile' lists '$1' as host-side but defines no profile_handle_subcommand()"
          return 2
        }
      _rc=0
      profile_handle_subcommand "$@" || _rc=$?
      return "$_rc"
    done
  fi

  # ---- --preset none: no sandbox at all, before any project machinery ----
  # The flag is its only form (see the preset block), and with no sandbox there is no
  # policy to apply, so neither the project's .agent-sandbox nor a running role can
  # stand in its way.
  if [[ "$_preset_flag" == none ]]; then
    ((_ssh_want || ${#_allow_hosts[@]} > 0)) && _as_msg "--ssh*/--allow do nothing under --preset none: there is no sandbox to open"
    if ((_do_exec)); then
      _as_msg "preset none: running '$1' with no sandbox"
      exec "$@"
    fi
    _as_msg "preset none: running $profile_command with no sandbox"
    exec "$profile_bin" "$@"
  fi

  # ---- management verbs: they join the role's launch, and never start one ----
  # Verbs that observe or manage the agent's background service (claude agents,
  # logs, attach, stop, rm, daemon). The daemon runs inside its role's launch (#123),
  # so a verb is a join like any other -- but a verb with no running launch starts
  # none: there is no daemon to ask. See the keeper's join point. Not under --exec,
  # where the words are a program to run inside the sandbox.
  local _do_verb=0 _verb_observe=0 _pv
  if ((! _do_exec)) && [[ -n "${1:-}" ]]; then
    for _pv in ${profile_verbs[@]+"${profile_verbs[@]}"}; do
      [[ "$1" == "$_pv" ]] && _do_verb=1
    done
    for _pv in ${profile_verbs_observe[@]+"${profile_verbs_observe[@]}"}; do
      [[ "$1" == "$_pv" ]] && _verb_observe=1
    done
  fi

  # ---- knobs (AGENT_SANDBOX_*) ----
  local _knob_ro="${AGENT_SANDBOX_RO:-}" _knob_rw="${AGENT_SANDBOX_RW:-}" _knob_forward="${AGENT_SANDBOX_FORWARD:-}"
  local _knob_conda_write="${AGENT_SANDBOX_CONDA_WRITE:-}" _knob_net="${AGENT_SANDBOX_NET:-}"
  local _knob_seccomp="${AGENT_SANDBOX_SECCOMP:-}"
  local _knob_briefing="${AGENT_SANDBOX_BRIEFING:-}"
  local _knob_conda_pkgs="${AGENT_SANDBOX_CONDA_PKGS:-}"
  # PATH for INSIDE the sandbox. Empty means "pass the launching shell's PATH";
  # a selected conda env rewrites it (see the [conda] name block).
  local _inner_path=""

  local cwd
  cwd="$(pwd -P)"

  # THE PROJECT THIS LAUNCH SERVES, which is not always $cwd. A foreground session
  # runs in its project, so the two agree; a WRAPPED BACKGROUND WORKER runs wherever
  # the daemon happened to be, and its project is the one the launcher recorded. The
  # dot-file and its trust record must follow the project or a project's own
  # .agent-sandbox is silently ignored in the workers its sessions spawn -- [net],
  # [allow], [ro], [seccomp], [connect], all of it, including a project that
  # deliberately TIGHTENS. Same helper, and the same reasoning, as the config-file
  # copy and the sandbox key, both of which were fixed for this earlier.
  local _proj
  _proj="$(_as_project_dir)"

  # ---- per-project config (.agent-sandbox), trust-gated ----
  local -a _df_allow=() _df_share=() _df_ro=() _df_rw=() _df_forward=()
  local -a _df_net_host_port=() _df_net_agent_port=()
  local _df_net_mode=""
  local _df_share_set=0 _memory_mode _dotfile="$_proj/.agent-sandbox"
  local _df_conda_name="" _df_conda_write="" _df_conda_pkgs=""
  local _df_seccomp_mode="" _df_briefing_mode=""
  local -a _df_connect=()
  local _df_overlay_mode="" _df_preset="" _df_role=""
  local -a _df_preset_by=() _df_role_globs=()
  local -a _df_profile_kv=() # [<profile>] section pairs, handed to the profile
  local _trust_rec
  _trust_rec="$(_as_config_dir)/trust/$(_as_sha256_str "$_proj")"
  # THE REVIEW IS PART OF THE LAUNCH (#143). A dot-file that is new, changed since it
  # was approved, or gone though one was approved is shown -- the difference, when the
  # approved content was kept -- and asked about, when someone is at a terminal to
  # answer. Yes records the approval and the launch goes on under it. No leaves
  # nothing recorded: a launch then refuses below, as it does with no terminal, and a
  # join still joins under its keeper's policy, which is what it would get anyway.
  # Before the role is read from the file, so an approval here counts from here on.
  # Not for the verbs, which never need a policy to stop what runs, and not inside a
  # sandbox, where there is no gate (_as_dotfile_trusted).
  local _df_needs_review=0
  if [[ -f "$_dotfile" ]]; then
    _as_dotfile_trusted "$_proj" "$_dotfile" || _df_needs_review=1
  elif [[ -f "$_trust_rec" ]] && ! _as_inside_sandbox; then
    _df_needs_review=1
  fi
  if ((_df_needs_review && ! (_do_verb || _do_shutdown || _do_status))) && _as_has_terminal; then
    _as_trust_prompt "$_proj" || _as_msg "not approved."
  fi
  # A JOIN READS THE KEEPER'S DOT-FILE, NOT THE LIVE ONE. A running role's policy is
  # the one its keeper started with, so the file a join parses is the copy the keeper
  # kept of the approved dot-file -- and an edit to the live file that is not yet
  # approved does not refuse the join: the trust gate's reason, that an ignored file
  # would fall back to the defaults, has nothing to fall back to here. The live file is
  # still read for two things: to find the role, when no --role or AGENT_SANDBOX_ROLE
  # names it (and then only an approved file is read, so an unapproved edit refuses as
  # before), and to say it has changed. Only a keeper with something joined is read
  # this way: an idle one is replaced when the policy differs, and a replacement is a
  # launch, which follows the live file's rules (see the keeper section).
  local _df_src="$_dotfile" _df_from_keeper=0 _pre_role="" _pre_known=1
  if ((_role_flag_set)); then
    _pre_role="$_role_flag"
  elif [[ -n "${AGENT_SANDBOX_ROLE:-}" ]]; then
    _pre_role="$AGENT_SANDBOX_ROLE"
  elif [[ -f "$_dotfile" ]] && _as_dotfile_trusted "$_proj" "$_dotfile"; then
    _pre_role="$(_as_dotfile_parse "$_dotfile" 2>/dev/null && printf '%s' "$_df_role")"
  elif [[ -f "$_trust_rec" ]]; then
    _pre_known=0 # the role would come from an edit not approved, or a file now missing
  fi
  # A MANAGEMENT VERB OR --shutdown NEEDS THE DOT-FILE ONLY TO FIND THE ROLE, and an
  # unapproved edit must not stop you stopping sessions. So when the role cannot be
  # read from the file, the one role of this project that is running is meant; with
  # none there is nothing to ask, and with several the user has to say which.
  local _do_manage=0
  ((_do_verb || _do_shutdown || _do_status)) && _do_manage=1
  ((_do_status)) && _verb_observe=1
  if ((_do_manage && ! _pre_known)); then
    local -a _running=()
    local _rk
    for _rk in "$(_as_state_dir)/$profile/$(_as_path_slug "$_proj")"/*/keeper/id; do
      [[ -e "$_rk" ]] || continue
      _rk="${_rk%/keeper/id}"
      _as_keeper_live "$_rk" && _running+=("${_rk##*/}")
    done
    case "${#_running[@]}" in
      0)
        ((_verb_observe)) && {
          _as_msg "no role of this project is running"
          return 0
        }
        _as_msg "no role of this project is running, so there is nothing to ${1:-shut down}"
        return 1
        ;;
      1) _pre_role="${_running[0]}" _pre_known=1 ;;
      *)
        _as_msg ".agent-sandbox has changed since you approved it, so it cannot say which role is meant, and ${#_running[@]} are running (${_running[*]}): name one with --role"
        return 1
        ;;
    esac
  fi
  if ((_pre_known)) && [[ "${_pre_role:-default}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    local _kb
    _kb="$(_role="${_pre_role:-default}" _as_sandbox_dir)"
    # A verb or --shutdown never builds, so any running keeper's copy will do; a
    # launch reads the copy only while something holds the keeper (see above).
    if _as_keeper_live "$_kb" && { ((_do_manage)) || _as_keeper_busy "$_kb"; }; then
      _df_from_keeper=1
      _df_src=""
      [[ -f "$_kb/keeper/dotfile.copy" ]] && _df_src="$_kb/keeper/dotfile.copy"
    fi
  fi
  if ((_df_from_keeper)) && [[ -z "$_df_src" ]]; then
    : # the running keeper started with no approved dot-file, so there is none
  elif ((_df_from_keeper)) || [[ -f "$_dotfile" ]]; then
    if ((_df_from_keeper)) || _as_dotfile_trusted "$_proj" "$_dotfile"; then
      _as_dotfile_clean "$_df_src" || return 1 # an approval recorded by other means does not get such a file honoured
      _as_dotfile_parse "$_df_src"
      local _dh _dj
      for _dh in "${_df_allow[@]}"; do
        [[ -z "$_dh" ]] && continue
        if [[ "$_dh" =~ $_hostre ]]; then
          _allow_hosts+=("$_dh")
        else
          _as_msg ".agent-sandbox allow: bad host '$_dh'; ignoring"
        fi
      done
      # ro/rw paths and forwarded names: add to the knobs (validated later by
      # _as_check_paths, which still refuses secret stores, /, $HOME, parents).
      if ((${#_df_ro[@]})); then
        _dj="$(
          IFS=:
          printf '%s' "${_df_ro[*]}"
        )"
        _knob_ro="${_knob_ro:+$_knob_ro:}$_dj"
      fi
      if ((${#_df_rw[@]})); then
        _dj="$(
          IFS=:
          printf '%s' "${_df_rw[*]}"
        )"
        _knob_rw="${_knob_rw:+$_knob_rw:}$_dj"
      fi
      ((${#_df_forward[@]})) && _knob_forward="${_knob_forward:+$_knob_forward }${_df_forward[*]}"
      # network mode: an explicit AGENT_SANDBOX_NET in your shell wins over the
      # file. Note a trusted `mode = open` switches the allowlist off for this
      # project; the --trust review is where that is decided.
      if [[ -n "$_df_net_mode" ]]; then
        case "$_df_net_mode" in
          proxy | strict | open | none)
            if [[ -z "$_knob_net" ]]; then
              _knob_net="$_df_net_mode"
              _as_info "using network mode '$_df_net_mode' from .agent-sandbox"
            else
              _as_msg "AGENT_SANDBOX_NET=$_knob_net overrides the .agent-sandbox network mode '$_df_net_mode'"
            fi
            ;;
          *) _as_msg ".agent-sandbox: [net] mode '$_df_net_mode' unknown (proxy|strict|open|none); ignoring" ;;
        esac
      fi
      # seccomp: an explicit AGENT_SANDBOX_SECCOMP in your shell wins over the
      # file. A project can only ask for the filter or decline it; it cannot
      # pick a profile. The filter is on by default, so `mode = off` is a real
      # widening -- which is what the --trust review is for, and why deleting
      # an approved file refuses the launch instead of falling back to the
      # defaults. A value the engine does not act on (unknown, or a malformed
      # line) leaves the default in place, which means ON: a project file must
      # not switch the filter off by being wrong.
      if [[ -n "$_df_seccomp_mode" ]]; then
        case "$_df_seccomp_mode" in
          on | 1 | off | 0)
            if [[ -z "$_knob_seccomp" ]]; then
              _knob_seccomp="$_df_seccomp_mode"
              _as_info "using seccomp mode '$_df_seccomp_mode' from .agent-sandbox"
            else
              _as_msg "AGENT_SANDBOX_SECCOMP=$_knob_seccomp overrides the .agent-sandbox seccomp mode '$_df_seccomp_mode'"
            fi
            ;;
          *) _as_msg ".agent-sandbox: [seccomp] mode '$_df_seccomp_mode' unknown (on|off); ignoring" ;;
        esac
      fi
      # briefing: an explicit AGENT_SANDBOX_BRIEFING in your shell wins over the
      # file. Turning it off hides nothing and grants nothing; it only stops the
      # sandbox describing itself, so an approved `mode = off` is not a widening.
      if [[ -n "$_df_briefing_mode" ]]; then
        case "$_df_briefing_mode" in
          on | 1 | off | 0)
            if [[ -z "$_knob_briefing" ]]; then
              _knob_briefing="$_df_briefing_mode"
              _as_info "using briefing mode '$_df_briefing_mode' from .agent-sandbox"
            else
              _as_msg "AGENT_SANDBOX_BRIEFING=$_knob_briefing overrides the .agent-sandbox briefing mode '$_df_briefing_mode'"
            fi
            ;;
          *) _as_msg ".agent-sandbox: [briefing] mode '$_df_briefing_mode' unknown (on|off); ignoring" ;;
        esac
      fi
      # conda scalars: an explicit environment knob wins over the file.
      [[ -z "$_knob_conda_write" && -n "$_df_conda_write" ]] && _knob_conda_write="$_df_conda_write"
      [[ -z "$_knob_conda_pkgs" && -n "$_df_conda_pkgs" ]] && _knob_conda_pkgs="$_df_conda_pkgs"
      # conda name: pin the project's env; resolve <base>/envs/<name> and hand it
      # to the conda block by setting CONDA_PREFIX for the rest of this launch.
      if [[ -n "$_df_conda_name" ]]; then
        local _cbase
        _cbase="$(_as_conda_base)"
        if [[ -n "$_cbase" && -d "$_cbase/envs/$_df_conda_name" ]]; then
          local _old_prefix="${CONDA_PREFIX:-}"
          CONDA_PREFIX="$_cbase/envs/$_df_conda_name"
          CONDA_DEFAULT_ENV="$_df_conda_name"
          # Setting CONDA_PREFIX alone is not enough: PATH still comes from the
          # launching shell, so the env's own tools would not be found inside and
          # CONDA_PREFIX would disagree with PATH. Swap the shell's active env
          # (an env's bin, or the base's) for this one, as `conda activate` does.
          if [[ "$_old_prefix" != "$CONDA_PREFIX" ]]; then
            _inner_path="$(_as_path_swap_conda "${_old_prefix:-$_cbase}" "$CONDA_PREFIX")"
          fi
          _as_info "using conda env '$_df_conda_name' from .agent-sandbox"
        else
          _as_msg ".agent-sandbox: conda env '$_df_conda_name' not found under ${_cbase:-<no conda base>}/envs; ignoring"
        fi
      fi
    elif [[ -f "$_trust_rec" ]]; then
      # Approved once, changed since (by you, or by the agent): refuse rather
      # than ignore, or the defaults would apply in place of what you approved.
      _as_msg ".agent-sandbox has changed since you approved it (by you, by the agent, or by a pull)." \
        "Refusing to launch until it is reviewed: launch from a terminal to be asked, or review it with: $invoked --trust"
      return 1
    else
      # A new file refuses too (#143): ignoring it would give whoever wrote it the
      # defaults, with a note they may never see, which is the silent fall-back the
      # gate exists to prevent. Not for a verb, which reads no policy to do its work.
      if ((_do_verb || _do_shutdown || _do_status)); then
        _as_msg ".agent-sandbox is here but has never been approved; this command does not need it."
      else
        _as_msg ".agent-sandbox is here but has never been approved." \
          "Refusing to launch until it is reviewed: launch from a terminal to be asked, or review it with: $invoked --trust (printf y | $invoked --trust approves it without a terminal)"
        return 1
      fi
    fi
  elif [[ -f "$_trust_rec" ]] && ! _as_inside_sandbox; then
    _as_msg "this project's approved .agent-sandbox is missing; its policy (memory scoping, paths, ports, ...) would" \
      "silently fall back to the defaults. Refusing to launch: restore the file, launch from a terminal to be asked, or forget the approval with: $invoked --trust"
    return 1
  fi

  # A [<profile>] dot-file key the profile does not declare is almost always a
  # typo; warn rather than silently ignore it. The profile lists the keys it
  # reads in profile_dotfile_keys -- its single source of truth, also checked by
  # the docs drift test.
  if declare -p profile_dotfile_keys >/dev/null 2>&1; then
    local _pk _pkn _kk _known
    for _pk in ${_df_profile_kv[@]+"${_df_profile_kv[@]}"}; do
      _pkn="${_pk%%=*}"
      _known=0
      for _kk in ${profile_dotfile_keys[@]+"${profile_dotfile_keys[@]}"}; do
        [[ "$_pkn" == "$_kk" ]] && {
          _known=1
          break
        }
      done
      ((_known)) || _as_msg ".agent-sandbox: [$profile] key '$_pkn' is not one this profile reads; ignoring"
    done
  fi

  # ---- connections: resolve every form into one channel -> mode map ----
  # The order below IS the precedence: an approved dot-file, then the
  # environment, then the flag, each overwriting the last -- the order
  # --user-mcp already follows. One code path validates all three, so a spec
  # refused in the file is refused on the command line too.
  #
  # The dot-file is only parsed when APPROVED, so `[connect]` grants nothing
  # from an unapproved file. Stepping UP the scale, toward `live`, is a
  # widening and the `--trust` review is where it is seen; stepping down only
  # narrows what this sandbox can reach.
  # What `copy-on-write` is implemented with: flag, then environment, then approved
  # dot-file, then `auto`. Same precedence as every other knob.
  local _ov="" _ov_src=""
  if [[ -n "$_overlay_flag" ]]; then
    _ov="$_overlay_flag" _ov_src=--overlay
  elif [[ -n "${AGENT_SANDBOX_OVERLAY:-}" ]]; then
    _ov="$AGENT_SANDBOX_OVERLAY" _ov_src=AGENT_SANDBOX_OVERLAY
  elif [[ -n "$_df_overlay_mode" ]]; then
    _ov="$_df_overlay_mode" _ov_src=".agent-sandbox [overlay] mode"
  fi
  if [[ -n "$_ov" ]]; then
    case "$_ov" in
      auto | off) _overlay_mode="$_ov" ;;
      *)
        _as_msg "overlay ($_ov_src): unknown mode '$_ov' (auto|off); keeping auto"
        ;;
    esac
  fi

  # ---- the role: which instance of this project this launch is ----
  # Read from the keeper's copy, `[sandbox] role` says what it said when the keeper
  # started; the keeper being joined is the one the live file named.
  ((_df_from_keeper)) && _df_role="$_pre_role"
  _as_role_resolve || return 1
  local _pb
  for _pb in ${_df_preset_by[@]+"${_df_preset_by[@]}"}; do
    # shellcheck disable=SC2053 # the glob is the pattern
    [[ "$_role" == ${_pb%%$'\t'*} ]] && _df_preset="${_pb#*$'\t'}"
  done

  # ---- the preset: every channel's position, before any override ----
  local _ps="" _ps_src=""
  if [[ -n "$_preset_flag" ]]; then
    _ps="$_preset_flag" _ps_src=--preset
  elif [[ -n "${AGENT_SANDBOX_PRESET:-}" ]]; then
    _ps="$AGENT_SANDBOX_PRESET" _ps_src=AGENT_SANDBOX_PRESET
  elif [[ -n "$_df_preset" ]]; then
    _ps="$_df_preset" _ps_src=".agent-sandbox [sandbox] preset"
  fi
  if [[ -n "$_ps" ]]; then
    case "$_ps" in
      isolated | inherit | shared) _preset="$_ps" ;;
      independent | default)
        _as_msg "preset ($_ps_src): '$_ps' was renamed in 0.3 -- write '$(_as_preset_renamed "$_ps")' (isolated|inherit|shared|native|none)"
        return 1
        ;;
      native)
        # THE ONE KNOB WITH A SINGLE FORM. `native` turns state isolation off
        # wholesale, so a shell profile or a repository's .agent-sandbox must not
        # be able to reach it: you type it, per launch, or it does not happen.
        if [[ "$_ps_src" != --preset ]]; then
          _as_msg "preset ($_ps_src): 'native' turns this sandbox's state isolation off entirely, so it is only accepted as the --preset flag -- not from the environment or a project file, which could set it for every launch without you noticing."
          return 1
        fi
        _preset=native
        ;;
      none)
        # NO SANDBOX AT ALL, and the flag is its only form -- for a stronger reason
        # than `native`'s: this also drops the network policy and the syscall filter.
        # A project cannot declare itself unsandboxed; you type it, or alias it.
        # The flag itself was acted on before any project machinery (see there).
        _as_msg "preset ($_ps_src): 'none' runs the agent with no sandbox at all -- no network policy, no syscall filter -- so it is only accepted as the --preset flag, not from the environment or a project file."
        return 1
        ;;
      *)
        _as_msg "preset ($_ps_src): unknown preset '$_ps' (isolated|inherit|shared|native|none); refusing rather than guessing which channels you meant to move"
        return 1
        ;;
    esac
  fi
  # Loud, every launch, never suppressed by --quiet: a session running with no
  # state isolation should not be something you have to remember.
  if _as_preset_is_native; then
    _as_msg "preset native: state isolation is OFF -- every channel read-write, the config file whole, memory unscoped, and the per-session scratch not applied. This exists so that a difference from \`--sandbox none\` is a bug in agent-sandbox; it is not a way to run day to day. The network mode, the syscall filter and the CWD bind still apply."
  fi
  # Seed every channel the profile declares from the preset. An explicit
  # [connect] line, knob or flag then overwrites its own channel and nothing
  # else, which is what makes "a preset plus overrides" the whole vocabulary.
  local _pc _pm
  _pm="$(_as_preset_mode "$_preset")"
  for _pc in ${profile_channels[@]+"${profile_channels[@]}"}; do
    _connect_mode["${_pc%%$'\t'*}"]="$(_as_channel_preset_mode "${_pc%%$'\t'*}" "$_preset")"
    _connect_where["${_pc%%$'\t'*}"]="preset $_preset"
  done

  local _cs
  local -a _env_connect=()
  local _cg
  for _cs in ${_df_connect[@]+"${_df_connect[@]}"}; do
    _cg="${_cs%%$'\t'*}"
    # shellcheck disable=SC2053 # the glob is the pattern
    [[ "$_role" == $_cg ]] || continue
    if [[ "$_cg" == "*" ]]; then
      _as_connect_parse "${_cs#*$'\t'}" ".agent-sandbox [connect]" || return 1
    else
      _as_connect_parse "${_cs#*$'\t'}" ".agent-sandbox [connect:$_cg]" || return 1
    fi
  done
  if [[ -n "${AGENT_SANDBOX_CONNECT:-}" ]]; then
    # Semicolon-separated: a spec contains spaces, so a space cannot separate
    # them. `read -a` rather than word splitting, which would also glob.
    IFS=';' read -r -a _env_connect <<<"$AGENT_SANDBOX_CONNECT"
    for _cs in ${_env_connect[@]+"${_env_connect[@]}"}; do
      _as_connect_parse "$_cs" AGENT_SANDBOX_CONNECT || return 1
    done
  fi
  for _cs in ${_connect_flag[@]+"${_connect_flag[@]}"}; do
    _as_connect_parse "$_cs" --connect || return 1
  done
  # THE AGENT IS NEVER AN AUTHOR OF ITS OWN POLICY (#143). The dot-file sits in the
  # project, which is bound read-write, so without this a session could edit what
  # configures its sandbox; the gate caught that at the next launch, but only as an
  # edit it could not tell from yours. So it is a path declaration of its own,
  # `read-only` unless one is written for it. Any mode but `read-write` keeps the
  # sandbox's writes inside (`copy` gives an inner engine, or a `git pull` run inside,
  # a copy to change). Not under `native`, whose whole claim is that it differs from
  # `none` in nothing; a declaration written for it still applies there. And not when
  # there is no file: a read-only mount point would leave an empty `.agent-sandbox`
  # in the repository. One the agent creates is new at the next launch, and reviewed.
  local _dfp
  _dfp="$(realpath -m -s -- "$_dotfile")"
  if [[ -n "${_connect_key[$_dfp]:-}" ]]; then
    if [[ "${_connect_mode[$_dfp]}" == read-write ]]; then
      _as_msg "connect (${_connect_where[$_dfp]}): '${_connect_key[$_dfp]} = read-write' is refused: the sandbox's own policy file is never the agent's to write (#143). Any other mode keeps its writes inside; 'copy' gives it a copy of its own."
      return 1
    fi
  elif [[ -f "$_dotfile" ]] && ! _as_preset_is_native; then
    _as_connect_parse "./.agent-sandbox = read-only" "built in, #143" || return 1
  fi
  _as_connect_report

  # ---- --shutdown: end the role's launch, then exit ----
  if ((_do_shutdown)); then
    _as_keeper_shutdown "$(_as_sandbox_dir)"
    return $?
  fi

  # ---- --status and --delete: the role's own verbs, then exit (#126) ----
  if ((_do_status)); then
    _as_role_status
    return $?
  fi
  if ((_do_delete)); then
    _as_role_delete
    return $?
  fi

  # ---- --reset: undo one channel or path, then exit ----
  if [[ -n "$_reset_connection" ]]; then
    _as_connect_reset "$_reset_connection" || return 1
    return 0
  fi

  # ---- profile routing: sandbox this invocation, or hand it off ----
  # With the project's trusted .agent-sandbox now read, let the profile decide
  # what to do with the agent's own argv against the effective sandbox scopes
  # (--sandbox flag > AGENT_SANDBOX_<PROFILE>_SANDBOX env > [<profile>] sandbox
  # dot-file key > a context default: none inside a sandbox, else fg). It either
  # runs the invocation itself (e.g. a foreground scope turned off -> native; a
  # background launch -> sandbox the workers) and never returns, or returns 0 to
  # continue with the normal sandboxed foreground flow below. It reads the engine
  # locals it needs (_sandbox_flag, _sandbox_flag_set, _df_profile_kv, cwd,
  # engine, profile_bin, profile) by dynamic scope, as the other profile hooks
  # do; profile_prepare reads _user_mcp_flag/_user_mcp_flag_set the same way.
  # Wrapper spawns and `--trust` never route.
  if ((! _do_trust)) && declare -F profile_route >/dev/null; then
    profile_route "$@" || return $?
  fi

  if ((_df_share_set)); then
    if ((${#_df_share[@]} == 1)) && [[ "${_df_share[0]}" == all ]]; then
      _memory_mode=shared
      _df_share=()
    else
      _memory_mode=scoped
    fi
  else
    _memory_mode="$(_as_memory_default)"
  fi
  # `native` is parity with no sandbox, and a native install scopes nothing.
  _as_preset_is_native && _memory_mode=shared

  # ---- strict-mode ports: flags, knobs and the dot-file form a union ----
  local -a _knob_host_ports=() _knob_agent_ports=()
  [[ -n "${AGENT_SANDBOX_HOST_PORTS:-}" ]] && _as_split _knob_host_ports $', \t\n' "$AGENT_SANDBOX_HOST_PORTS"
  [[ -n "${AGENT_SANDBOX_AGENT_PORTS:-}" ]] && _as_split _knob_agent_ports $', \t\n' "$AGENT_SANDBOX_AGENT_PORTS"
  # What this invocation named itself, before the dot-file's ports join them: a join
  # is checked on these (see _as_keeper_policy).
  local -a _keeper_join_host_ports=(${_host_ports[@]+"${_host_ports[@]}"} ${_knob_host_ports[@]+"${_knob_host_ports[@]}"})
  local -a _keeper_join_agent_ports=(${_agent_ports[@]+"${_agent_ports[@]}"} ${_knob_agent_ports[@]+"${_knob_agent_ports[@]}"})
  _as_ports_merge --host-port _host_ports _host_none "${_host_ports[@]}" "${_knob_host_ports[@]}" "${_df_net_host_port[@]}" || return 1
  _as_ports_merge --agent-port _agent_ports _agent_none "${_agent_ports[@]}" "${_knob_agent_ports[@]}" "${_df_net_agent_port[@]}" || return 1

  # ---- the keeper: join this role's running launch, or start it (#121) ----
  # Everything above resolved what this invocation asks for and did nothing to the
  # host; everything below builds a launch. So this is where a running keeper is
  # joined instead. The lock taken here is held until this invocation is on the
  # keeper's record -- through the whole build when there is no keeper -- so two
  # first launches of one role at once are one keeper, not two.
  local _keeper_sb="" _keeper_target="" _keeper_spid="" _join_brief="" _keeper_dotfile_changed=0
  if :; then
    # Checked before anything is built: without python3 there is no join, and a
    # keeper started for nothing would have seeded its stores for nothing too.
    command -v python3 >/dev/null 2>&1 || {
      _as_msg "the sandbox needs python3 on PATH: every app is joined into its role's launch by a python3 helper (components/join.py)"
      return 1
    }
    _keeper_sb="$(_as_sandbox_dir)"
    # AN IDLE KEEPER IS REPLACED, NOT REFUSED. Within its grace nothing is joined, so
    # there is nothing whose policy a different one would change: it is ended, and this
    # invocation starts the next keeper -- the same as a reset does. Only a keeper with
    # something joined holds its policy against a join that asks for another.
    local _kpass _klocked=0
    for _kpass in 1 2 3; do
      _as_keeper_lock "$_keeper_sb" || return 1
      _as_keeper_live "$_keeper_sb" || {
        _klocked=1
        break
      }
      # (Never for a verb: it builds nothing, so it has no reason to replace anything.)
      if ((! _do_verb)) && ! _as_keeper_busy "$_keeper_sb" && { ! _as_keeper_admit "$_keeper_sb" quiet || ((_keeper_dotfile_changed)); }; then
        # Resolved from the keeper's copy of the dot-file, this invocation cannot be
        # the next launch: that one follows the live file, approved.
        if ((_df_from_keeper)); then
          _as_keeper_unlock
          _as_msg "role '${_role:-default}': its launch ended while this one was joining it; run it again"
          return 1
        fi
        : >"$_keeper_sb/keeper/stop"
        kill -USR1 "$_keeper_spid" 2>/dev/null
        _as_keeper_unlock
        local _kw
        for ((_kw = 0; _kw < 500; _kw++)); do
          [[ -d "/proc/$_keeper_spid" ]] || break
          sleep 0.01
        done
        continue
      fi
      _as_keeper_admit "$_keeper_sb" || {
        _as_keeper_unlock
        return 2
      }
      ((_keeper_dotfile_changed)) \
        && _as_msg "role '${_role:-default}': .agent-sandbox has changed since this role's keeper started. Joining it under the policy it started with; the change applies at the next keeper, once nothing is joined."
      local -a _run_argv=()
      if ((_do_exec)); then
        _run_argv=("$@")
      elif ((_do_verb)); then
        _run_argv=("$profile_bin" "$@") # a verb's argv is not a session: no briefing
      else
        local -a profile_briefing_argv=()
        local _ksess
        _ksess="$(cat "$_keeper_sb/keeper/session" 2>/dev/null)"
        if [[ -n "$_ksess" && -d "$_ksess/briefing" ]] && grep -q $'^briefing\ton\t' "$_keeper_sb/keeper/policy" \
          && declare -F profile_briefing_args >/dev/null; then
          # This join's own hook settings (they merge its --settings), beside the
          # briefing the keeper already has in view.
          _join_brief="$_ksess/briefing/join.$BASHPID"
          mkdir -p -- "$_join_brief" || return 1
          local _brief_out_host="$_join_brief" _brief_out_inside
          _brief_out_inside="$(_as_briefing_inside)/join.$BASHPID"
          profile_briefing_args "$(_as_briefing_inside)" "$@" || return 1
        fi
        _run_argv=("$profile_bin" "$@" ${profile_briefing_argv[@]+"${profile_briefing_argv[@]}"})
      fi
      _as_info "joining role '${_role:-default}', running since $(date -d "@$(stat -c %Y "$_keeper_sb/keeper/id")" '+%F %T' 2>/dev/null)"
      local _jrc=0
      ((_do_exec)) || ! declare -F profile_before_join >/dev/null || profile_before_join "$@"
      _as_keeper_join "$_keeper_sb" "${_run_argv[@]}" || _jrc=$?
      [[ -n "${_help_footer:-}" ]] && _as_engine_help_footer
      return "$_jrc"
    done
    # Three idle keepers replaced and a fourth in the way: something else keeps
    # starting this role. Not worth a fourth race.
    # A VERB WITH NO KEEPER STARTS NONE (#123): with no launch there is no daemon to
    # ask. A question gets the empty answer; an action on a session that cannot exist
    # is refused.
    if ((_do_verb)); then
      _as_keeper_unlock
      if ((_verb_observe)); then
        _as_msg "role '${_role:-default}' is not running, so it has no background sessions"
        return 0
      fi
      _as_msg "role '${_role:-default}' is not running, so it has no background session to $1"
      return 1
    fi
    if ((_df_from_keeper)); then
      _as_keeper_unlock
      _as_msg "role '${_role:-default}': its launch ended while this one was joining it; run it again"
      return 1
    fi
    if ((! _klocked)); then
      _as_keeper_lock "$_keeper_sb" || return 1
      if _as_keeper_live "$_keeper_sb"; then
        _as_keeper_unlock
        _as_msg "role '${_role:-default}': another launch of this role keeps starting while this one tries to; try again"
        return 1
      fi
    fi
    # A COLD START: no keeper is live, the lock is held, and this invocation builds the
    # next launch. What a run-scoped store held belongs to a run that is over.
    _as_run_scoped_clear "$_keeper_sb"
    _as_join_scoped_clear "$_keeper_sb"
  fi

  if declare -F profile_prepare >/dev/null; then
    profile_prepare || return 1
  fi
  if declare -F profile_memory_scope >/dev/null; then
    profile_memory_scope "$_memory_mode" "${_df_share[@]}" || return 1
  elif [[ "$_memory_mode" == scoped ]]; then
    _as_msg "profile '$profile' does not scope memory; the setting is ignored"
  fi

  # ----- git identity hint -----
  # ~/.gitconfig is not bound into the sandbox, so a *global* git identity is
  # invisible inside it and commits fail with "Author identity unknown". The
  # supported fix is a repo-local identity: .git/config travels with the repo
  # (bound read-write as CWD), so a [user] section there is enough on its own
  # -- git reads local before global and needs nothing else. If this repo has
  # none, say so. Setting it must happen from a HOST shell to copy the values
  # out of ~/.gitconfig, which is not visible in here either.
  if command -v git >/dev/null \
    && git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [[ -z "$(git -C "$cwd" config --local user.name 2>/dev/null)" ||
    -z "$(git -C "$cwd" config --local user.email 2>/dev/null)" ]]; then
      local _gitroot
      _gitroot="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")"
      _as_msg "no repo-local git identity; commits inside the sandbox will fail"
      echo "               (~/.gitconfig is not bound in). Set it once, from a HOST shell:" >&2
      echo "                 git -C \"$_gitroot\" config user.name  \"\$(git config --global user.name)\"" >&2
      echo "                 git -C \"$_gitroot\" config user.email \"\$(git config --global user.email)\"" >&2
    fi
  fi

  # A CWD of / or of a parent of $HOME would be bound read-write and expose
  # everything under it, $HOME included. Refuse; run from a project directory.
  if [[ "$cwd" == / || "$HOME" == "$cwd"/* ]]; then
    _as_msg "refusing to bind '$cwd' as CWD (it contains \$HOME). Run from a project directory."
    return 1
  fi

  # When CWD is $HOME we deliberately do *not* bind it: that would expose
  # the entire home directory. Only the explicit bindings below apply.
  local bind_cwd=1
  if [[ "$cwd" == "$HOME" ]]; then
    bind_cwd=0
    _as_msg "CWD is \$HOME — not binding it. Only the profile's state paths," \
      "the active conda env, and AGENT_SANDBOX_R{O,W} paths will be visible."
  fi
  # CWD is bound read-write: refuse a secret store or the sandbox's own control
  # plane, and any directory containing one (see _as_secret_paths).
  local _prot_what _prot_path _prot_how
  if ((bind_cwd)) && _as_path_protected "$cwd"; then
    _as_msg "refusing to bind '$cwd' as CWD: it $_prot_how $_prot_what '$_prot_path'. Run from a project directory."
    return 1
  fi

  _as_check_paths RO "$_knob_ro" || return 1
  _as_check_paths RW "$_knob_rw" || return 1

  # The ephemeral view of the writable world: a blank $HOME and private /tmp,
  # /var/tmp, /run, which is most of what "sandbox" means here.
  #
  # `native` replaces all of it with the host's own directories. Under
  # `--sandbox none` the agent reads ~/.gitconfig, ~/.npmrc, ~/.ssh/config,
  # whatever a tool it shells out to keeps in $HOME, and $XDG_RUNTIME_DIR --
  # none of which any channel declares, because channels cover the state the
  # profile knows about and this is everything else. MEASURED: with the tmpfs in
  # place, $HOME inside `native` held two entries where the host had three and a
  # different two, which is the whole class of difference this preset exists to
  # surface. Leaving it would make `native` a weaker claim than it advertises,
  # and every such gap reads as an agent-sandbox bug to whoever hits it.
  # $HOME LAST, in both branches. It can live under /tmp -- every test tree's
  # does -- and a --tmpfs /tmp mounted after one on $HOME buries it, so the
  # remount-ro below then fails on a path whose tmpfs is no longer there. Caught
  # by native-parity.bats the moment this block was first reordered.
  local -a _world=(
    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run
    --tmpfs "$HOME"
    --tmpfs "$HOME/.cache"
  )
  if _as_preset_is_native; then
    # /run stays a tmpfs with only $XDG_RUNTIME_DIR punched through, which is the
    # one place `native` knowingly stops short. It is root-owned, so binding it
    # whole leaves nowhere to create /run/agent-sandbox and the launch dies on
    # the briefing -- measured. The user runtime dir is the part a user-level
    # agent actually reaches; the rest of /run is system sockets it does not.
    local _ruid
    _ruid="/run/user/$(id -u)"
    _world=(
      --bind /tmp /tmp
      --bind-try /var/tmp /var/tmp
      --tmpfs /run
      --bind "$HOME" "$HOME"
    )
    [[ -d "$_ruid" ]] && _world+=(--bind "$_ruid" "$_ruid")
  fi

  local -a args=(
    # Minimal system view (all read-only). Note: anything under /usr (incl.
    # /usr/local when it's a real directory) is already covered by the /usr
    # bind. When /usr/local is a symlink elsewhere we expose its real target
    # below so the symlink resolves inside the sandbox (needed for CUDA).
    --ro-bind /usr /usr
    --ro-bind-try /etc /etc
    --ro-bind-try /opt /opt
    --ro-bind-try /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /bin /bin
    --ro-bind-try /sbin /sbin

    # Ephemeral pseudo-filesystems.
    --proc /proc
    --dev /dev

    # Blank $HOME — we punch through only what's needed below. ~/.cache is a
    # fresh, writable, session-private tmpfs so tools that expect a cache dir
    # (pip, uv, npm, conda's notices, model downloaders) just work; it vanishes
    # with the session and never touches the host's ~/.cache. Under `native`,
    # the host's own $HOME, /tmp, /var/tmp and /run instead: see _world above.
    "${_world[@]}"

    # Isolation. Network is left unshared here; we re-introduce it below
    # according to AGENT_SANDBOX_NET (default: through a host-side mitmproxy
    # allowlist).
    --unshare-all
    --die-with-parent
    --new-session
    # Identity inside: the invoking user, in every network mode. In strict, bwrap
    # runs inside pasta's user namespace where the caller is already mapped to
    # root, so without this the SAME sandbox reports uid 0 there and the real uid
    # everywhere else -- inherited from pasta, never chosen, and at odds with
    # $USER (set below), which says the real user in both. Writes land on the host
    # as the real user either way; what changes is what the payload sees, and what
    # tools that branch on being root then do.
    --uid "$(id -u)" --gid "$(id -g)"
    # Drop all capabilities. A no-op in proxy/open/none, where bwrap is
    # unprivileged and the agent already has none; it matters in strict, where
    # bwrap runs inside pasta's root-owned user namespace and its child userns
    # would otherwise start the agent as uid 0 with the full capability set.
    # bwrap still holds the caps it needs during setup; this is the payload's set.
    --cap-drop ALL

    # Drop the parent environment; we re-export an explicit allowlist below.
    --clearenv
  )

  # Always-on bindings: the profile's state paths (read-write) and its binary.
  # An entry is a host path bound at itself, or SRC<TAB>DEST to bind it at a
  # different path inside: the claude profile binds ~/.claude.json INSIDE
  # ~/.claude, where the lock and temp file Claude Code writes beside it can be
  # created. When DEST is a file that does not exist yet, bwrap creates an
  # empty one as the mount point -- on the HOST, if DEST sits inside a
  # directory bound read-write. Those are recorded and removed again by the
  # cleanup while still empty: left behind, an empty ~/.claude/.claude.json is
  # a config that parses as nothing for anyone who later points
  # CLAUDE_CONFIG_DIR there natively. The rm fails with EBUSY while another
  # session still has it mounted; the last session out removes it.
  local _p _src _dst
  for _p in "${profile_config_binds[@]}"; do
    IFS=$'\t' read -r _src _dst <<<"$_p"
    _dst="${_dst:-$_src}"
    [[ -e "$_src" ]] \
      || {
        _as_msg "profile '$profile': state path '$_src' does not exist (create it in profile_prepare)"
        return 1
      }
    if [[ -f "$_src" && "$_dst" != "$_src" && ! -e "$_dst" ]]; then
      _as_placeholder_files+=("$_dst")
    fi
    args+=(--bind "$_src" "$_dst")
  done
  # Under `native` the host's $HOME is bound whole, so a binary living in it is
  # already inside; binding it again is a no-op that can still FAIL, because
  # bwrap refuses to mount over a symlink and a versioned install may well be
  # one. Measured. A binary outside $HOME still needs its bind.
  if _as_preset_is_native && [[ "$profile_bin" == "$HOME"/* ]]; then
    :
  else
    args+=(--ro-bind "$profile_bin" "$profile_bin")
  fi

  # Profile-declared visibility adjustments, applied AFTER its state binds so
  # they layer on top: a tmpfs to hide a subtree, then read-write and
  # read-only rebinds of the parts to keep. The claude profile uses these to
  # scope ~/.claude/projects to the current project (read-write) plus any
  # approved shares (read-only). Empty for every profile by default.
  local _pv
  for _pv in "${profile_tmpfs[@]}"; do
    args+=(--tmpfs "$_pv")
  done
  for _pv in "${profile_rw_binds[@]}"; do
    [[ -e "$_pv" ]] || {
      _as_msg "profile '$profile': rw path '$_pv' does not exist"
      return 1
    }
    args+=(--bind "$_pv" "$_pv")
  done
  for _pv in "${profile_ro_binds[@]}"; do
    if [[ -e "$_pv" ]]; then
      args+=(--ro-bind "$_pv" "$_pv")
    else
      _as_msg "share-memory: nothing at '$_pv'; skipping"
    fi
  done

  # Connections: a channel the user narrowed is bound over the profile's own
  # visibility binds and under the per-session scratch. See the connections
  # section above for why that order.
  _as_connect_apply || return 1
  # Binds a profile needs ON TOP of the connections: a path inside a channel that keeps
  # machinery of its own (the claude profile's memory, inside `transcripts`).
  for _pv in ${profile_late_rw_binds[@]+"${profile_late_rw_binds[@]}"}; do
    args+=(--bind "$_pv" "$_pv")
  done

  # State isolation: the profile declares which parts of its state directory
  # leak across sessions, the engine stages and binds them. After the binds
  # above for the same reason they come after the state binds -- these layer on
  # top of a directory that is already in place.
  # The per-session scratch, skipped entirely under `native`. ONE SWITCH, not a
  # per-path knob: the isolation this applies is deliberately unconditional, and
  # the way to keep that true while still offering parity is to make the bypass
  # all-or-nothing and impossible to reach by accident (see the preset's gate).
  if declare -F profile_isolate >/dev/null && ! _as_preset_is_native; then
    # Only from an APPROVED dot-file: _df_profile_kv is empty unless the trust
    # gate honoured the file, so an unapproved [claude] section grants nothing.
    local -a profile_dotfile=("${_df_profile_kv[@]}")
    profile_isolate || return 1
    _as_iso_prepare || return 1
  fi

  # If /usr/local is a symlink off /usr (e.g. to a separate filesystem),
  # expose its real target read-only so the symlink resolves inside the
  # sandbox. Needed for things like CUDA installed under /usr/local.
  if [[ -L /usr/local ]]; then
    local _usrlocal_real
    _usrlocal_real="$(readlink -f /usr/local 2>/dev/null || true)"
    if [[ -n "$_usrlocal_real" && -d "$_usrlocal_real" ]]; then
      args+=(--ro-bind "$_usrlocal_real" "$_usrlocal_real")
    fi
  fi

  # On systemd-resolved systems (Ubuntu default), /etc/resolv.conf is a
  # symlink into /run/systemd/resolve/, and we tmpfs'd /run. Bind the real
  # target through the tmpfs so DNS works inside the sandbox.
  if [[ -L /etc/resolv.conf ]]; then
    local _resolv_real
    _resolv_real="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
    if [[ -n "$_resolv_real" && -e "$_resolv_real" && "$_resolv_real" != /etc/* ]]; then
      args+=(--ro-bind "$_resolv_real" "$_resolv_real")
    fi
  fi

  # ---- environment allowlist ----
  # Always-set basics, then whatever the profile always sets.
  # AGENT_SANDBOX=1 marks the inside of a sandbox: a launcher invoked in here
  # (e.g. the agent runs `claude` again) can see it and default to not
  # re-sandboxing. It is a UX default, not a security signal -- the enclosing
  # sandbox is enforced regardless of what any inner process believes.
  args+=(
    --setenv HOME "$HOME"
    --setenv USER "${USER:-$(id -un)}"
    --setenv PATH "${_inner_path:-$PATH}"
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv AGENT_SANDBOX 1
  )
  local _kv
  for _kv in "${profile_env_set[@]}"; do
    [[ "$_kv" == *=* ]] \
      || {
        _as_msg "profile '$profile': profile_env_set entry '$_kv' is not NAME=VALUE"
        return 1
      }
    args+=(--setenv "${_kv%%=*}" "${_kv#*=}")
  done
  # Variables that are safe-to-forward IF set in the caller's environment:
  # locale + display niceties, the profile's own (e.g. ANTHROPIC_* for
  # claude), standard proxy vars, TLS CA overrides, CUDA. Note: secret tokens
  # for *other* services (AWS, GitHub, K8s, npm, ...) are NOT in this list
  # and stay outside the sandbox.
  local -a _locale_passenv=(
    LANG LC_ALL LC_CTYPE LC_MESSAGES LC_NUMERIC LC_TIME LC_COLLATE
    TZ COLORTERM NO_COLOR FORCE_COLOR
  )
  local -a _network_passenv=(
    HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY
    http_proxy https_proxy no_proxy all_proxy
    SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE
    CONDA_SSL_VERIFY PIP_CERT GIT_SSL_CAINFO NODE_EXTRA_CA_CERTS NPM_CONFIG_CAFILE CARGO_HTTP_CAINFO
    CUDA_HOME CUDAToolkit_ROOT LD_LIBRARY_PATH
  )
  # Extra names the user explicitly opts in via AGENT_SANDBOX_FORWARD
  # (space- or colon-separated).
  local -a _extra_passenv=()
  [[ -n "$_knob_forward" ]] && _as_split _extra_passenv $': \t\n' "$_knob_forward"
  # `native` forwards the WHOLE exported environment, because `--sandbox none`
  # execs the agent with it and the preset's promise is that a difference is a
  # bug. No allowlist can predict what an agent reads -- a proxy, a locale, an
  # EDITOR, some tool's token or knob -- and a dropped name changes what it does
  # without ever saying so. MEASURED while building the parity test: the probe's
  # own REPORT_NAME never arrived inside, which is exactly the shape a real
  # variable going missing takes.
  #
  # Not the five the engine pins just above: HOME/USER/TERM are the same value
  # anyway, PATH must stay the one computed for inside or the agent may not find
  # its own binary, and AGENT_SANDBOX=1 is the marker saying a sandbox is here --
  # which is still true under `native`, bwrap runs either way.
  local _explicit=${#_extra_passenv[@]} _swept
  if _as_preset_is_native; then
    while IFS= read -r _swept; do
      case "$_swept" in HOME | USER | PATH | TERM | AGENT_SANDBOX) continue ;; esac
      _extra_passenv+=("$_swept")
    done < <(compgen -e)
  fi
  # ...except names the profile pins. A name in profile_env_set is set inside
  # for a reason, and a later --setenv of the same name would win; a name in
  # profile_env_refuse is one the profile knows to be unsafe inside (the claude
  # profile lists CLAUDE_CODE_PROJECT_DIR_NAME: once CLAUDE_CONFIG_DIR is set
  # it moves memory and transcripts out from under the scoping). Said, not
  # silently dropped.
  local -a _fwd=() _refuse=()
  local _var _kv2 _r _hit
  for _kv2 in "${profile_env_set[@]}"; do _refuse+=("${_kv2%%=*}"); done
  _refuse+=(${profile_env_refuse[@]+"${profile_env_refuse[@]}"})
  local _ei
  for ((_ei = 0; _ei < ${#_extra_passenv[@]}; _ei++)); do
    _var="${_extra_passenv[_ei]}"
    [[ -z "$_var" ]] && continue
    _hit=0
    for _r in ${_refuse[@]+"${_refuse[@]}"}; do
      [[ "$_r" == "$_var" ]] && {
        _hit=1
        break
      }
    done
    if ((_hit)); then
      # Said for a name the user asked for by name; silent for one the `native`
      # sweep picked up, where a line per pinned variable is noise about a
      # request nobody made.
      ((_ei < _explicit)) \
        && _as_msg "not forwarding $_var: profile '$profile' sets or refuses it inside the sandbox"
      continue
    fi
    _fwd+=("$_var")
  done
  for _var in "${_locale_passenv[@]}" "${profile_env_pass[@]}" "${_network_passenv[@]}" ${_fwd[@]+"${_fwd[@]}"}; do
    [[ -z "$_var" ]] && continue
    # Indirect lookup; skip if unset (vs. set-empty).
    if [[ -n "${!_var+x}" ]]; then
      args+=(--setenv "$_var" "${!_var}")
    fi
  done
  if ((bind_cwd)); then
    args+=(--bind "$cwd" "$cwd")
  fi
  args+=(--chdir "$cwd")

  # Active conda/mamba environment. The active env is read-only by default;
  # AGENT_SANDBOX_CONDA_WRITE=1 makes it read-write so the agent can
  # `mamba install`/`pip install` into it. The base conda install (conda's own
  # code, the shell hook host logins source, other envs, the host package
  # cache) is ALWAYS bound read-only: a compromised agent may then reshape the
  # one env you handed it -- which you will run on the host -- but nothing
  # else. In write mode downloads go to a sandbox-owned package cache that is
  # searched before the host's read-only one, so packages already extracted on
  # the host are still reused and the host cache can never be poisoned.
  if [[ -n "${CONDA_PREFIX:-}" && -d "$CONDA_PREFIX" ]]; then
    local _conda_base="" _conda_write=0 _rc
    [[ "${_knob_conda_write:-0}" == "1" ]] && _conda_write=1

    # Find the base conda install (where condabin/, bin/conda, bin/mamba,
    # and the package cache pkgs/ live). Try several signals, in order.
    if [[ -n "${MAMBA_ROOT_PREFIX:-}" && -d "${MAMBA_ROOT_PREFIX}" ]]; then
      _conda_base="$MAMBA_ROOT_PREFIX"
    elif [[ -n "${CONDA_ROOT_PREFIX:-}" && -d "${CONDA_ROOT_PREFIX}" ]]; then
      _conda_base="$CONDA_ROOT_PREFIX"
    elif [[ -n "${CONDA_PYTHON_EXE:-}" && -x "${CONDA_PYTHON_EXE}" ]]; then
      _conda_base="$(dirname "$(dirname "$CONDA_PYTHON_EXE")")"
    elif [[ "$CONDA_PREFIX" == */envs/* ]]; then
      _conda_base="${CONDA_PREFIX%/envs/*}"
    fi

    # Bind the base prefix first, read-only, if it's distinct from $CONDA_PREFIX
    # (binding the same path twice would make bwrap error). It goes FIRST
    # because the env usually lives inside it (<base>/envs/<name>): bwrap
    # applies mounts in order and a later mount hides everything below its
    # mount point, so the env's own bind must come after the base's.
    if [[ -n "$_conda_base" && "$_conda_base" != "$CONDA_PREFIX" &&
      -d "$_conda_base" ]]; then
      args+=(--ro-bind "$_conda_base" "$_conda_base")
    fi
    if ((_conda_write)); then
      args+=(--bind "$CONDA_PREFIX" "$CONDA_PREFIX")
    else
      args+=(--ro-bind "$CONDA_PREFIX" "$CONDA_PREFIX")
    fi
    args+=(--setenv CONDA_PREFIX "$CONDA_PREFIX")
    [[ -n "${CONDA_DEFAULT_ENV:-}" ]] && args+=(--setenv CONDA_DEFAULT_ENV "$CONDA_DEFAULT_ENV")
    [[ -n "${CONDA_SHLVL:-}" ]] && args+=(--setenv CONDA_SHLVL "$CONDA_SHLVL")
    [[ -n "${MAMBA_ROOT_PREFIX:-}" ]] && args+=(--setenv MAMBA_ROOT_PREFIX "$MAMBA_ROOT_PREFIX")
    [[ -n "${CONDA_ROOT_PREFIX:-}" ]] && args+=(--setenv CONDA_ROOT_PREFIX "$CONDA_ROOT_PREFIX")
    [[ -n "${CONDA_PYTHON_EXE:-}" ]] && args+=(--setenv CONDA_PYTHON_EXE "$CONDA_PYTHON_EXE")

    # conda's per-user state: config read-only so channels match the host;
    # ~/.conda (env registry, fallback envs/pkgs dirs) an ephemeral tmpfs.
    for _rc in "$HOME/.condarc" "$HOME/.mambarc"; do
      [[ -f "$_rc" ]] && args+=(--ro-bind "$_rc" "$_rc")
    done
    args+=(--tmpfs "$HOME/.conda")

    if ((_conda_write)); then
      local _pkgs="${_knob_conda_pkgs:-$HOME/.cache/agent-sandbox/conda-pkgs}" _pkgs_dirs
      mkdir -p "$_pkgs" 2>/dev/null \
        || {
          _as_msg "cannot create the sandbox conda package cache '$_pkgs' (set AGENT_SANDBOX_CONDA_PKGS)"
          return 1
        }
      args+=(--bind "$_pkgs" "$_pkgs")
      _pkgs_dirs="$_pkgs"
      [[ -n "$_conda_base" && -d "$_conda_base/pkgs" ]] && _pkgs_dirs+=",$_conda_base/pkgs"
      args+=(--setenv CONDA_PKGS_DIRS "${CONDA_PKGS_DIRS:-$_pkgs_dirs}")
    fi
  fi

  # User-supplied extra paths.
  _as_add_paths --ro-bind "$_knob_ro" || return 1
  _as_add_paths --bind "$_knob_rw" || return 1
  # And the path declarations, which are what [ro]/[rw] become: here, after the
  # working-tree bind, or the project would cover every declaration inside it --
  # measured, under the real bwrap, the first time this ran (connect-paths.bats).
  _as_connect_apply_paths || return 1

  # ----- per-session state: SSH agent, --allow include -----
  # Both run on the HOST, before the sandbox exists. See docs/ssh.md and
  # docs/network.md.
  local _ssh_agent_pid="" _proxy_auth="" _seccomp_bpf=""
  local -a _ssh_endpoints=()
  # In strict mode --ssh opens a firewall pinhole to each NAMED host (resolved
  # and pinned below); --ssh-unrestricted has no host to pin, so refuse it here,
  # before any agent is started.
  if [[ "${_knob_net:-proxy}" == strict ]] && ((_ssh_unrestricted)); then
    _as_msg "--ssh-unrestricted is not supported in strict mode (the egress firewall pins named hosts); use --ssh HOST."
    return 2
  fi
  if ((_ssh_want)); then
    _as_ssh_setup || {
      _as_session_cleanup
      return 1
    }
  fi
  if ((${#_allow_hosts[@]} > 0)); then
    case "${_knob_net:-proxy}" in
      open | none) _as_msg "--allow is ignored with AGENT_SANDBOX_NET=${_knob_net} (no egress proxy in that mode)" ;;
      *) _as_allow_setup || {
        _as_session_cleanup
        return 1
      } ;;
    esac
  fi

  # Lock $HOME itself down: the tmpfs is read-only, so the agent cannot create
  # files directly in $HOME. The sub-binds above (profile state, the conda
  # env, $CWD, RW knobs, known_hosts) keep their own rw/ro semantics, so this
  # only blocks writes to $HOME proper — not to anything we intentionally
  # exposed. Must come AFTER every bind whose target is under $HOME, since
  # bwrap may need to create intermediate directories on the tmpfs.
  # ...except under `native`, where $HOME is the host's own and writable, as it
  # is under `--sandbox none`. This lock is why the engine sets CLAUDE_CONFIG_DIR
  # at all (#91: a lock and a rename beside a read-only ~/.claude.json are lost),
  # so a `native` that kept it would have to keep that workaround too, and both
  # would show up as differences.
  _as_preset_is_native || args+=(--remount-ro "$HOME")
  # ----- seccomp (on by default) -----
  # AGENT_SANDBOX_SECCOMP: a default-deny syscall filter (Docker's default
  # profile as for a container with no capabilities; components/seccomp/README.md),
  # compiled by install.sh for this machine into $(_as_seccomp_dir). bwrap reads it
  # from fd 10, which _as_launch / the strict wrapper open at exec time.
  # The value says on or off, never which profile: there is one, and if a second
  # ever ships it can be named by a value that is not a boolean. It deliberately
  # does not spell the state as `default`, which would say nothing about whether
  # the filter is wanted and would contradict itself if the default ever flips.
  case "${_knob_seccomp:-on}" in
    off | 0) ;;
    on | 1)
      # Assigned only when the filter is really used: _seccomp_bpf is what the
      # launcher opens on fd 10, and pointing it at a missing file fails the
      # exec itself rather than falling back.
      local _sc_cand
      _sc_cand="$(_as_seccomp_dir)/$(uname -m).bpf"
      if [[ -r "$_sc_cand" ]]; then
        _seccomp_bpf="$_sc_cand"
        args+=(--seccomp 10)
        _as_info "seccomp: default-deny syscall filter on ($_seccomp_bpf)"
      elif [[ -n "${_knob_seccomp:-}" ]]; then
        # Asked for explicitly and not available: refuse, rather than run
        # something weaker than what was requested.
        _as_msg "AGENT_SANDBOX_SECCOMP=on: no seccomp filter for $(uname -m) at $_sc_cand; re-run install.sh (needs libseccomp and pyseccomp), or set AGENT_SANDBOX_SECCOMP=off."
        return 1
      else
        # On by default, but this machine has no compiled filter -- install.sh
        # only warns when it cannot build one. Refusing here would break a tool
        # the user never asked to change, for no gain over the previous
        # default; so run, and say so every launch rather than quietly.
        _as_msg "WARNING: no seccomp filter for $(uname -m) at $_sc_cand, so this session runs WITHOUT one."
        _as_msg "  Re-run install.sh to compile it (needs libseccomp and pyseccomp), or set AGENT_SANDBOX_SECCOMP=off to stop asking."
        _as_msg "  It matters here: the AppArmor profile install.sh installs for bwrap permits user namespaces to everything under it, so seccomp is what stops the agent making one and regaining capabilities."
      fi
      ;;
    *)
      _as_msg "AGENT_SANDBOX_SECCOMP='$_knob_seccomp' is not recognised (use 'on' or 'off')"
      return 2
      ;;
  esac

  # ----- briefing -----
  # Default on (opt-out): the sessions that most need to know they are sandboxed
  # are the ones nobody configured. `profile_briefing_args` decides how to hand
  # it to the agent and may decline, in which case briefing.md is still bound so
  # the agent can read it.
  local -a profile_briefing_argv=()
  local _brief="${_knob_briefing:-on}"
  # Under --exec the argv is an arbitrary command, so the agent-specific hook
  # args (claude's --settings) must not be appended to it. briefing.md is still
  # written and bound read-only, so whatever runs can read the policy.
  local _brief_args=1
  ((_do_exec || _do_verb)) && _brief_args=0
  case "$_brief" in
    off | 0) ;;
    on | 1)
      if _as_briefing_write; then
        if ((_brief_args)) && declare -F profile_briefing_args >/dev/null; then
          local _brief_out_host="$_session_dir/briefing" _brief_out_inside
          _brief_out_inside="$(_as_briefing_inside)"
          profile_briefing_args "$(_as_briefing_inside)" "$@" || return 1
        fi
      else
        _as_msg "briefing: could not be written; continuing without it"
      fi
      ;;
    *)
      _as_msg "AGENT_SANDBOX_BRIEFING='$_knob_briefing' is not recognised (use 'on' or 'off')"
      return 2
      ;;
  esac

  # What the sandbox actually runs: normally the discovered agent binary with the
  # caller's agent argv and the briefing hook args; under --exec, the caller's
  # command line verbatim. Everything else about the sandbox is identical, which
  # is the point -- including the read-only bind of the agent binary, so an agent
  # started from inside runs natively there.
  local -a _run_argv=()
  if ((_do_exec)); then
    _run_argv=("$@")
  else
    _run_argv=("$profile_bin" "$@" "${profile_briefing_argv[@]}")
  fi

  # ----- Network mode -----
  # proxy  : (default) --share-net plus HTTPS_PROXY pointing at the host-side
  #          mitmproxy (agent-sandbox-mitmproxy.service on 127.0.0.1:8888). All
  #          HTTPS_PROXY-aware tools (the agent, curl, git, pip, npm, conda,
  #          ...) go through the allowlist at
  #          ~/.config/agent-sandbox/allowlist.txt. Limitation: tools that
  #          bypass HTTPS_PROXY by opening raw sockets (or talking to
  #          localhost directly) are NOT filtered.
  # strict : pasta owns an isolated network namespace and forwards it to the
  #          host in userspace; an nftables rule in that netns drops everything
  #          except the proxy on the default gateway. Closes the raw-socket
  #          loophole (a tool that ignores HTTPS_PROXY has no route out) and
  #          blocks localhost/LAN; pasta's port forwarding is off both ways
  #          (see _as_launch_pasta). --ssh HOST is supported (a firewall pinhole
  #          to the host's resolved IPv4, plus an /etc/hosts entry);
  #          --ssh-unrestricted is refused. Needs the 'passt' package and its
  #          AppArmor profile (install.sh adds it) plus nftables. See
  #          docs/network.md and issue #1.
  # open   : --share-net with no proxy. Use only for debugging.
  # none   : net fully unshared. Useful for offline work.
  if [[ "${_knob_net:-proxy}" != strict ]] && ((${#_host_ports[@]} + ${#_agent_ports[@]} + _host_none + _agent_none > 0)); then
    _as_msg "--host-port/--agent-port are ignored with AGENT_SANDBOX_NET=${_knob_net:-proxy}: only strict separates the sandbox's network from the host's"
  fi
  case "${_knob_net:-proxy}" in
    open)
      args+=(--share-net)
      _launch=(bwrap "${args[@]}")
      _as_launch -- "${_run_argv[@]}"
      ;;
    none)
      _launch=(bwrap "${args[@]}")
      _as_launch -- "${_run_argv[@]}"
      ;;
    proxy)
      local _pxy="http://${_proxy_auth:+$_proxy_auth@}127.0.0.1:8888"
      args+=(
        --share-net
        --setenv HTTP_PROXY "$_pxy"
        --setenv HTTPS_PROXY "$_pxy"
        --setenv http_proxy "$_pxy"
        --setenv https_proxy "$_pxy"
        --setenv NO_PROXY ""
        --setenv no_proxy ""
      )
      _as_ca_bind
      _as_ca_env
      _launch=(bwrap "${args[@]}")
      _as_launch -- "${_run_argv[@]}"
      ;;
    strict)
      # pasta owns an isolated netns; nftables inside it allows only the proxy.
      # See _as_launch_pasta and docs/network.md.
      local _nftbin _c
      command -v pasta >/dev/null || {
        _as_msg "strict mode needs pasta (the 'passt' package): 'sudo apt install passt', then re-run install.sh so it adds pasta's AppArmor profile."
        return 1
      }
      # nft (and ip, below) usually live in /usr/sbin, which is often absent from
      # a launcher's PATH; look there too.
      _nftbin="$(command -v nft 2>/dev/null || true)"
      [[ -n "$_nftbin" ]] || for _c in /usr/sbin/nft /sbin/nft; do
        [[ -x "$_c" ]] && {
          _nftbin="$_c"
          break
        }
      done
      [[ -n "$_nftbin" ]] || {
        _as_msg "strict mode needs nft ('sudo apt install nftables'); not on PATH or in /usr/sbin, /sbin."
        return 1
      }
      # Port opt-ins (see _as_launch_pasta): pasta -T/-t specs, or none.
      local _tcp_ns=none _tcp_host=none
      if ((${#_host_ports[@]})); then
        _tcp_ns="$(
          IFS=,
          printf '%s' "${_host_ports[*]}"
        )"
        _as_msg "strict: host ports the sandbox may reach at 127.0.0.1: ${_host_ports[*]}"
      elif ((_host_none)); then
        _as_msg "strict: host ports: none this session"
      fi
      if ((${#_agent_ports[@]})); then
        _tcp_host="127.0.0.1/$(
          IFS=,
          printf '%s' "${_agent_ports[*]}"
        )"
        _as_msg "strict: agent ports published at the host's 127.0.0.1: ${_agent_ports[*]}"
      elif ((_agent_none)); then
        _as_msg "strict: agent ports: none this session"
      fi
      # The proxy is reached at the netns gateway (pasta maps it to the host);
      # _as_launch_pasta reads that address inside the netns and points the proxy
      # variables at it. bwrap shares pasta's netns and makes its own user
      # namespace (via --unshare-all in args). NO_PROXY is emptied here (it does
      # not depend on the gateway); the proxy URLs are set inside.
      args+=(
        --share-net
        --setenv NO_PROXY ""
        --setenv no_proxy ""
      )
      _as_ca_bind
      _as_ca_env
      # --ssh in strict: open the firewall to the named hosts (resolved to IPs on
      # the host) and let their names resolve without DNS. See _as_strict_ssh_rules.
      local _ssh_nftrules=""
      if ((_ssh_want)); then
        _as_strict_ssh_rules || {
          _as_session_cleanup
          return 1
        }
      fi
      _as_launch_pasta "$_nftbin" "$_ssh_nftrules" "$_proxy_auth" "$_tcp_ns" "$_tcp_host" "$_seccomp_bpf" bwrap "${args[@]}"
      _as_launch -- "${_run_argv[@]}"
      ;;
    *)
      _as_msg "unknown AGENT_SANDBOX_NET='${_knob_net}' (expected proxy|strict|open|none)"
      return 1
      ;;
  esac
)

# When this file is executed (directly, or through a profile symlink in
# $PATH), run with the caller's args. When it is sourced, only define the
# functions -- tests do this, and so can a shell wrapper such as
#   claude() { agent_sandbox --profile claude "$@"; }
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  agent_sandbox "$@"
fi
