#!/usr/bin/env bash
# agent-sandbox — run an AI coding agent inside a bubblewrap sandbox.
#
# The engine in this file is provider-agnostic. Everything specific to one
# agent -- where its binary lives, which state paths it needs read-write,
# which environment it wants, which subcommands must run on the host -- is a
# PROFILE: profiles/<name>.sh next to this file, sourced at launch. The
# flagship profile is `claude` (Claude Code). A profile is selected with
# --profile NAME, or inferred from argv[0] when the engine is invoked through
# a symlink named after a profile (~/.local/bin/claude -> agent-sandbox), so
# `claude` keeps working exactly as before. profiles/claude.sh documents the
# contract a profile implements.
#
# ============================================================================
# QUICK START
# ============================================================================
#
# Prerequisites:
#   - bubblewrap installed:   sudo apt install bubblewrap
#   - the agent itself, installed where its profile expects. For `claude`:
#     Claude Code under $HOME/.local/share/claude/versions/ (the native
#     installer's default layout: each version is either a single executable
#     file named after the version, e.g. "2.1.143", or a directory containing
#     a "claude" binary).
#
# Install (pick one):
#   1. ./install.sh -- per-host setup: egress proxy + allowlist, AppArmor
#      profile where needed, and the ~/.local/bin/claude symlink.
#   2. By hand, just the symlink onto your PATH:
#        ln -s "$PWD/agent-sandbox" "$HOME/.local/bin/claude"
#      Ensure "$HOME/.local/bin" comes before any other claude in PATH.
#   3. No symlink at all:
#        agent-sandbox --profile claude [args]
#
# Use:
#   cd /path/to/some/project
#   conda activate myenv     # optional; the active env is forwarded
#   claude                   # launches sandboxed claude with CWD writable
#   claude update            # self-update; runs the native updater on the
#                            # host, unsandboxed (see docs/updating.md)
#   claude --ssh github.com  # + git push / ssh to github.com through a
#                            # per-session ssh-agent; the private key never
#                            # enters the sandbox (see docs/ssh.md)
#   claude --allow pypi.org  # + HTTPS to pypi.org through the egress proxy,
#                            # for this session only (see ENGINE FLAGS below)
#
# ============================================================================
# SANDBOX LAYOUT (what the agent sees)
# ============================================================================
#
#   /usr, /etc, /opt, /lib*, /bin, /sbin    read-only (system)
#   /usr/local                              read-only; if it's a symlink off
#                                           /usr (e.g. to /mnt/.../local) the
#                                           real target is auto-exposed too
#   /tmp, /var/tmp, /run, /proc, /dev       fresh, ephemeral
#   $HOME                                   read-only tmpfs — only these are
#                                           visible inside it:
#     $HOME/.claude                         read-write (claude's state dir).
#                                           Per-project memory under
#                                           .claude/projects can be scoped so
#                                           a session sees only its own and
#                                           approved projects -- see the
#                                           per-project config in docs/config.md.
#     $HOME/.claude.json                    read-write (claude's config file)
#     $CONDA_PREFIX  (if set)               read-only by default; the base
#                                           conda install (conda/mamba, other
#                                           envs, package cache) is bound
#                                           read-only too so those commands
#                                           work. AGENT_SANDBOX_CONDA_WRITE=1
#                                           makes the active env read-write
#                                           for `mamba install`/`pip install`;
#                                           the base stays read-only and
#                                           downloads go to a sandbox-owned
#                                           package cache (knob below).
#     $HOME/.cache                          writable, empty, session-private
#                                           tmpfs for tool caches; gone at exit
#     $HOME/.conda  (if conda is active)    likewise: conda's registry and
#                                           fallback dirs, ephemeral
#     ~/.condarc, ~/.mambarc  (if present)  read-only
#   /etc/ssl/certs/ca-certificates.crt     (proxy mode) the host's CA bundle
#                                           plus the egress proxy's CA, so TLS
#                                           interception is trusted inside the
#                                           sandbox only; the host never trusts
#                                           that CA
#     $CWD                                  read-write (unless CWD == $HOME,
#                                           in which case nothing extra is
#                                           bound — refuse to expose all of
#                                           $HOME)
#   network                                 By default: --share-net plus
#                                           HTTPS_PROXY pointing at a host-
#                                           side mitmproxy with an allowlist
#                                           (see docs/network.md).
#                                           Override per-invocation via
#                                           AGENT_SANDBOX_NET=open|strict|none.
#
# Environment is cleared by default. The default allowlist forwards locale
# (LANG/LC_*/TZ), color hints, Anthropic config (ANTHROPIC_API_KEY etc.),
# standard proxy vars, TLS CA overrides, and CUDA vars (CUDA_HOME,
# CUDAToolkit_ROOT, LD_LIBRARY_PATH). Anything else (AWS_*, GH_TOKEN,
# KUBECONFIG, SSH_AUTH_SOCK, ...) stays outside.
#
# ============================================================================
# OPTIONAL KNOBS (set in the calling shell)
# ============================================================================
#
#   AGENT_SANDBOX_RO=/path/a:/path/b   extra read-only paths (colon-sep)
#   AGENT_SANDBOX_RW=/path/c           extra read-write paths (colon-sep)
#   AGENT_SANDBOX_PASSENV="A B C"      extra env vars to forward (space-
#                                       or colon-separated names)
#   AGENT_SANDBOX_CONDA_WRITE=1        bind the active conda env read-write so
#                                       the agent can `mamba install`, `pip
#                                       install`, etc. into it. The base conda
#                                       install stays read-only; packages are
#                                       downloaded into the sandbox's own cache
#                                       (below), never the host's. Default 0.
#   AGENT_SANDBOX_CONDA_PKGS=/dir      that cache's location on the host
#                                       (default ~/.cache/agent-sandbox/conda-pkgs;
#                                       persistent, so large packages are not
#                                       re-downloaded every session)
#   AGENT_SANDBOX_PROXY_CA=/file       the egress proxy's CA certificate
#                                       (default ~/.mitmproxy/mitmproxy-ca-cert.pem)
#   AGENT_SANDBOX_NET=proxy|strict|open|none  network mode (default: proxy)
#       proxy  : --share-net plus HTTPS_PROXY pointing at a host-side
#                mitmproxy that enforces ~/.config/agent-sandbox/allowlist.txt.
#                Any tool that honors HTTPS_PROXY (the agent, curl, git, pip,
#                npm, conda, ...) is filtered. Tools that bypass HTTPS_PROXY
#                with raw sockets, or talk to localhost/LAN directly, are
#                NOT filtered. This is the working default on Ubuntu 24.04.
#       strict : --unshare-net + slirp4netns + HTTPS_PROXY. Closes the raw-
#                socket loophole and blocks localhost/LAN. Does not currently
#                work on Ubuntu 24.04 — slirp4netns can't enter bwrap's
#                unprivileged netns without root/setuid helpers. Kept for
#                future use once that's solved (rootlesskit, pasta, ...).
#       open   : --share-net, no proxy. Debug only.
#       none   : no network at all (offline work).
#   AGENT_SANDBOX_PROFILE_DIR=/dir      where profiles live (default: the
#                                       profiles/ directory next to this file)
#   AGENT_SANDBOX_SESSION_BASE=/dir     where per-session state lives (default:
#                                       $XDG_RUNTIME_DIR/agent-sandbox.<uid>,
#                                       falling back to /tmp/agent-sandbox.<uid>)
#
# ============================================================================
# ENGINE FLAGS
# ============================================================================
#
# The engine's own flags must come BEFORE the agent's arguments and are
# stripped before the agent sees the command line:
#
#   --profile NAME        select the provider profile (see top of file)
#   --allow HOST          allow HOST through the egress proxy for THIS session
#                         only, on top of the global allowlist. Repeatable.
#                         ".example.com" matches the domain and its
#                         subdomains. The engine writes the hosts to a
#                         per-session file (see AGENT_SANDBOX_SESSION_BASE)
#                         that the proxy addon reads; the addon honours it
#                         only while this session's process is alive, so a
#                         killed session cannot leave a host open. The proxy
#                         is shared, though: while this session lives, its
#                         --allow hosts are reachable from every concurrent
#                         session on the host as well.
#   --ssh HOST, --ssh-unrestricted, --ssh-key PATH, --ssh-timeout LIFE
#                         see docs/ssh.md
#   --trust               review and approve this project's .agent-sandbox
#                         file (per-project allow hosts and memory scoping),
#                         then exit. See docs/config.md. The file is ignored
#                         until approved, and any edit re-blocks it.
#   -h, --help            engine usage (only when no profile is selected;
#                         with a profile, --help goes to the agent)
#
# Sensitive locations (~/.ssh, ~/.gnupg, ~/.aws, ~/.config/{gcloud,sops},
# ~/.kube, ~/.docker, ~/.password-store) are refused as CWD and as
# AGENT_SANDBOX_RO or _RW targets. Paths that resolve to "/", "$HOME" or a
# parent of $HOME are refused outright, as CWD too.
#
# ============================================================================
# DOCUMENTATION
# ============================================================================
#
# The reference lives in docs/ next to this file:
#   docs/design.md           architecture, threat model, every guarantee with
#                            its mechanism and check, RESIDUAL RISKS, open
#                            design questions
#   docs/network.md          network modes, the allowlist, --allow, the proxy
#                            CA and how it is trusted inside the sandbox only
#   docs/ssh.md              the SSH broker: --ssh, --ssh-unrestricted,
#                            --ssh-key, --ssh-timeout
#   docs/config.md           the per-project .agent-sandbox file, its trust
#                            gate, and per-project memory scoping
#   docs/profiles.md         the profile contract; adding an agent
#   docs/updating.md         host-routed agent updates (claude update)
#   docs/troubleshooting.md  error messages and their fixes
# README.md has install and quick start; AGENTS.md has the rules for
# maintainers. Read docs/design.md before changing anything below: the engine
# is security-sensitive and the residual-risk list there must stay true.

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
# Defined at top level (not inside agent_sandbox) so tests can `source` this
# file and exercise them directly. They are only ever called from inside
# agent_sandbox(), whose locals (args, _session_dir, ...) they reach through
# bash's dynamic scoping.

_as_msg() { echo "agent-sandbox: $*" >&2; }

_as_usage() {
  cat <<'USAGE'
usage: agent-sandbox --profile NAME [ENGINE FLAGS] [AGENT ARGS...]
       <profile-symlink> [ENGINE FLAGS] [AGENT ARGS...]     (e.g. `claude`)

Runs an AI coding agent inside a bubblewrap sandbox. The profile picks the
agent (profiles/<NAME>.sh next to this script, or $AGENT_SANDBOX_PROFILE_DIR);
invoking the engine through a symlink named after a profile selects it.

Engine flags (must precede the agent's own arguments):
  --profile NAME        provider profile to run
  --allow HOST          also allow HOST through the egress proxy, for this
                        session only; repeatable; ".example.com" matches the
                        domain and its subdomains
  --ssh HOST            allow SSH to HOST via a per-session, destination-
                        constrained agent (the key stays on the host);
                        repeatable
  --ssh-unrestricted    SSH anywhere the key is accepted (mutually exclusive
                        with --ssh HOST)
  --ssh-key PATH        private key to load (default: what `ssh -G` picks)
  --ssh-timeout LIFE    expire the loaded key after LIFE (e.g. 30m, 2h)
  --trust               review and approve this project's .agent-sandbox
                        file, then exit (see docs/config.md)
  -h, --help            this text (only when no profile is selected)

Environment knobs:
  AGENT_SANDBOX_RO=/a:/b        extra read-only paths
  AGENT_SANDBOX_RW=/c           extra read-write paths
  AGENT_SANDBOX_PASSENV="A B"   extra environment variables to forward
  AGENT_SANDBOX_CONDA_WRITE=1   bind the active conda env read-write
  AGENT_SANDBOX_CONDA_PKGS=/dir sandbox-owned conda package cache (write mode)
  AGENT_SANDBOX_PROXY_CA=/file  the egress proxy's CA (default ~/.mitmproxy/mitmproxy-ca-cert.pem)
  AGENT_SANDBOX_NET=proxy|strict|open|none   network mode (default: proxy)
  AGENT_SANDBOX_PROFILE_DIR     where profiles live
  AGENT_SANDBOX_SESSION_BASE    where per-session state lives
USAGE
}

_as_list_profiles() {
  local d="$1" f
  local -a names=()
  for f in "$d"/*.sh; do
    [[ -r "$f" ]] && names+=("$(basename -- "${f%.sh}")")
  done
  if ((${#names[@]} > 0)); then printf '%s' "${names[*]}"; else printf '(none)'; fi
  return 0
}

# Split $3 on the separator characters in $2 into the array named by $1.
# IFS is local to this helper on purpose: `local IFS` in agent_sandbox itself
# would stay in effect for the rest of that function and silently change
# every later unquoted expansion there.
_as_split() {
  local -n _as_out="$1"
  local IFS="$2"
  read -ra _as_out <<<"$3" || true
  return 0
}

# Refuse user-supplied RO/RW paths that pull the rug out from under the sandbox
# (/, $HOME, or any parent of $HOME) or expose well-known secret stores. Reading
# a key store is as bad as writing it, so RO gets the same check as RW.
_as_check_paths() { # $1 = knob suffix (RO|RW), $2 = colon-separated list
  local knob=$1 raw="${2:-}" p real
  local -a parts=()
  [[ -z "$raw" ]] && return 0
  _as_split parts ':' "$raw"
  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    real="$(readlink -f -- "$p" 2>/dev/null || echo "$p")"
    if [[ "$real" == / || "$real" == "$HOME" || "$HOME" == "$real"/* ]]; then
      _as_msg "refusing AGENT_SANDBOX_$knob='$p' (would expose all of '$real': \$HOME or a parent of it)."
      return 1
    fi
    case "$real" in
      "$HOME"/.ssh* | "$HOME"/.gnupg* | "$HOME"/.aws* | \
        "$HOME"/.config/gcloud* | "$HOME"/.config/sops* | \
        "$HOME"/.kube* | "$HOME"/.docker* | "$HOME"/.password-store*)
        _as_msg "refusing AGENT_SANDBOX_$knob='$p' (sensitive path '$real')."
        return 1
        ;;
    esac
  done
  return 0
}

# User-supplied extra paths: append "$1 path path" to args for each existing
# entry of the colon-separated list $2.
_as_add_paths() {
  local mode="$1" raw="${2:-}" p
  local -a parts=()
  [[ -z "$raw" ]] && return 0
  _as_split parts ':' "$raw"
  for p in "${parts[@]}"; do
    [[ -z "$p" ]] && continue
    if [[ ! -e "$p" ]]; then
      _as_msg "warning — skipping missing path '$p'"
      continue
    fi
    args+=("$mode" "$p" "$p")
  done
  return 0
}

# ----- per-session state: ssh agent socket, --allow include -----
# Per-user base dir, pinned (not $TMPDIR) so the janitor and the proxy addon
# find it deterministically: $AGENT_SANDBOX_SESSION_BASE if set, else
# $XDG_RUNTIME_DIR/agent-sandbox.<uid>, else /tmp/agent-sandbox.<uid>. The
# mitmproxy addon derives the same path (it runs as the same user).
_as_session_base() {
  if [[ -n "${AGENT_SANDBOX_SESSION_BASE:-}" ]]; then
    printf '%s' "$AGENT_SANDBOX_SESSION_BASE"
    return 0
  fi
  local rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  [[ -d "$rt" && -w "$rt" ]] || rt=/tmp
  printf '%s/agent-sandbox.%s' "$rt" "$(id -u)"
  return 0
}

_as_session_sweep() {
  # Janitor for orphans left by an uncatchable kill (SIGKILL of the engine
  # runs no trap). A session dir is orphaned iff its owner process is gone:
  # we compare the recorded PID *and* its start-time, so a recycled PID (same
  # number, newer start-time) is never mistaken for the live owner. Live
  # sessions are always skipped, so this is safe to run with any number of
  # concurrent sessions on the host.
  local base="$1" d opid ostart now agent
  local _ng=0
  shopt -q nullglob && _ng=1
  shopt -s nullglob
  for d in "$base"/session.*; do
    [[ -d "$d" ]] || continue
    [[ -r "$d/owner.id" ]] || continue # unstamped => mid-setup; leave it
    read -r opid ostart <"$d/owner.id" 2>/dev/null || continue
    if [[ -n "$opid" && -r "/proc/$opid/stat" ]]; then
      now="$(awk '{print $22}' "/proc/$opid/stat" 2>/dev/null || true)"
      [[ -n "$now" && "$now" == "$ostart" ]] && continue # owner alive -> skip
    fi
    # Orphan: drop keys via the socket first (addresses the agent by socket,
    # immune to PID reuse), then guard-kill the recorded agent, then remove.
    [[ -S "$d/agent.sock" ]] && SSH_AUTH_SOCK="$d/agent.sock" ssh-add -D >/dev/null 2>&1 || true
    if [[ -r "$d/agent.pid" ]] && read -r agent <"$d/agent.pid" 2>/dev/null \
      && [[ -n "$agent" && "$(cat "/proc/$agent/comm" 2>/dev/null)" == ssh-agent ]]; then
      kill "$agent" 2>/dev/null || true
    fi
    rm -rf -- "$d" 2>/dev/null || true
  done
  ((_ng)) || shopt -u nullglob
  return 0
}

# Create this session's directory (once), stamped for the janitor and the
# proxy addon, and arm the cleanup trap. Sets _session_dir.
_as_session_begin() {
  [[ -n "${_session_dir:-}" ]] && return 0
  local base
  base="$(_as_session_base)"
  { mkdir -p "$base" 2>/dev/null && chmod 700 "$base"; } \
    || {
      _as_msg "cannot create session base $base"
      return 1
    }
  _as_session_sweep "$base" || true
  _session_dir="$(mktemp -d "$base/session.XXXXXX")" || return 1
  chmod 700 "$_session_dir"
  # Liveness stamp: this subshell's PID (it runs bwrap and holds the trap) plus
  # its start-time (field 22 of /proc/<pid>/stat), written BEFORE anything else
  # lands in the dir so a concurrent sweep never sees a dir of ours unstamped.
  # Capture BASHPID in a plain variable first: inside the $(...) below, $BASHPID
  # would be the command-substitution subshell, whose start-time belongs to the
  # wrong process -- and then every liveness check (the janitor, the proxy's
  # --allow owner test) would compare against a start-time that never matches.
  local _owner_pid=$BASHPID _owner_start
  _owner_start="$(awk '{print $22}' "/proc/$_owner_pid/stat" 2>/dev/null || echo 0)"
  printf '%s %s\n' "$_owner_pid" "$_owner_start" >"$_session_dir/owner.id"
  trap '_as_session_cleanup' EXIT INT TERM HUP
  return 0
}

_as_session_cleanup() {
  # Kill only if the recorded PID is still an ssh-agent -- guards against a
  # PID that was already reaped and recycled to an unrelated process.
  if [[ -n "${_ssh_agent_pid:-}" &&
    "$(cat "/proc/${_ssh_agent_pid}/comm" 2>/dev/null)" == ssh-agent ]]; then
    kill "$_ssh_agent_pid" 2>/dev/null
  fi
  [[ -n "${_session_dir:-}" ]] && rm -rf -- "$_session_dir"
  _ssh_agent_pid="" _session_dir=""
  return 0
}

_as_ssh_pick_key() {
  # $1 = `ssh -G` output. Print the first readable IdentityFile ssh itself
  # would try (config-aware). FIDO *_sk keys need a provider; skip them.
  local cand
  while read -r cand; do
    cand="${cand/#\~/$HOME}"
    [[ "$cand" == *_sk ]] && continue
    [[ -r "$cand" ]] && {
      printf '%s\n' "$cand"
      return 0
    }
  done < <(awk '$1=="identityfile"{print $2}' <<<"$1")
  return 1
}

_as_ssh_setup() {
  # See docs/ssh.md. Runs on the HOST, before the sandbox
  # exists: resolves each --ssh spec through ~/.ssh/config, checks the host
  # key is already trusted, starts a fresh agent, loads the key(s) with
  # destination constraints, and binds only the agent socket (plus the
  # public known_hosts/config files) into the sandbox.
  local kh="$HOME/.ssh/known_hosts" cfg="$HOME/.ssh/config"
  { command -v ssh-agent && command -v ssh-add && command -v ssh-keygen; } >/dev/null \
    || {
      _as_msg "ssh-agent/ssh-add/ssh-keygen not found (install openssh-client)"
      return 1
    }
  [[ -r "$kh" ]] || {
    _as_msg "$kh not readable; --ssh needs pre-trusted host keys there"
    return 1
  }

  declare -A _by_key=() # key file -> space-separated constraints
  local spec g host user port khname key localuser
  localuser="$(id -un)"
  for spec in "${_ssh_hosts[@]}"; do
    [[ "$spec" != -* ]] || {
      _as_msg "bad --ssh host '$spec'"
      return 1
    }
    g="$(ssh -G "$spec" 2>/dev/null)" || {
      _as_msg "cannot resolve '$spec' (ssh -G failed)"
      return 1
    }
    host="$(awk '$1=="hostname"{print $2; exit}' <<<"$g")"
    user="$(awk '$1=="user"    {print $2; exit}' <<<"$g")"
    port="$(awk '$1=="port"    {print $2; exit}' <<<"$g")"
    # Pin the user only when asked for: user@ in the spec, or set by config.
    [[ "$spec" != *@* && "$user" == "$localuser" ]] && user=""
    khname="$host"
    [[ "$port" != 22 ]] && khname="[$host]:$port"
    if ! ssh-keygen -F "$khname" -f "$kh" >/dev/null 2>&1; then
      _as_msg "no trusted host key for '$khname' (--ssh $spec) in $kh."
      echo "               Connect once from a HOST shell to record it:   ssh $spec" >&2
      return 1
    fi
    key="$_ssh_key"
    [[ -n "$key" ]] || key="$(_as_ssh_pick_key "$g")" \
      || {
        _as_msg "no readable private key for '$spec'; pass --ssh-key PATH"
        return 1
      }
    _by_key[$key]+=" ${user:+$user@}$khname"
  done
  if ((_ssh_unrestricted)); then
    key="$_ssh_key"
    [[ -n "$key" ]] || key="$(_as_ssh_pick_key "$(ssh -G agent-sandbox.invalid 2>/dev/null)")" \
      || {
        _as_msg "no readable private key found under ~/.ssh; pass --ssh-key PATH"
        return 1
      }
    _by_key[$key]=""
  fi

  _as_session_begin || return 1

  # A fresh agent for this session only. Its socket is the one secret-
  # bearing thing bound in; the key files themselves never are.
  local sock="$_session_dir/agent.sock"
  eval "$(ssh-agent -s -a "$sock")" >/dev/null \
    || {
      _as_msg "ssh-agent failed to start"
      return 1
    }
  _ssh_agent_pid="$SSH_AGENT_PID"
  printf '%s\n' "$_ssh_agent_pid" >"$_session_dir/agent.pid"

  local c
  local -a add
  for key in "${!_by_key[@]}"; do
    add=()
    [[ -n "$_ssh_timeout" ]] && add+=(-t "$_ssh_timeout")
    if [[ -n "${_by_key[$key]}" ]]; then
      for c in ${_by_key[$key]}; do add+=(-h "$c"); done # no spaces in constraints
      add+=(-H "$kh")
      _as_msg "session agent: $key constrained to:${_by_key[$key]}${_ssh_timeout:+  (lifetime $_ssh_timeout)}"
    else
      _as_msg "session agent: $key UNRESTRICTED${_ssh_timeout:+  (lifetime $_ssh_timeout)}"
    fi
    SSH_AUTH_SOCK="$sock" ssh-add "${add[@]}" "$key" \
      || {
        _as_msg "ssh-add failed for $key"
        return 1
      }
  done

  args+=(
    --bind "$sock" "$sock"
    --setenv SSH_AUTH_SOCK "$sock"
    --ro-bind "$kh" "$kh"
  )
  [[ -r "$cfg" ]] && args+=(--ro-bind "$cfg" "$cfg")
  return 0
}

# --allow HOST: write this session's extra hosts where the proxy addon reads
# them. Nothing is bound into the sandbox; the file lives on the host, and the
# addon honours it only while the process stamped in owner.id is alive.
_as_allow_setup() {
  _as_session_begin || return 1
  {
    printf '# agent-sandbox --allow for %s. Honoured by the proxy addon only while\n' "$(basename -- "$_session_dir")"
    printf '# the process recorded in owner.id is alive. One host per line; a leading\n'
    printf '# dot matches the domain and its subdomains.\n'
    printf '%s\n' "${_allow_hosts[@]}"
  } >"$_session_dir/allow.txt"
  _as_msg "session allowlist: ${_allow_hosts[*]} (this session only, on top of the global allowlist)"
  return 0
}

# ----- per-project config (.agent-sandbox) and its trust store -----
# A project may carry a .agent-sandbox file with per-project policy (currently
# `allow` hosts and `share-memory` project paths). It is PARSED, never sourced.
# Because the project dir is writable by the sandboxed agent and a project may
# come from an untrusted repository, the file is honoured only after the user
# approves it with `--trust`: approval records the file's SHA-256, and any later
# edit (by you or the agent) drops it to untrusted until you review and approve
# again -- so the agent can only invalidate trust, never grant it. The trust
# store and global config live under ~/.config/agent-sandbox, which is never
# bound into the sandbox, so the agent can neither read nor forge them.
_as_config_dir() { printf '%s' "$HOME/.config/agent-sandbox"; }
_as_sha256_file() { sha256sum -- "$1" 2>/dev/null | cut -d' ' -f1; }
_as_sha256_str() { printf '%s' "$1" | sha256sum 2>/dev/null | cut -d' ' -f1; }

# Global default for memory scoping when a project has no trusted directive:
# `shared` (every project's memory visible -- the historical behaviour) or
# `scoped` (only the current project). ~/.config/agent-sandbox/config, key
# memory_default. Defaults to `shared`, so upgrading changes nothing.
_as_memory_default() {
  local cfg val="" line
  cfg="$(_as_config_dir)/config"
  if [[ -r "$cfg" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      [[ "$line" == *memory_default* ]] || continue
      val="${line#*=}"
      val="${val//[[:space:]]/}"
    done <"$cfg"
  fi
  case "$val" in
    scoped | shared) printf '%s' "$val" ;;
    *) printf 'shared' ;;
  esac
}

# Is the .agent-sandbox at $2 (for project dir $1) approved? Trust file is
# <config>/trust/<sha256(path)> holding the approved <sha256(content)>.
_as_dotfile_trusted() {
  local cwd="$1" file="$2" want have
  want="$(_as_sha256_file "$file")"
  [[ -n "$want" ]] || return 1
  have="$(cat -- "$(_as_config_dir)/trust/$(_as_sha256_str "$cwd")" 2>/dev/null || true)"
  [[ -n "$have" && "$have" == "$want" ]]
}

_as_trust_record() {
  local cwd="$1" file="$2" dir
  dir="$(_as_config_dir)/trust"
  mkdir -p "$dir" 2>/dev/null || {
    _as_msg "cannot create trust store $dir"
    return 1
  }
  _as_sha256_file "$file" >"$dir/$(_as_sha256_str "$cwd")" || return 1
  return 0
}

# Parse the .agent-sandbox at $1 into the caller's _df_allow/_df_share arrays
# and _df_share_set flag. Data only -- keys are matched, values are split; no
# line is ever executed.
_as_dotfile_parse() {
  local file="$1" line key val _e
  local -a _tmp=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    if [[ "$line" != *=* ]]; then
      _as_msg ".agent-sandbox: ignoring malformed line: $line"
      continue
    fi
    key="${line%%=*}" val="${line#*=}"
    key="${key//[[:space:]]/}"
    val="${val#"${val%%[![:space:]]*}"}"
    val="${val%"${val##*[![:space:]]}"}"
    case "$key" in
      allow)
        _tmp=()
        _as_split _tmp $', \t' "$val"
        _df_allow+=("${_tmp[@]}")
        ;;
      share-memory)
        _df_share_set=1
        _tmp=()
        _as_split _tmp $', \t' "$val"
        for _e in "${_tmp[@]}"; do
          [[ -z "$_e" ]] && continue
          _df_share+=("${_e/#\~/$HOME}")
        done
        ;;
      ssh)
        _as_msg ".agent-sandbox: 'ssh' is not supported yet; ignoring (use --ssh on the command line)"
        ;;
      *)
        _as_msg ".agent-sandbox: ignoring unknown key '$key'"
        ;;
    esac
  done <"$file"
  return 0
}

# The --trust command: show the project's .agent-sandbox, ask to approve it,
# record the approval, and offer to keep it out of git (it is machine-local).
_as_trust_review() {
  local cwd="$1" file ans
  file="$cwd/.agent-sandbox"
  [[ -f "$file" ]] || {
    _as_msg "no .agent-sandbox in $cwd"
    return 1
  }
  {
    printf '\n%s (sha256 %s):\n----\n' "$file" "$(_as_sha256_file "$file")"
    cat -- "$file"
    printf -- '----\n'
  } >&2
  _as_dotfile_trusted "$cwd" "$file" && _as_msg "this exact content is already approved."
  printf 'agent-sandbox: approve this .agent-sandbox for %s? [y/N] ' "$cwd" >&2
  read -r ans || true
  case "$ans" in
    y | Y | yes | YES) ;;
    *)
      _as_msg "not approved; the file stays ignored."
      return 0
      ;;
  esac
  _as_trust_record "$cwd" "$file" || return 1
  _as_msg "approved."
  if git -C "$cwd" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$cwd" check-ignore -q .agent-sandbox 2>/dev/null; then
    local _ex
    _ex="$(git -C "$cwd" rev-parse --absolute-git-dir)/info/exclude"
    printf 'agent-sandbox: add .agent-sandbox to %s so it is not committed? [y/N] ' "$_ex" >&2
    read -r ans || true
    case "$ans" in
      y | Y | yes | YES) printf '/.agent-sandbox\n' >>"$_ex" && _as_msg "added to $_ex" ;;
    esac
  fi
  return 0
}

# The system CA bundle (Debian/Ubuntu/Arch, Fedora/RHEL, openSUSE), or fail.
_as_system_ca_bundle() {
  local cand
  for cand in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
    [[ -r "$cand" ]] && {
      printf '%s' "$cand"
      return 0
    }
  done
  return 1
}

# Trust the egress proxy's CA inside the sandbox only. The proxy terminates TLS
# with a CA mitmproxy generates on first start (~/.mitmproxy/mitmproxy-ca-cert.pem,
# or AGENT_SANDBOX_PROXY_CA). Rather than installing it into the host's trust
# store (root, and every host process would trust it), bind a bundle made of the
# system bundle plus that CA over the system bundle's path inside the sandbox.
# Everything in there trusts the proxy; nothing on the host does. The bundle is
# kept under the per-user session base and rebuilt when either input is newer.
_as_ca_bind() {
  local bundle ca base combined tmp
  ca="${AGENT_SANDBOX_PROXY_CA:-$HOME/.mitmproxy/mitmproxy-ca-cert.pem}"
  bundle="$(_as_system_ca_bundle)" || {
    _as_msg "warning — no system CA bundle found; the proxy CA cannot be trusted inside the sandbox"
    return 0
  }
  [[ -r "$ca" ]] || {
    _as_msg "warning — proxy CA '$ca' not found: HTTPS through the proxy will fail (run install.sh, or set AGENT_SANDBOX_PROXY_CA)"
    return 0
  }
  base="$(_as_session_base)"
  { mkdir -p "$base" 2>/dev/null && chmod 700 "$base"; } || {
    _as_msg "warning — cannot create $base; proxy CA not bound"
    return 0
  }
  combined="$base/ca-bundle.crt"
  if [[ ! -s "$combined" || "$bundle" -nt "$combined" || "$ca" -nt "$combined" ]]; then
    tmp="$(mktemp "$base/ca-bundle.XXXXXX")" || return 0
    cat "$bundle" "$ca" >"$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$combined"
  fi
  args+=(--ro-bind "$combined" "$bundle")
  return 0
}

# Tools that ship their own CA bundle (conda/mamba, pip, a conda git, node, npm,
# cargo, anything honouring SSL_CERT_FILE) never read the system bundle, so in
# the modes that go through the proxy point every well-known override at it --
# inside the sandbox that path holds the bundle _as_ca_bind prepared. Names the
# caller set were forwarded already and are left alone.
_as_ca_env() {
  local bundle="${SSL_CERT_FILE:-}" var
  [[ -n "$bundle" ]] || bundle="$(_as_system_ca_bundle)" || {
    _as_msg "warning — no system CA bundle found; tools with a private CA store will not trust the proxy"
    return 0
  }
  for var in SSL_CERT_FILE REQUESTS_CA_BUNDLE CURL_CA_BUNDLE CONDA_SSL_VERIFY PIP_CERT \
    GIT_SSL_CAINFO NODE_EXTRA_CA_CERTS NPM_CONFIG_CAFILE CARGO_HTTP_CAINFO; do
    [[ -n "${!var+x}" ]] && continue
    args+=(--setenv "$var" "$bundle")
  done
  [[ -n "${SSL_CERT_DIR+x}" ]] || args+=(--setenv SSL_CERT_DIR "$(dirname -- "$bundle")")
  return 0
}

# With per-session state (an ssh agent to kill, an --allow file to remove)
# bash must outlive bwrap to clean up, so it cannot exec. Otherwise exec.
_as_launch() {
  if [[ -n "${_session_dir:-}" ]]; then
    local rc=0
    bwrap "$@" || rc=$?
    _as_session_cleanup
    return "$rc"
  fi
  exec bwrap "$@"
}

# ---------------------------------------------------------------------------
# The engine
# ---------------------------------------------------------------------------
agent_sandbox() (
  set -euo pipefail

  local engine profile_dir invoked
  engine="$(readlink -f -- "${BASH_SOURCE[0]}")"
  profile_dir="${AGENT_SANDBOX_PROFILE_DIR:-$(dirname -- "$engine")/profiles}"
  invoked="$(basename -- "$0")"

  # ---- engine flags (must precede the agent's own arguments) ----
  # See ENGINE FLAGS in the header and docs/ssh.md. Parsing stops at the
  # first token that is not one of ours; everything from there on is passed
  # to the agent untouched.
  local profile=""
  local -a _ssh_hosts=() _allow_hosts=()
  local _ssh_unrestricted=0 _ssh_key="" _ssh_timeout="" _ssh_want=0 _do_trust=0
  while (($# > 0)); do
    case "$1" in
      --profile)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--profile needs a name"
            return 2
          }
        profile="$2"
        shift 2
        ;;
      --profile=?*)
        profile="${1#--profile=}"
        shift
        ;;
      --allow)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--allow needs a host (hostname, or .domain for a domain and its subdomains)"
            return 2
          }
        _allow_hosts+=("$2")
        shift 2
        ;;
      --allow=?*)
        _allow_hosts+=("${1#--allow=}")
        shift
        ;;
      --ssh)
        [[ $# -ge 2 && -n "$2" && "$2" != -* ]] \
          || {
            _as_msg "--ssh needs a host (hostname, user@host, or ~/.ssh/config alias)"
            return 2
          }
        _ssh_hosts+=("$2")
        shift 2
        ;;
      --ssh=?*)
        _ssh_hosts+=("${1#--ssh=}")
        shift
        ;;
      --ssh-unrestricted)
        _ssh_unrestricted=1
        shift
        ;;
      --ssh-key)
        [[ $# -ge 2 && -n "$2" ]] || {
          _as_msg "--ssh-key needs a path"
          return 2
        }
        _ssh_key="$2"
        shift 2
        ;;
      --ssh-key=?*)
        _ssh_key="${1#--ssh-key=}"
        shift
        ;;
      --ssh-timeout)
        [[ $# -ge 2 && -n "$2" ]] || {
          _as_msg "--ssh-timeout needs a lifetime (seconds, or e.g. 30m)"
          return 2
        }
        _ssh_timeout="$2"
        shift 2
        ;;
      --ssh-timeout=?*)
        _ssh_timeout="${1#--ssh-timeout=}"
        shift
        ;;
      --trust)
        _do_trust=1
        shift
        ;;
      *) break ;;
    esac
  done
  ((${#_ssh_hosts[@]} > 0 || _ssh_unrestricted)) && _ssh_want=1
  if ((_ssh_unrestricted && ${#_ssh_hosts[@]} > 0)); then
    _as_msg "--ssh-unrestricted and --ssh HOST are mutually exclusive"
    return 2
  fi
  if ((! _ssh_want)) && [[ -n "$_ssh_key$_ssh_timeout" ]]; then
    _as_msg "--ssh-key / --ssh-timeout need --ssh HOST or --ssh-unrestricted"
    return 2
  fi
  if [[ -n "$_ssh_timeout" && ! "$_ssh_timeout" =~ ^[0-9]+[smhdwSMHDW]?$ ]]; then
    _as_msg "--ssh-timeout: bad lifetime '$_ssh_timeout' (seconds, or e.g. 30m, 2h)"
    return 2
  fi
  if [[ -n "$_ssh_key" && ! -r "$_ssh_key" ]]; then
    _as_msg "--ssh-key: cannot read '$_ssh_key'"
    return 2
  fi
  local _hostre='^\.?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)*[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$' _h
  for _h in "${_allow_hosts[@]}"; do
    [[ "$_h" =~ $_hostre ]] || {
      _as_msg "--allow: bad host '$_h' (expected a hostname, or .domain)"
      return 2
    }
  done

  # ---- --trust: review and approve the current project's .agent-sandbox ----
  # Profile-independent; never launches the agent.
  if ((_do_trust)); then
    _as_trust_review "$(pwd -P)"
    return $?
  fi

  # ---- profile ----
  # Explicit --profile wins; otherwise infer from argv[0] when we were
  # executed through a symlink named after a profile (not when sourced and
  # called as a function, where $0 is the shell).
  if [[ -z "$profile" && "${BASH_SOURCE[0]}" == "$0" && "$invoked" != "$(basename -- "$engine")" ]]; then
    profile="$invoked"
  fi
  if [[ -z "$profile" ]]; then
    case "${1:-}" in -h | --help)
      _as_usage
      return 0
      ;;
    esac
    _as_msg "no profile selected. Use --profile NAME, or invoke through a symlink named after" \
      "a profile (e.g. ~/.local/bin/claude -> $engine)."
    _as_msg "profiles available in $profile_dir: $(_as_list_profiles "$profile_dir")"
    return 2
  fi
  [[ "$profile" =~ ^[a-z][a-z0-9_-]*$ ]] || {
    _as_msg "bad profile name '$profile'"
    return 2
  }
  local profile_file="$profile_dir/$profile.sh"
  [[ -r "$profile_file" ]] \
    || {
      _as_msg "no profile '$profile' ($profile_file not found). Available: $(_as_list_profiles "$profile_dir")"
      return 2
    }

  # Contract defaults; the profile overrides what it needs. The contract is
  # documented in profiles/claude.sh.
  # These are the profile contract: set here as defaults, read by the sourced
  # profile and (profile_allowlist_seed) by install.sh; not all are used here.
  # shellcheck disable=SC2034
  local AGENT_SANDBOX_ENGINE="$engine" AGENT_SANDBOX_PROFILE="$profile" AGENT_SANDBOX_PROFILE_DIR="$profile_dir"
  # shellcheck disable=SC2034
  local profile_command="$profile" profile_allowlist_seed="" profile_bin="" profile_version=""
  local -a profile_config_binds=() profile_env_pass=() profile_env_set=() profile_host_subcommands=()
  local -a profile_tmpfs=() profile_rw_binds=() profile_ro_binds=()
  # shellcheck source=profiles/claude.sh
  source "$profile_file"
  declare -F profile_bin_discover >/dev/null \
    || {
      _as_msg "profile '$profile' does not define profile_bin_discover()"
      return 2
    }
  profile_bin_discover || return 1
  [[ -n "$profile_bin" && -x "$profile_bin" ]] \
    || {
      _as_msg "profile '$profile' selected no executable (profile_bin='$profile_bin')"
      return 1
    }

  # ---- host-side subcommands (e.g. `claude update`) ----
  # The profile lists verbs that must run on the HOST with the caller's
  # environment, unsandboxed; see docs/updating.md.
  if [[ -n "${1:-}" ]]; then
    local _sub _rc
    for _sub in "${profile_host_subcommands[@]}"; do
      [[ "$1" == "$_sub" ]] || continue
      ((_ssh_want || ${#_allow_hosts[@]} > 0)) && _as_msg "--ssh*/--allow flags are ignored for '$1'"
      declare -F profile_handle_subcommand >/dev/null \
        || {
          _as_msg "profile '$profile' lists '$1' as host-side but defines no profile_handle_subcommand()"
          return 2
        }
      _rc=0
      profile_handle_subcommand "$@" || _rc=$?
      return "$_rc"
    done
  fi

  # ---- knobs (AGENT_SANDBOX_*) ----
  local _knob_ro="${AGENT_SANDBOX_RO:-}" _knob_rw="${AGENT_SANDBOX_RW:-}" _knob_passenv="${AGENT_SANDBOX_PASSENV:-}"
  local _knob_conda_write="${AGENT_SANDBOX_CONDA_WRITE:-}" _knob_net="${AGENT_SANDBOX_NET:-}"

  local cwd
  cwd="$(pwd -P)"

  # ---- per-project config (.agent-sandbox), trust-gated ----
  local -a _df_allow=() _df_share=()
  local _df_share_set=0 _memory_mode _dotfile="$cwd/.agent-sandbox"
  if [[ -f "$_dotfile" ]]; then
    if _as_dotfile_trusted "$cwd" "$_dotfile"; then
      _as_dotfile_parse "$_dotfile"
      local _dh
      for _dh in "${_df_allow[@]}"; do
        [[ -z "$_dh" ]] && continue
        if [[ "$_dh" =~ $_hostre ]]; then
          _allow_hosts+=("$_dh")
        else
          _as_msg ".agent-sandbox allow: bad host '$_dh'; ignoring"
        fi
      done
    else
      _as_msg ".agent-sandbox present but not approved; ignoring it." \
        "Review and approve with: $invoked --trust"
    fi
  fi
  if ((_df_share_set)); then
    if ((${#_df_share[@]} == 1)) && [[ "${_df_share[0]}" == all ]]; then
      _memory_mode=shared
      _df_share=()
    else
      _memory_mode=scoped
    fi
  else
    _memory_mode="$(_as_memory_default)"
  fi

  declare -F profile_prepare >/dev/null && profile_prepare
  if declare -F profile_memory_scope >/dev/null; then
    profile_memory_scope "$_memory_mode" "${_df_share[@]}" || return 1
  elif [[ "$_memory_mode" == scoped ]]; then
    _as_msg "profile '$profile' does not scope memory; the setting is ignored"
  fi

  # Refuse to launch from directories that almost certainly hold secrets.
  case "$cwd" in
    "$HOME"/.ssh | "$HOME"/.ssh/* | \
      "$HOME"/.gnupg | "$HOME"/.gnupg/* | \
      "$HOME"/.aws | "$HOME"/.aws/* | \
      "$HOME"/.config/gcloud | "$HOME"/.config/gcloud/* | \
      "$HOME"/.config/sops | "$HOME"/.config/sops/* | \
      "$HOME"/.kube | "$HOME"/.kube/* | \
      "$HOME"/.docker | "$HOME"/.docker/* | \
      "$HOME"/.password-store | "$HOME"/.password-store/*)
      _as_msg "refusing to bind sensitive directory '$cwd' as CWD."
      return 1
      ;;
  esac

  # ----- git identity hint -----
  # ~/.gitconfig is not bound into the sandbox, so a *global* git identity is
  # invisible inside it and commits fail with "Author identity unknown". The
  # supported fix is a repo-local identity: .git/config travels with the repo
  # (bound read-write as CWD), so a [user] section there is enough on its own
  # -- git reads local before global and needs nothing else. If this repo has
  # none, say so. Setting it must happen from a HOST shell to copy the values
  # out of ~/.gitconfig, which is not visible in here either.
  if command -v git >/dev/null \
    && git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [[ -z "$(git -C "$cwd" config --local user.name 2>/dev/null)" ||
    -z "$(git -C "$cwd" config --local user.email 2>/dev/null)" ]]; then
      local _gitroot
      _gitroot="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || echo "$cwd")"
      _as_msg "no repo-local git identity; commits inside the sandbox will fail"
      echo "               (~/.gitconfig is not bound in). Set it once, from a HOST shell:" >&2
      echo "                 git -C \"$_gitroot\" config user.name  \"\$(git config --global user.name)\"" >&2
      echo "                 git -C \"$_gitroot\" config user.email \"\$(git config --global user.email)\"" >&2
    fi
  fi

  # A CWD of / or of a parent of $HOME would be bound read-write and expose
  # everything under it, $HOME included. Refuse; run from a project directory.
  if [[ "$cwd" == / || "$HOME" == "$cwd"/* ]]; then
    _as_msg "refusing to bind '$cwd' as CWD (it contains \$HOME). Run from a project directory."
    return 1
  fi

  # When CWD is $HOME we deliberately do *not* bind it: that would expose
  # the entire home directory. Only the explicit bindings below apply.
  local bind_cwd=1
  if [[ "$cwd" == "$HOME" ]]; then
    bind_cwd=0
    _as_msg "CWD is \$HOME — not binding it. Only the profile's state paths," \
      "the active conda env, and AGENT_SANDBOX_R{O,W} paths will be visible."
  fi

  _as_check_paths RO "$_knob_ro" || return 1
  _as_check_paths RW "$_knob_rw" || return 1

  local -a args=(
    # Minimal system view (all read-only). Note: anything under /usr (incl.
    # /usr/local when it's a real directory) is already covered by the /usr
    # bind. When /usr/local is a symlink elsewhere we expose its real target
    # below so the symlink resolves inside the sandbox (needed for CUDA).
    --ro-bind /usr /usr
    --ro-bind-try /etc /etc
    --ro-bind-try /opt /opt
    --ro-bind-try /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /bin /bin
    --ro-bind-try /sbin /sbin

    # Ephemeral pseudo-filesystems.
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /var/tmp
    --tmpfs /run

    # Blank $HOME — we punch through only what's needed below. ~/.cache is a
    # fresh, writable, session-private tmpfs so tools that expect a cache dir
    # (pip, uv, npm, conda's notices, model downloaders) just work; it vanishes
    # with the session and never touches the host's ~/.cache.
    --tmpfs "$HOME"
    --tmpfs "$HOME/.cache"

    # Isolation. Network is left unshared here; we re-introduce it below
    # according to AGENT_SANDBOX_NET (default: through a host-side mitmproxy
    # allowlist).
    --unshare-all
    --die-with-parent
    --new-session

    # Drop the parent environment; we re-export an explicit allowlist below.
    --clearenv
  )

  # Always-on bindings: the profile's state paths (read-write) and its binary.
  local _p
  for _p in "${profile_config_binds[@]}"; do
    [[ -e "$_p" ]] \
      || {
        _as_msg "profile '$profile': state path '$_p' does not exist (create it in profile_prepare)"
        return 1
      }
    args+=(--bind "$_p" "$_p")
  done
  args+=(--ro-bind "$profile_bin" "$profile_bin")

  # Profile-declared visibility adjustments, applied AFTER its state binds so
  # they layer on top: a tmpfs to hide a subtree, then read-write and
  # read-only rebinds of the parts to keep. The claude profile uses these to
  # scope ~/.claude/projects to the current project (read-write) plus any
  # approved shares (read-only). Empty for every profile by default.
  local _pv
  for _pv in "${profile_tmpfs[@]}"; do
    args+=(--tmpfs "$_pv")
  done
  for _pv in "${profile_rw_binds[@]}"; do
    [[ -e "$_pv" ]] || {
      _as_msg "profile '$profile': rw path '$_pv' does not exist"
      return 1
    }
    args+=(--bind "$_pv" "$_pv")
  done
  for _pv in "${profile_ro_binds[@]}"; do
    if [[ -e "$_pv" ]]; then
      args+=(--ro-bind "$_pv" "$_pv")
    else
      _as_msg "share-memory: nothing at '$_pv'; skipping"
    fi
  done

  # If /usr/local is a symlink off /usr (e.g. to a separate filesystem),
  # expose its real target read-only so the symlink resolves inside the
  # sandbox. Needed for things like CUDA installed under /usr/local.
  if [[ -L /usr/local ]]; then
    local _usrlocal_real
    _usrlocal_real="$(readlink -f /usr/local 2>/dev/null || true)"
    if [[ -n "$_usrlocal_real" && -d "$_usrlocal_real" ]]; then
      args+=(--ro-bind "$_usrlocal_real" "$_usrlocal_real")
    fi
  fi

  # On systemd-resolved systems (Ubuntu default), /etc/resolv.conf is a
  # symlink into /run/systemd/resolve/, and we tmpfs'd /run. Bind the real
  # target through the tmpfs so DNS works inside the sandbox.
  if [[ -L /etc/resolv.conf ]]; then
    local _resolv_real
    _resolv_real="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
    if [[ -n "$_resolv_real" && -e "$_resolv_real" && "$_resolv_real" != /etc/* ]]; then
      args+=(--ro-bind "$_resolv_real" "$_resolv_real")
    fi
  fi

  # ---- environment allowlist ----
  # Always-set basics, then whatever the profile always sets.
  args+=(
    --setenv HOME "$HOME"
    --setenv USER "${USER:-$(id -un)}"
    --setenv PATH "$PATH"
    --setenv TERM "${TERM:-xterm-256color}"
  )
  local _kv
  for _kv in "${profile_env_set[@]}"; do
    [[ "$_kv" == *=* ]] \
      || {
        _as_msg "profile '$profile': profile_env_set entry '$_kv' is not NAME=VALUE"
        return 1
      }
    args+=(--setenv "${_kv%%=*}" "${_kv#*=}")
  done
  # Variables that are safe-to-forward IF set in the caller's environment:
  # locale + display niceties, the profile's own (e.g. ANTHROPIC_* for
  # claude), standard proxy vars, TLS CA overrides, CUDA. Note: secret tokens
  # for *other* services (AWS, GitHub, K8s, npm, ...) are NOT in this list
  # and stay outside the sandbox.
  local -a _locale_passenv=(
    LANG LC_ALL LC_CTYPE LC_MESSAGES LC_NUMERIC LC_TIME LC_COLLATE
    TZ COLORTERM NO_COLOR FORCE_COLOR
  )
  local -a _network_passenv=(
    HTTP_PROXY HTTPS_PROXY NO_PROXY ALL_PROXY
    http_proxy https_proxy no_proxy all_proxy
    SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE
    CONDA_SSL_VERIFY PIP_CERT GIT_SSL_CAINFO NODE_EXTRA_CA_CERTS NPM_CONFIG_CAFILE CARGO_HTTP_CAINFO
    CUDA_HOME CUDAToolkit_ROOT LD_LIBRARY_PATH
  )
  # Extra names the user explicitly opts in via AGENT_SANDBOX_PASSENV
  # (space- or colon-separated).
  local -a _extra_passenv=()
  [[ -n "$_knob_passenv" ]] && _as_split _extra_passenv $': \t\n' "$_knob_passenv"
  local _var
  for _var in "${_locale_passenv[@]}" "${profile_env_pass[@]}" "${_network_passenv[@]}" "${_extra_passenv[@]}"; do
    [[ -z "$_var" ]] && continue
    # Indirect lookup; skip if unset (vs. set-empty).
    if [[ -n "${!_var+x}" ]]; then
      args+=(--setenv "$_var" "${!_var}")
    fi
  done
  if ((bind_cwd)); then
    args+=(--bind "$cwd" "$cwd")
  fi
  args+=(--chdir "$cwd")

  # Active conda/mamba environment. The active env is read-only by default;
  # AGENT_SANDBOX_CONDA_WRITE=1 makes it read-write so the agent can
  # `mamba install`/`pip install` into it. The base conda install (conda's own
  # code, the shell hook host logins source, other envs, the host package
  # cache) is ALWAYS bound read-only: a compromised agent may then reshape the
  # one env you handed it -- which you will run on the host -- but nothing
  # else. In write mode downloads go to a sandbox-owned package cache that is
  # searched before the host's read-only one, so packages already extracted on
  # the host are still reused and the host cache can never be poisoned.
  if [[ -n "${CONDA_PREFIX:-}" && -d "$CONDA_PREFIX" ]]; then
    local _conda_base="" _conda_write=0 _rc
    [[ "${_knob_conda_write:-0}" == "1" ]] && _conda_write=1

    # Find the base conda install (where condabin/, bin/conda, bin/mamba,
    # and the package cache pkgs/ live). Try several signals, in order.
    if [[ -n "${MAMBA_ROOT_PREFIX:-}" && -d "${MAMBA_ROOT_PREFIX}" ]]; then
      _conda_base="$MAMBA_ROOT_PREFIX"
    elif [[ -n "${CONDA_ROOT_PREFIX:-}" && -d "${CONDA_ROOT_PREFIX}" ]]; then
      _conda_base="$CONDA_ROOT_PREFIX"
    elif [[ -n "${CONDA_PYTHON_EXE:-}" && -x "${CONDA_PYTHON_EXE}" ]]; then
      _conda_base="$(dirname "$(dirname "$CONDA_PYTHON_EXE")")"
    elif [[ "$CONDA_PREFIX" == */envs/* ]]; then
      _conda_base="${CONDA_PREFIX%/envs/*}"
    fi

    # Bind the base prefix first, read-only, if it's distinct from $CONDA_PREFIX
    # (binding the same path twice would make bwrap error). It goes FIRST
    # because the env usually lives inside it (<base>/envs/<name>): bwrap
    # applies mounts in order and a later mount hides everything below its
    # mount point, so the env's own bind must come after the base's.
    if [[ -n "$_conda_base" && "$_conda_base" != "$CONDA_PREFIX" &&
      -d "$_conda_base" ]]; then
      args+=(--ro-bind "$_conda_base" "$_conda_base")
    fi
    if ((_conda_write)); then
      args+=(--bind "$CONDA_PREFIX" "$CONDA_PREFIX")
    else
      args+=(--ro-bind "$CONDA_PREFIX" "$CONDA_PREFIX")
    fi
    args+=(--setenv CONDA_PREFIX "$CONDA_PREFIX")
    [[ -n "${CONDA_DEFAULT_ENV:-}" ]] && args+=(--setenv CONDA_DEFAULT_ENV "$CONDA_DEFAULT_ENV")
    [[ -n "${CONDA_SHLVL:-}" ]] && args+=(--setenv CONDA_SHLVL "$CONDA_SHLVL")
    [[ -n "${MAMBA_ROOT_PREFIX:-}" ]] && args+=(--setenv MAMBA_ROOT_PREFIX "$MAMBA_ROOT_PREFIX")
    [[ -n "${CONDA_ROOT_PREFIX:-}" ]] && args+=(--setenv CONDA_ROOT_PREFIX "$CONDA_ROOT_PREFIX")
    [[ -n "${CONDA_PYTHON_EXE:-}" ]] && args+=(--setenv CONDA_PYTHON_EXE "$CONDA_PYTHON_EXE")

    # conda's per-user state: config read-only so channels match the host;
    # ~/.conda (env registry, fallback envs/pkgs dirs) an ephemeral tmpfs.
    for _rc in "$HOME/.condarc" "$HOME/.mambarc"; do
      [[ -f "$_rc" ]] && args+=(--ro-bind "$_rc" "$_rc")
    done
    args+=(--tmpfs "$HOME/.conda")

    if ((_conda_write)); then
      local _pkgs="${AGENT_SANDBOX_CONDA_PKGS:-$HOME/.cache/agent-sandbox/conda-pkgs}" _pkgs_dirs
      mkdir -p "$_pkgs" 2>/dev/null \
        || {
          _as_msg "cannot create the sandbox conda package cache '$_pkgs' (set AGENT_SANDBOX_CONDA_PKGS)"
          return 1
        }
      args+=(--bind "$_pkgs" "$_pkgs")
      _pkgs_dirs="$_pkgs"
      [[ -n "$_conda_base" && -d "$_conda_base/pkgs" ]] && _pkgs_dirs+=",$_conda_base/pkgs"
      args+=(--setenv CONDA_PKGS_DIRS "${CONDA_PKGS_DIRS:-$_pkgs_dirs}")
    fi
  fi

  # User-supplied extra paths.
  _as_add_paths --ro-bind "$_knob_ro"
  _as_add_paths --bind "$_knob_rw"

  # ----- per-session state: SSH agent, --allow include -----
  # Both run on the HOST, before the sandbox exists. See docs/ssh.md and
  # docs/network.md.
  local _session_dir="" _ssh_agent_pid=""
  if ((_ssh_want)); then
    _as_ssh_setup || {
      _as_session_cleanup
      return 1
    }
  fi
  if ((${#_allow_hosts[@]} > 0)); then
    case "${_knob_net:-proxy}" in
      open | none) _as_msg "--allow is ignored with AGENT_SANDBOX_NET=${_knob_net} (no egress proxy in that mode)" ;;
      *) _as_allow_setup || {
        _as_session_cleanup
        return 1
      } ;;
    esac
  fi

  # Lock $HOME itself down: the tmpfs is read-only, so the agent cannot create
  # files directly in $HOME. The sub-binds above (profile state, the conda
  # env, $CWD, RW knobs, known_hosts) keep their own rw/ro semantics, so this
  # only blocks writes to $HOME proper — not to anything we intentionally
  # exposed. Must come AFTER every bind whose target is under $HOME, since
  # bwrap may need to create intermediate directories on the tmpfs.
  args+=(--remount-ro "$HOME")

  # ----- Network mode -----
  # proxy  : (default) --share-net plus HTTPS_PROXY pointing at the host-side
  #          mitmproxy (agent-sandbox-mitmproxy.service on 127.0.0.1:8888). All
  #          HTTPS_PROXY-aware tools (the agent, curl, git, pip, npm, conda,
  #          ...) go through the allowlist at
  #          ~/.config/agent-sandbox/allowlist.txt. Limitation: tools that
  #          bypass HTTPS_PROXY by opening raw sockets (or talking to
  #          localhost directly) are NOT filtered.
  # strict : --unshare-net + slirp4netns + HTTPS_PROXY. Closes the raw-socket
  #          loophole and also blocks localhost/LAN. Currently does not work
  #          on Ubuntu 24.04 (slirp4netns cannot setns into bwrap's unshared
  #          netns from outside without root/setuid helpers); kept here for
  #          when that's solvable (e.g. rootlesskit, pasta, or a fixed
  #          slirp4netns codepath).
  # open   : --share-net with no proxy. Use only for debugging.
  # none   : net fully unshared. Useful for offline work.
  case "${_knob_net:-proxy}" in
    open)
      args+=(--share-net)
      _as_launch "${args[@]}" -- "$profile_bin" "$@"
      ;;
    none)
      _as_launch "${args[@]}" -- "$profile_bin" "$@"
      ;;
    proxy)
      args+=(
        --share-net
        --setenv HTTP_PROXY "http://127.0.0.1:8888"
        --setenv HTTPS_PROXY "http://127.0.0.1:8888"
        --setenv http_proxy "http://127.0.0.1:8888"
        --setenv https_proxy "http://127.0.0.1:8888"
        --setenv NO_PROXY ""
        --setenv no_proxy ""
      )
      _as_ca_bind
      _as_ca_env
      _as_launch "${args[@]}" -- "$profile_bin" "$@"
      ;;
    strict)
      command -v slirp4netns >/dev/null || {
        _as_msg "slirp4netns not installed (apt install slirp4netns)."
        return 1
      }
      args+=(
        --setenv HTTP_PROXY "http://10.0.2.2:8888"
        --setenv HTTPS_PROXY "http://10.0.2.2:8888"
        --setenv http_proxy "http://10.0.2.2:8888"
        --setenv https_proxy "http://10.0.2.2:8888"
        --setenv NO_PROXY ""
        --setenv no_proxy ""
      )
      _as_ca_bind
      _as_ca_env

      # Coordinate bwrap and slirp4netns: bwrap writes its child PID to fd 19
      # then blocks on fd 18 until slirp4netns has configured the namespace
      # and signals ready via --ready-fd 18. Strict mode also requires
      # mitmdump to be listening on a host address slirp's gateway routes
      # to (NOT 127.0.0.1 — see the systemd unit written by install.sh).
      local _tmp _bwrap_pid _slirp_pid _child_pid _rc
      _tmp=$(mktemp -d -t agent-sandbox.XXXXXX)
      trap '
        [[ -n "${_slirp_pid:-}" ]] && kill "$_slirp_pid" 2>/dev/null
        [[ -n "${_bwrap_pid:-}" ]] && kill "$_bwrap_pid" 2>/dev/null
        _as_session_cleanup
        rm -rf "$_tmp"
      ' EXIT INT TERM
      mkfifo "$_tmp/info" "$_tmp/ready"
      exec 18<>"$_tmp/ready"

      bwrap --info-fd 19 --block-fd 18 "${args[@]}" -- "$profile_bin" "$@" \
        19>"$_tmp/info" &
      _bwrap_pid=$!

      _child_pid=$(
        timeout 10 python3 -c \
          'import json,sys; print(json.load(sys.stdin)["child-pid"])' \
          <"$_tmp/info" 2>/dev/null
      ) || {
        _as_msg "bwrap did not report a child PID; aborting."
        wait "$_bwrap_pid" 2>/dev/null
        exit $?
      }

      slirp4netns --configure --mtu=65520 --disable-host-loopback \
        --userns-path "/proc/$_child_pid/ns/user" \
        --ready-fd 18 "$_child_pid" tap0 >/dev/null &
      _slirp_pid=$!

      wait "$_bwrap_pid"
      _rc=$?
      kill "$_slirp_pid" 2>/dev/null
      wait "$_slirp_pid" 2>/dev/null || true
      exit "$_rc"
      ;;
    *)
      _as_msg "unknown AGENT_SANDBOX_NET='${_knob_net}' (expected proxy|strict|open|none)"
      return 1
      ;;
  esac
)

# When this file is executed (directly, or through a profile symlink in
# $PATH), run with the caller's args. When it is sourced, only define the
# functions -- tests do this, and so can a shell wrapper such as
#   claude() { agent_sandbox --profile claude "$@"; }
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  agent_sandbox "$@"
fi
